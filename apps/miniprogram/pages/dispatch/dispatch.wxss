.scan-content { min-height: calc(100vh - 320rpx - env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: flex-start; box-sizing: border-box; padding: 36rpx 32rpx 64rpx; }
.scan-content.has-results { justify-content: flex-start; padding-top: 24rpx; }
.scan-primary { text-align: center; }
.scanner-frame { width: 560rpx; max-width: 100%; height: 560rpx; position: relative; margin: 0 auto; padding: 0; overflow: visible; border: 0; border-radius: 64rpx; background: transparent; font-size: 0; line-height: 1; transition: transform 140ms cubic-bezier(.23, 1, .32, 1), opacity 140ms ease; }
