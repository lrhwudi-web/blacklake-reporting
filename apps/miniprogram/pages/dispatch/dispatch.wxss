.scan-header .history-entry { width: auto; min-width: 0; height: 84rpx; min-height: 44px; margin: 0 10rpx 0 0; padding: 0 12rpx; border-color: #e0e8f4; border-radius: 14rpx; background: rgba(255, 255, 255, .7); font-size: 12px; line-height: 44px; }
.scan-header .role-pill { min-width: 44px; height: 84rpx; min-height: 44px; padding: 0 12rpx; font-size: 12px; line-height: 44px; box-shadow: none; background: rgba(255, 255, 255, .7); }
