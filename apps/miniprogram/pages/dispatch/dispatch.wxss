.report-history-footer button,.report-load-more { margin:0; padding:6rpx 18rpx; border:0; border-radius:14rpx; background:#EFF5FF; color:#1D4ED8; font-size:24rpx; }
.report-load-more { margin:16rpx auto; }
.report-edit-mask { z-index:54;background:#F4F7FC; }
.report-edit-sheet { z-index:55; height:auto; max-height:82vh; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); }
.report-edit-body { flex:1; min-height:0; max-height:54vh; }
.report-edit-identity { display:block; color:#0F172A; font-size:16px; font-weight:700; }
.report-edit-label { display:block; margin:24rpx 0 8rpx; color:#475569; font-size:14px; font-weight:600; }
.report-edit-input { padding:16rpx 20rpx; height:48px; box-sizing:border-box; border:1px solid #BFDBFE; border-radius:16rpx; background:#F8FAFF; color:#0F172A; font-size:34rpx; font-weight:700; }
.report-defect-options { display:flex; flex-wrap:wrap; gap:10rpx; margin:16rpx 0; }
.report-defect-options button { margin:0; padding:10rpx 16rpx; border:1px solid #CBD5E1; border-radius:16rpx; background:#fff; color:#475569; font-size:24rpx; }
.report-defect-options button.selected { background:#EFF6FF; color:#1D4ED8; border-color:#3B82F6; }
.report-save-button { flex-shrink:0; margin:20rpx 0 0; height:88rpx; line-height:88rpx; border:0; border-radius:22rpx; background:#1D4ED8; color:#fff; font-size:30rpx; font-weight:700; }
.report-save-button[disabled] { background:#CBD5E1; }


.assignment-sheet.report-full-editor { position:fixed;left:0;right:0;top:0;bottom:0;width:auto;height:100%;max-height:100%;padding:0;display:flex;flex-direction:column;overflow:hidden;border:0;border-radius:0;box-shadow:none;background:#F4F7FC;box-sizing:border-box;color:#263E5C; }
.report-full-heading { display:flex;align-items:center;justify-content:space-between;gap:12px;flex-shrink:0;padding:18px 16px 14px;border-bottom:1px solid #E2EAF5;background:#FCFDFF;color:#162B47; }
.report-full-heading>view { min-width:0; }.report-full-heading>view>text { display:block;font-size:22px;line-height:1.3;font-weight:750; }.report-full-heading>view>text+text { margin-top:5px;color:#7385A0;font-size:14px;line-height:1.4;font-weight:400; }
.report-full-heading>button { display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex:0 0 44px;margin:0;padding:0;border:0;border-radius:14px;background:#EAF1FC; }.report-full-heading image { display:block;width:20px;height:20px;opacity:.65; }
.report-full-body { flex:1;height:0;min-height:0;box-sizing:border-box;padding:0 12px 12px; }.report-form-card { margin-top:12px;overflow:hidden;border:1px solid #E2EAF5;border-radius:16px;background:#FDFEFF; }
.report-full-editor .report-form-row { display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 14px;box-sizing:border-box;border:0;border-bottom:1px solid #E8EDF5;border-radius:0;background:transparent;color:#576C89;font-size:15px;line-height:1.5;font-weight:400;text-align:left; }.report-full-editor .report-form-row:last-child { border-bottom:0; }.report-form-row>text { flex-shrink:0; }.report-form-row>view { display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0;color:#2F4A6B; }.report-form-row>view>text { overflow-wrap:anywhere; }.report-form-row image,.report-more-info image { display:block;width:14px;height:14px;flex-shrink:0;opacity:.55; }
.report-full-editor .report-person-trigger,.report-full-editor .report-defect-trigger { width:100%;margin:0; }.report-defect-trigger>view>text { color:#526B8B;font-size:14px; }
.report-quantity-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:14px;gap:14px;border-bottom:1px solid #E8EDF5; }.report-quantity-grid>view:last-child { padding-left:18px;border-left:1px solid #E4EBF5; }.report-quantity-grid>view>text { display:block;margin-bottom:6px;font-size:14px;line-height:20px;color:#7385A0; }
.report-full-editor .report-edit-input { width:100%;min-width:0;height:46px;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:#214EE5;font-size:30px;line-height:46px;font-weight:750; }.report-quantity-grid>view:last-child .report-edit-input { color:#334D6F; }
.report-time-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:14px;gap:14px;border-bottom:1px solid #E8EDF5; }.report-time-column { min-width:0; }.report-time-column:last-child { border-left:1px solid #E4EBF5;padding-left:14px; }.report-time-column>text { display:block;color:#7385A0;font-size:14px;line-height:22px; }.report-time-column picker { display:block; }.report-edit-date,.report-edit-clock { display:flex;align-items:center;justify-content:space-between;gap:6px;min-height:44px; }.report-edit-date { color:#526B8B;font-size:15px; }.report-edit-clock { color:#2B486E;font-size:28px;font-weight:650;font-variant-numeric:tabular-nums; }.report-time-grid image { display:block;width:12px;height:12px;flex-shrink:0;opacity:.55; }
.report-worktime { padding:16px 14px; }.report-hours-heading { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;color:#334D6F;font-size:16px;font-weight:650; }.report-hours-heading>text+text { font-size:12px;color:#7C8FAA;font-weight:400; }.report-hours-fields { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) 52px;align-items:center;gap:10px; }.report-hours-fields>view { display:flex;align-items:center;gap:6px;flex:1;min-width:0; }.report-hours-fields input { min-width:0;flex:1;width:56px;height:48px;border:1px solid #DCE7F8;border-radius:10px;background:#F0F5FD;text-align:center;color:#315B93;font-size:23px; }.report-hours-fields text { flex-shrink:0;font-size:14px;color:#7385A0; }.report-full-editor .report-hours-fields button { flex-shrink:0;height:48px;width:52px;min-width:0;margin:0;padding:0 7px;border:0;border-radius:10px;background:#EAF1FF;color:#1453F5;font-size:14px;line-height:48px;font-weight:500; }.report-worktime-note { display:block;margin-top:10px;font-size:12px;line-height:18px;color:#8292AA; }
.report-more-info { display:flex;align-items:center;gap:8px;width:100%;min-height:52px;margin:4px 0 0;padding:8px 2px;border:0;border-radius:0;background:transparent;text-align:left;font-size:14px;line-height:1.5;font-weight:400;color:#6E84A1; }.report-more-info>text:nth-child(2) { flex:1;text-align:right;font-size:12px;color:#8292AA; }
.report-extra-card .report-form-row>input { min-width:0;flex:1;width:90px;height:44px;text-align:right;color:#2F4A6B;font-size:15px; }.report-editor-note { display:block;padding:10px 14px;color:#8292AA;font-size:12px;line-height:1.6; }
.report-full-footer { flex-shrink:0;padding:0 14px calc(12px + env(safe-area-inset-bottom));border-top:1px solid #E1E9F5;background:#FCFDFF; }.report-full-editor .report-save-button { width:100%;height:50px;margin:12px 0 0;padding:0;border:0;border-radius:14px;background:#214BE0;color:#fff;font-size:17px;font-weight:700;line-height:50px; }.report-full-editor .report-save-button[disabled] { background:#C3D0E7; }.report-editor-error { display:block;padding:8px 2px 0;color:#B63C45;font-size:13px;line-height:1.5; }.report-editor-loading { display:block;flex:1;padding:20px 16px;color:#7C8FAA;font-size:14px; }
.report-defect-allocation { padding:4px 14px 14px; }.report-defect-allocation>view { display:flex;align-items:center;gap:12px;padding:5px 0; }.report-defect-allocation button { flex:1;min-width:0;min-height:46px;margin:0;padding:0 10px;border:1px solid #DCE5F3;border-radius:10px;background:#F8FBFF;color:#7487A1;font-size:15px;line-height:44px;text-align:left; }.report-defect-allocation button.selected { border-color:#A3BEF2;background:#EAF2FF;color:#1D4ED8; }.report-defect-allocation input { width:72px;height:46px;border:1px solid #CDDDF5;border-radius:10px;background:#F2F6FD;text-align:center;color:#1D4ED8;font-size:21px; }.report-defect-allocation>text { color:#8495AD;font-size:12px; }
.report-person-search { flex-shrink:0;padding:12px 14px; }.report-person-search input { height:46px;padding:0 12px;border:1px solid #D9E4F4;border-radius:12px;background:#fff;color:#334D6F;font-size:15px; }.report-person-list { flex:1;height:0;min-height:0;padding:0 14px;box-sizing:border-box; }.report-person-option { display:flex;align-items:center;justify-content:space-between;width:100%;min-height:60px;margin:6px 0;padding:10px 12px;border:1px solid #E0E8F4;border-radius:12px;background:#fff;color:#334D6F;text-align:left;font-size:16px;line-height:1.5;font-weight:400; }.report-person-option>view>text { display:block; }.report-person-option>view>text+text { margin-top:3px;color:#8B9BB1;font-size:13px; }.report-person-option.selected { background:#EBF2FF;border-color:#B5CEF6; }.report-person-option>text { font-size:13px;color:#2153DC; }
.report-full-body::-webkit-scrollbar,.report-person-list::-webkit-scrollbar { display:none; }
@media(max-width:350px){.assignment-sheet.report-full-editor{left:0;right:0}.report-full-body{padding-left:10px;padding-right:10px}.report-time-grid{gap:10px;padding:12px}.report-time-column:last-child{padding-left:10px}.report-edit-date{font-size:14px}.report-hours-fields{gap:6px}.report-hours-fields input{font-size:20px}.report-hours-fields text{font-size:12px}.report-more-info>text:nth-child(2){font-size:11px}}

.report-person-browser { display:flex;flex:1;min-height:0;overflow:hidden; }.report-person-groups { flex:0 0 96px;width:96px;height:100%;box-sizing:border-box;padding:0 8px 12px;border-right:1px solid #E2EAF5;background:#EDF2FA; }.report-full-editor .report-person-group { display:flex;align-items:center;justify-content:space-between;gap:5px;width:100%;min-height:56px;margin:6px 0;padding:10px 8px;border:0;border-radius:10px;background:transparent;color:#7385A0;font-size:14px;line-height:1.5;font-weight:400;text-align:left; }.report-person-group>text:first-child { flex:1;min-width:0;overflow-wrap:anywhere; }.report-person-group>text+text { flex-shrink:0;font-size:12px; }.report-full-editor .report-person-group.active { color:#2153DC;background:#fff;font-weight:650; }.report-person-browser .report-person-list { height:100%;width:0;padding:0 10px 12px; }.report-person-browser .report-person-option { gap:6px; }.report-person-option>view { min-width:0; }.report-person-option>view>text { overflow-wrap:anywhere; }.report-person-option>text { flex-shrink:0; }
