.scanner-beam { height: 4rpx; position: absolute; left: 12%; right: 12%; top: 50%; z-index: 2; border-radius: 999rpx; background: #dfffff; box-shadow: 0 0 4rpx #fff, 0 0 18rpx rgba(38, 220, 255, .95), 0 0 32rpx rgba(13, 168, 255, .65); pointer-events: none; animation: scanner-sweep 2.2s cubic-bezier(.77, 0, .175, 1) infinite; }
