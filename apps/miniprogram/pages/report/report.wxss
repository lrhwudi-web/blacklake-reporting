.worker-sku-row { display: flex; gap: 10px; margin-top: 20px; }
.worker-sku-row input { flex: 1; min-width: 0; height: 48px; padding: 0 14px; border: 1px solid #CBD5E1; border-radius: 12px; background: #fff; color: #0F172A; font-size: 16px; box-sizing: border-box; }
.worker-sku-row button { width: 72px; margin: 0; padding: 0; height: 48px; line-height: 48px; background: #1D4ED8; color: #fff; font-size: 16px; border-radius: 12px; }
.worker-self-error { display: block; margin-top: 8px; color: #DC2626; font-size: 13px; }
.worker-sku-result { display: flex; align-items: center; gap: 12px; width: 100%; margin-top: 12px; padding: 12px; box-sizing: border-box; text-align: left; background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; }
.worker-sku-picture { position: relative; flex: 0 0 80px; width: 80px; height: 80px; overflow: hidden; border-radius: 8px; background: #F8FAFC; }
.worker-sku-picture image { display: block; width: 100%; height: 100%; }
.worker-sku-picture .worker-sku-zoom { position: absolute; right: 0; bottom: 0; left: 0; color: #475569; background: rgba(241,245,249,.94); font-size: 10px; line-height: 18px; text-align: center; }
.worker-sku-no-image { display: flex; align-items: center; justify-content: center; padding: 6px; box-sizing: border-box; color: #64748B; font-size: 11px; line-height: 1.5; text-align: center; }
.worker-sku-info { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.worker-sku-info text { display: block; line-height: 1.6; }
.worker-sku-code { color: #0F172A; font-size: 14px; font-weight: 600; }
.worker-sku-name { margin-top: 3px; color: #475569; font-size: 12px; }
.worker-sku-number { margin-top: 3px; color: #64748B; font-size: 11px; }
.worker-sku-result .worker-sku-arrow { flex: 0 0 16px; width: 16px; height: 16px; }
.self-unit-picker { margin-top: 16px; }
.report-load-state { min-height: 80vh; padding: 32px 24px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: #F1F5F9; }
.report-load-title { color: #0F172A; font-size: 20px; font-weight: 800; }
.report-load-copy { margin-top: 12px; color: #64748B; font-size: 14px; overflow-wrap: anywhere; }
.report-load-retry { width: 100%; min-height: 56px; margin-top: 24px; padding: 0 12px; border-radius: 14px; background: #1D4ED8; color: #fff; font-size: 18px; font-weight: 800; line-height: 56px; box-shadow: 0 6px 16px rgba(29,78,216,.22); }
@keyframes waiting-ring { 0% { transform: scale(.6); opacity: .8; } 100% { transform: scale(1.4); opacity: 0; } }
@keyframes status-blink { 0%,100% { opacity: 1; } 50% { opacity: .3; } }
@media (max-width: 350px) { .timer { font-size: 40px; letter-spacing: 0; } .work-summary { padding: 20px; } .success-view { padding: 40px 20px 28px; } .success-row { gap: 12px; } .success-row-value { font-size: 14px; } }
@media (max-height: 600px) { .report-page .waiting-assignment-card { padding: 24px 16px; } .waiting-pulse { width: 100px; height: 100px; margin-bottom: 12px; } .waiting-core { inset: 20px; } .worker-scan-hero image { width: 42vw; height: 42vw; } .worker-sku-row { margin-top: 12px; } }
@media (prefers-reduced-motion: reduce) { .waiting-pulse::before, .waiting-pulse::after, .online-dot { animation: none; } .waiting-pulse::before { transform: none; opacity: .2; } .report-page button:active { transform: none; } }

/* Scan entry target V2 */
.report-page.report-self-entry { display: flex; flex-direction: column; height: 100vh; padding: 0 0 calc(91px + env(safe-area-inset-bottom)); }
.report-self-entry .report-header { flex-shrink: 0; }
.report-self-entry .report-content { display: flex; flex: 1; flex-direction: column; height: 0; min-height: 0; padding: 0; }
.report-self-entry .worker-self-home { flex: 1; width: 100%; height: 0; min-height: 0; margin: 0; padding: 20px 18px; box-sizing: border-box; }
.worker-scan-intro { display: flex; flex-direction: column; align-items: center; padding: 24px 20px 16px; }
.worker-scan-ring { position: relative; width: 200px; height: 200px; margin-bottom: 24px; }
.worker-scan-ring::before { content: ''; position: absolute; inset: -12px; border-radius: 50%; border: 2px solid #10B981; opacity: .4; pointer-events: none; animation: worker-scan-breathe 2s ease-out infinite; }
.worker-self-home .worker-scan-hero { width: 100%; height: 100%; min-height: 0; padding: 32px 0 0; margin: 0; border: 0; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg,#10B981,#059669); color: #fff; box-shadow: 0 16px 40px rgba(16,185,129,.4); font-size: 18px; font-weight: 800; line-height: 1.6; letter-spacing: 1px; }
.worker-self-home .worker-scan-hero image { width: 56px; height: 56px; max-width: none; max-height: none; margin: 0 0 6px; }
.worker-self-home .worker-scan-hero[disabled] { background: #64748B; box-shadow: none; }
.worker-scan-hint { display: block; white-space: pre-line; color: #64748B; font-size: 13px; line-height: 1.6; text-align: center; }
.worker-sku-divider { display: flex; align-items: center; gap: 28px; margin: 18px 0 12px; color: #64748B; font-size: 12px; line-height: 1.6; }
.worker-sku-divider > view { flex: 1; height: 1px; background: #E2E8F0; }
.worker-self-home .worker-sku-row { display: flex; gap: 10px; margin-top: 0; padding: 0 4px; }
.worker-self-home .worker-sku-row input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border: 1.5px solid #E2E8F0; border-radius: 10px; background: #fff; color: #0F172A; font-size: 14px; }
.worker-self-home .worker-sku-row button { flex: 0 0 80px; width: 80px; height: 44px; min-height: 44px; margin: 0; padding: 0; border-radius: 10px; background: #1D4ED8; color: #fff; font-size: 14px; font-weight: 600; line-height: 44px; }
.worker-self-home .worker-record-card { margin-top: 24px; }
.report-self-entry .app-bottom-nav button { padding: 6px 0; line-height: 17.6px; }
@keyframes worker-scan-breathe { 0% { transform: scale(.95); opacity: .6; } 100% { transform: scale(1.15); opacity: 0; } }
@media (max-height: 600px) { .worker-scan-intro { padding-top: 12px; padding-bottom: 8px; } .worker-scan-ring { width: 152px; height: 152px; margin-bottom: 18px; } .worker-self-home .worker-scan-hero image { width: 44px; height: 44px; } .worker-sku-divider { margin-top: 12px; } }
@media (prefers-reduced-motion: reduce) { .worker-scan-ring::before { animation: none; opacity: .3; transform: none; } }
@media (max-height: 600px) { .worker-scan-intro { padding-top: 8px; padding-bottom: 4px; } .worker-scan-ring { width: 144px; height: 144px; margin-bottom: 12px; } }

.work-queue{margin:24rpx 0;background:#fff;border:1rpx solid #dbe4ef;border-radius:28rpx;padding:28rpx}.work-queue-heading{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:700;color:#0f172a;margin-bottom:12rpx}.work-queue-heading text:last-child{font-size:24rpx;font-weight:400;color:#64748b}.work-queue-row{display:flex;align-items:center;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #edf2f7}.work-queue-index{font-size:24rpx;color:#94a3b8;width:24rpx}.work-queue-row>view{flex:1;min-width:0}.work-queue-process{display:block;font-size:30rpx;font-weight:600;color:#0f172a}.work-queue-order{display:block;font-size:23rpx;color:#64748b;margin-top:6rpx;word-break:break-all}.work-queue-status{font-size:23rpx;color:#64748b;flex-shrink:0}.work-queue-note{display:block;font-size:23rpx;color:#64748b;margin-top:20rpx}
/* The inner view owns flex layout; native scroll-view remains scrollable for results. */
.report-page.report-self-entry { box-sizing: border-box; }
.report-self-entry .worker-self-home { padding: 0; }
.worker-home-content { display: flex; flex-direction: column; min-height: 100%; padding: 12px 18px 16px; box-sizing: border-box; }
.report-self-entry .worker-scan-intro { flex-shrink: 0; padding: 8px 0; }
.report-self-entry .worker-scan-ring { width: calc(100vh - 500px - env(safe-area-inset-bottom)); height: calc(100vh - 500px - env(safe-area-inset-bottom)); min-width: 64px; min-height: 64px; max-width: 200px; max-height: 200px; margin-bottom: 12px; flex-shrink: 0; }
.report-self-entry .worker-scan-hero { padding: 0; font-size: 16px; }
.report-self-entry .worker-scan-hero image { width: 44px; height: 44px; margin: 0 0 4px; }
.report-self-entry .worker-scan-hint { font-size: 12px; line-height: 1.5; }
.report-self-entry .worker-sku-divider { flex-shrink: 0; margin: 12px 0 8px; }
.report-self-entry #worker-sku-section,.report-self-entry .worker-sku-results { flex-shrink: 0; }
.worker-home-content > .employee-summary-card { flex-shrink: 0; margin-top: auto; }
.worker-home-content > .worker-sku-results { padding-bottom: 16px; }
@media(max-height:620px) {
  .report-self-entry .worker-scan-ring { width: 100%; height: 64px; min-width: 0; min-height: 64px; max-width: none; max-height: 64px; margin-bottom: 0; }
  .report-self-entry .worker-scan-ring::before { display: none; }
  .report-self-entry .worker-scan-hero { flex-direction: row; gap: 8px; border-radius: 14px; letter-spacing: 0; }
  .report-self-entry .worker-scan-hero image { width: 28px; height: 28px; margin: 0; }
  .report-self-entry .employee-summary-card { min-height: 96px; padding: 12px; }
  .report-self-entry .worker-scan-hint { display: none; }
}
@media(max-height:480px) {
  .report-self-entry .report-header { height: 56px; padding: 6px 16px; }
  .report-self-entry .report-eyebrow { display: none; }
  .report-self-entry .worker-scan-intro { padding: 0; }
  .report-self-entry .worker-scan-ring { height: 44px; min-height: 44px; max-height: 44px; }
  .worker-home-content { padding: 8px 18px; }
  .report-self-entry .worker-sku-divider { margin: 0 0 6px; }
  .worker-home-content > .worker-sku-results { padding-bottom: 4px; }
  .report-self-entry .employee-summary-card { min-height: 88px; padding: 8px; }
  .report-self-entry .today-summary-value { font-size: 26px; }
}
