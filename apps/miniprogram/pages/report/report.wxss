.report-page .hero { margin: 0 0 16px; }
.report-page .hero-copy { color: #64748B; font-size: 14px; }
.report-page .card { padding: 20px; border: 1px solid #E2E8F0; border-radius: 16px; background: #fff; box-shadow: none; }
.report-page .primary-button { min-height: 56px; line-height: 56px; margin-top: 20px; padding: 0 12px; border-radius: 14px; background: #1D4ED8; color: #fff; font-size: 18px; font-weight: 800; box-shadow: 0 6px 16px rgba(29,78,216,.22); }
