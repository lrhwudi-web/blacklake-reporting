.worker-self-home .employee-summary-card{margin-top:24px}
@media(max-height:700px){
  .report-page .waiting-assignment-card{padding:24px 16px}.waiting-pulse{width:100px;height:100px;margin-bottom:12px}.waiting-core{inset:20px}
  .report-self-entry .worker-self-home{padding-top:12px;padding-bottom:12px}.worker-self-home .worker-scan-intro{padding:8px 12px 4px}.worker-self-home .worker-scan-ring{width:144px;height:144px;margin-bottom:16px}.worker-self-home .worker-scan-hero{padding-top:12px;font-size:16px}.worker-self-home .worker-scan-hero image{width:44px;height:44px;margin-bottom:4px}.worker-self-home .worker-scan-hint{font-size:12px;line-height:1.5}.worker-self-home .worker-sku-divider{margin:12px 0 8px}.worker-self-home .employee-summary-card{margin-top:16px;min-height:100px;padding:16px}
}

.working-panel { width: 100%; }
.work-summary { padding: 24px; min-height: 248px; box-sizing: border-box; text-align: left; border-radius: 20px; background: linear-gradient(135deg,#1D4ED8,#1E3A8A); color: #fff; }
