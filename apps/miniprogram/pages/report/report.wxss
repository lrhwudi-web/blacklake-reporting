.record-card-copy { display: block; margin-top: 6px; color: #64748B; font-size: 12px; }
.waiting-record-card image { flex: 0 0 20px; width: 20px; height: 20px; }
.employee-summary-card{width:100%;box-sizing:border-box;min-height:110px;margin-top:14px;padding:20px;border:1px solid #E2E8F0;border-radius:16px;background:#fff}
