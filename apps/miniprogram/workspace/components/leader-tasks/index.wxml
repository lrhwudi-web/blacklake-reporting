<template name="glass-image-viewer">
  <view class="task-view photo-root {{reduceMotion ? 'photo-reduced' : ''}}" wx:if="{{url}}" aria-role="dialog" aria-label="产品图片预览" aria-modal="true">
    <view class="task-view photo-mask {{open ? 'is-open' : ''}}" bindtap="closeProductPreview" catchtouchmove="photoStopBubble"/>
    <view class="task-view photo-shell {{open ? 'is-open' : ''}}" style="left:{{panelX}}px;top:{{panelY}}px;width:{{panelWidth}}px;height:{{panelHeight}}px;transform:{{open ? 'translate3d(0,0,0) scale(1,1)' : closedTransform}};border-radius:{{open ? '28px' : closedRadius}}"/>
    <view class="task-view photo-panel {{open ? 'is-open' : ''}}" data-anchor="{{anchorId}}" style="left:{{panelX}}px;top:{{panelY}}px;width:{{panelWidth}}px;height:{{panelHeight}}px" catchtap="photoStopBubble" aria-hidden="{{!open}}">
      <view class="task-view photo-heading"><text class="task-text">产品图片</text><button size="mini" class="native-button task-button photo-close" bindtap="closeProductPreview" aria-label="关闭图片"><image class="task-image photo-chevron" src="/workspace/assets/ui-chevron-down.png"/></button></view>
      <view mark:backIgnore="{{true}}" class="task-view photo-stage" bindtouchstart="onPhotoTouchStart" catchtouchmove="onPhotoTouchMove" bindtouchend="onPhotoTouchEnd" bindtouchcancel="onPhotoTouchEnd" catchtap="photoTap" data-scale="{{scale}}">
        <image wx:if="{{!failed}}" class="task-image photo-image" src="{{url}}" data-url="{{url}}" mode="aspectFit" style="transform:translate3d({{x}}px,{{y}}px,0) scale({{scale}})" bindload="photoLoaded" binderror="photoError"/>
        <text wx:else class="task-text photo-failed">图片加载失败</text>
      </view>
      <view class="task-view photo-footer"><view class="task-view photo-controls"><button size="mini" class="native-button task-button {{scale <= 1 || failed ? 'task-disabled' : ''}} photo-control {{scale <= 1 || failed ? 'photo-disabled' : ''}}" bindtap="photoZoomOut" disabled="{{scale <= 1 || failed}}" aria-label="缩小图片">−</button><button size="mini" class="native-button task-button {{failed ? 'task-disabled' : ''}} photo-control photo-percent" bindtap="photoReset" disabled="{{failed}}" aria-label="重置图片缩放">{{percent}}%</button><button size="mini" class="native-button task-button photo-control {{scale >= 4 || failed ? 'photo-disabled' : ''}}" bindtap="photoZoomIn" disabled="{{scale >= 4 || failed}}" aria-label="放大图片">+</button></view></view>
    </view>
  </view>
</template>

<view class="task-view orders-page glass-theme tasks-page tasks-minimal">
  <view class="task-view task-header" aria-hidden="{{!!reportPanel || !!assignmentPanel || !!productPanel || !!taskChooser}}">
    <view class="task-view task-toolbar">
      <block wx:if="{{!searchOpen}}"><text class="task-text task-title">任务</text><view class="task-view task-tools"><button size="mini" class="native-button task-button" bindtap="toggleTaskSearch" aria-label="搜索任务"><image class="task-image" src="/workspace/assets/people-search.png"/></button></view></block>
      <view class="task-view search-row" wx:else><input mark:backIgnore="{{true}}" class="search-input" value="{{keyword}}" bindinput="onTaskSearch" focus="{{searchOpen}}" placeholder="工单、产品、人员、工序" aria-label="搜索工单、产品、人员、工序"/><button size="mini" class="native-button task-button" bindtap="toggleTaskSearch" aria-label="取消任务搜索">取消</button></view>
    </view>
    <view mark:backIgnore="{{true}}" id="segment-taskTabs" class="task-view task-tabs glass-segments segment-two segment-interactive {{segmentTracks.taskTabs.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="taskTabs" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist" aria-label="任务记录分类">
      <view class="task-view segment-lens" style="transform:translate3d({{segmentTracks.taskTabs ? segmentTracks.taskTabs.x + 'px' : taskTab === 'assignments' ? '0%' : '100%'}},0,0) scale({{segmentTracks.taskTabs ? segmentTracks.taskTabs.scaleX : 1}},{{segmentTracks.taskTabs ? segmentTracks.taskTabs.scaleY : 1}})" aria-hidden="true"/>
      <button size="mini" class="native-button task-button segment-option {{taskTab === 'assignments' ? 'active' : ''}} {{segmentTracks.taskTabs.hover === 0 ? 'segment-hover' : ''}}" data-segment="taskTabs" data-index="0" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{taskTab === 'assignments'}}"><view class="task-view segment-label" style="transform:scale({{segmentTracks.taskTabs.scales[0] || 1}})">派工记录</view></button>
      <button size="mini" class="native-button task-button segment-option {{taskTab === 'reports' ? 'active' : ''}} {{segmentTracks.taskTabs.hover === 1 ? 'segment-hover' : ''}}" data-segment="taskTabs" data-index="1" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{taskTab === 'reports'}}"><view class="task-view segment-label" style="transform:scale({{segmentTracks.taskTabs.scales[1] || 1}})">报工记录</view></button>
    </view>
  </view>
  <view class="task-view task-overview-controls" wx:if="{{!taskDrill}}" aria-hidden="{{!!taskChooser}}"><button size="mini" class="native-button task-button task-history-entry {{assignmentHistory ? 'is-history' : ''}}" wx:if="{{taskTab === 'assignments'}}" bindtap="openTaskHistory" aria-label="{{assignmentHistory ? '返回当前排工' : '按时间查看排工历史'}}"><view class="task-view task-history-clock"><view class="task-view task-history-hour"/><view class="task-view task-history-minute"/></view><text class="task-text">{{assignmentHistory ? '当前' : '历史'}}</text></button><button size="mini" class="native-button task-button task-overview-filter" data-kind="filter" bindtap="openTaskChooser" aria-label="{{taskTab === 'assignments' ? '筛选派工状态' : '选择报工日期和记录状态'}}"><text class="task-text">{{overviewFilterLabel}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></button><button size="mini" class="native-button task-button task-overview-group" data-kind="group" bindtap="openTaskChooser" aria-label="选择分组方式"><text class="task-text">{{overviewGroupLabel}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <view class="task-view task-drill-controls" wx:else><button size="mini" class="native-button task-button task-drill-back" bindtap="closeTaskGroup" aria-label="返回人员和记录分组"><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/><text class="task-text">{{taskDrill.label}}</text></button><text class="task-text">{{taskTab === 'assignments' ? (assignmentHistory ? '历史 ' : '未完成 ') : ''}}{{drillCount}} {{taskTab === 'assignments' ? '项' : '条报工'}}</text><button size="mini" class="native-button task-button task-history-entry {{assignmentHistory ? 'is-history' : ''}}" wx:if="{{taskTab === 'assignments'}}" bindtap="openTaskHistory" aria-label="{{assignmentHistory ? '返回当前排工' : '按时间查看排工历史'}}"><view class="task-view task-history-clock"><view class="task-view task-history-hour"/><view class="task-view task-history-minute"/></view><text class="task-text">{{assignmentHistory ? '当前' : '历史'}}</text></button><button size="mini" class="native-button task-button task-drill-filter" data-kind="filter" bindtap="openTaskChooser">筛选</button></view>
  <view class="task-view task-error" wx:if="{{executionError}}" aria-role="alert"><text class="task-text">{{executionError}}</text><button size="mini" class="native-button task-button {{executionLoading || actionBusy ? 'task-disabled' : ''}}" bindtap="refreshTasks" disabled="{{executionLoading || actionBusy}}">重试</button></view>
  <scroll-view enhanced="{{true}}" class="task-scroll" scroll-y="{{!reportPanel && !assignmentPanel && !assignmentMenu && !productPanel && !taskChooser}}" aria-hidden="{{!!reportPanel || !!assignmentPanel || !!assignmentMenu || !!productPanel || !!taskChooser}}" show-scrollbar="{{false}}">
    <text class="task-text task-loading" wx:if="{{executionLoading}}">正在读取…</text>
    <block wx:if="{{!taskDrill}}"><view class="task-view task-overview-list" wx:if="{{overviewGroups.length}}"><button size="mini" class="native-button task-button task-summary-row {{index ? 'has-divider' : ''}}" wx:for="{{overviewGroups}}" wx:key="key" data-key="{{item.key}}" bindtap="openTaskGroup" aria-label="查看{{item.label}}的{{item.count}}{{taskTab === 'assignments' ? '项派工' : '条报工'}}"><view class="task-view task-summary-copy"><text class="task-text task-summary-title">{{item.label}}</text><view class="task-view task-summary-subtitle"><text class="task-text task-summary-preview">{{item.preview}}</text><text class="task-text" wx:if="{{item.state}}"> · </text><text class="task-text task-summary-state state-{{item.stateCode}}" wx:if="{{item.state}}">{{item.state}}</text></view></view><text class="task-text task-summary-count" wx:if="{{taskTab === 'assignments'}}">{{item.count}} 项</text><image class="task-image task-summary-chevron" src="/workspace/assets/ui-chevron-down.png"/></button></view><text class="task-text task-empty" wx:if="{{loaded && !overviewGroups.length && !executionLoading}}">{{taskTab === 'assignments' ? '暂无匹配派工' : '暂无匹配报工'}}</text></block>
    <block wx:else>
    <block wx:if="{{taskTab === 'assignments'}}">
      <view class="task-view task-assignment-list {{inlineSorting ? 'is-inline-sorting' : ''}}" wx:if="{{displayTasks.length}}" style="{{inlineSorting ? 'height:' + inlineListHeight + 'px' : ''}}">
      <view class="task-view task-card task-assignment-row {{item.inlineHandle ? 'has-inline-handle' : ''}} {{item.inlinePreviewCurrent ? 'is-employee-current' : ''}} {{inlineSorting ? 'is-inline-positioned' : ''}} {{item.inlineHeld ? 'is-inline-held' : ''}} {{reduceMotion ? 'inline-reduced' : ''}}" id="assignment-card-{{index}}" wx:for="{{displayTasks}}" wx:key="id" style="{{inlineSorting ? 'height:' + item.inlineHeight + 'px;transform:translate3d(0,' + item.inlineY + 'px,0) scale(' + (item.inlineHeld && !reduceMotion ? '1.015' : '1') + ')' : ''}}">
        <button size="mini" mark:backIgnore="{{true}}" class="native-button task-button {{!item.inlineDraggable || (actionBusy && !inlineSorting) ? 'task-disabled' : ''}} task-card-grip" wx:if="{{item.inlineHandle}}" data-id="{{item.id}}" bindtouchstart="onInlineSortStart" catchtouchmove="onInlineSortMove" bindtouchend="onInlineSortEnd" bindtouchcancel="onInlineSortCancel" catchtap="stopQueueTap" disabled="{{!item.inlineDraggable || (actionBusy && !inlineSorting)}}" aria-label="拖动调整{{item.processName}}顺序"><image class="task-image" src="/workspace/assets/ui-grip-vertical.png"/></button>
        <button size="mini" class="native-button task-button {{actionBusy ? 'task-disabled' : ''}} task-record-main" data-id="{{item.id}}" data-record="true" bindtap="openTaskProduct" bindlongpress="openTaskQueue" disabled="{{actionBusy}}" aria-label="查看{{item.workerName}}的{{item.processName}}派工详情，工单{{item.orderCode || '编号未提供'}}" aria-expanded="{{productPanel.assignmentId === '' + item.id && productPanelOpen}}">
          <view class="task-view task-record-title"><text class="task-text">{{item.processName}}</text><text class="task-text task-current-badge" wx:if="{{item.inlinePreviewCurrent}}">员工当前</text><text class="task-text task-urgent" wx:elif="{{item.priority === 'URGENT'}}">加急</text></view>
          <view class="task-view task-record-meta"><text class="task-text">{{item.assignedShort}} 派工</text><text class="task-text" wx:if="{{taskDrill.mode !== 'person'}}">{{item.workerName}}</text><text class="task-text">· 已生产 {{item.elapsedShortText}}{{item.timerPaused ? ' · 计时已暂停' : ''}}</text></view>
          <text class="task-text task-record-order">工单编号 {{item.orderCode || '未提供'}}</text>
        </button>
        <text class="task-text task-record-status state-{{item.timerPaused ? 'PAUSED' : item.status}}">{{item.statusText}}</text>
        <button size="mini" wx:if="{{canManageExecution && (item.canEditAssignment || item.canCancelAssignment)}}" id="assignment-more-{{index}}" class="native-button task-button {{actionBusy ? 'task-disabled' : ''}} task-assignment-more {{assignmentMenu.assignmentId === item.id && assignmentMenuOpen ? 'is-active' : ''}}" data-id="{{item.id}}" data-anchor="assignment-more-{{index}}" bindtap="showAssignmentActions" disabled="{{actionBusy}}" aria-label="{{item.workerName}}派工更多操作" aria-expanded="{{assignmentMenu.assignmentId === item.id && assignmentMenuOpen}}"><image class="task-image" src="/workspace/assets/ui-dots-vertical.png"/></button>
      </view>
      </view>
      <text class="task-text task-empty" wx:if="{{loaded && !displayTasks.length && !executionLoading}}">暂无匹配派工</text>
    </block>
    <block wx:else>
      <view class="task-view task-report-context" wx:if="{{sourceLabel || reportScope}}"><view class="task-view"><text class="task-text">{{sourceLabel}}</text><text class="task-text task-context-separator" wx:if="{{sourceLabel && scopeLabel}}"> · </text><text class="task-text task-context-scope" wx:if="{{scopeLabel}}">{{scopeLabel}}</text></view><button size="mini" class="native-button task-button" wx:if="{{reportScope}}" bindtap="clearReportScope">全部记录</button></view>
      <view class="task-view task-report-card record-compact {{item.deleted ? 'is-deleted' : ''}}" wx:for="{{displayReports}}" wx:key="id">
        <view class="task-view record-head"><button size="mini" class="native-button task-button record-person record-person-button record-order-title" data-id="{{item.assignmentId}}" bindtap="openTaskProduct" aria-label="查看工单{{item.orderCode || '编号未提供'}}的报工详情">{{item.orderCode || '工单编号未提供'}}</button><text class="task-text record-sync {{item.recordSyncWarning ? 'record-sync-warning' : ''}}" wx:if="{{item.recordSyncText}}">{{item.recordSyncText}}</text><text class="task-text record-stamp">{{item.recordTimeText}}</text></view>
        <view class="task-view record-bottom"><view class="task-view record-metrics"><view class="task-view record-stat"><text class="task-text record-label">良品数</text><text class="task-text record-value">{{item.recordGoodText}}</text></view><view class="task-view record-stat"><text class="task-text record-label">不良数</text><text class="task-text record-value record-bad">{{item.recordBadText}}</text></view><view class="task-view record-stat"><text class="task-text record-label">时长</text><text class="task-text record-value record-duration">{{item.recordDurationText}}</text></view></view><button size="mini" wx:if="{{canManageExecution && (item.canEdit || item.canDelete || item.canRestore)}}" id="{{item.anchorId}}" class="native-button task-button record-action {{reportMenu.reportId === '' + item.id && reportMenuOpen ? 'is-active' : ''}}" data-id="{{item.id}}" data-anchor="{{item.anchorId}}" bindtap="showReportActions" aria-label="{{item.recordWorkerText}}报工更多操作" aria-expanded="{{reportMenu.reportId === '' + item.id && reportMenuOpen}}"><image class="task-image record-action-icon" src="/workspace/assets/ui-dots-vertical.png"/></button></view>
        <text class="task-text record-deleted" wx:if="{{item.deleted}}">已删除</text>
      </view>
      <text class="task-text task-empty" wx:if="{{loaded && !displayReports.length && !executionLoading}}">{{showDeleted ? '暂无已删除报工' : '暂无匹配报工'}}</text>
    </block>
    </block>
    <view class="task-view task-empty" wx:if="{{assignmentHistory && taskTab === 'assignments'}}"><text class="task-text" wx:if="{{historyLoading}}">正在读取历史派工…</text><button size="mini" class="native-button task-button" wx:elif="{{historyError}}" bindtap="retryAssignmentHistory">{{historyError}} · 重试</button><button size="mini" class="native-button task-button" wx:elif="{{historyHasMore}}" bindtap="loadMoreAssignmentHistory">加载更多历史派工</button></view>
    <view class="task-view task-bottom-space"/>
  </scroll-view>
  <view class="task-view report-menu-mask" wx:if="{{reportMenu}}" catchtap="closeReportMenu" catchtouchmove="closeReportMenu"/>
  <view class="task-view report-action-menu {{reportMenuOpen ? 'is-open' : ''}} {{reduceMotion ? 'menu-reduced' : ''}}" data-anchor="{{reportMenu.anchorId}}" wx:if="{{reportMenu}}" style="left:{{reportMenu.x}}px;top:{{reportMenu.y}}px;width:{{reportMenu.width}}px;transform-origin:{{reportMenu.originX}}px {{reportMenu.originY}}px" aria-role="menu" aria-label="报工操作" aria-hidden="{{!reportMenuOpen}}" catchtap="stopProcessBubble">
    <view class="task-view report-menu-arrow arrow-{{reportMenu.side}}" style="{{reportMenu.arrowStyle}}"/>
    <view class="task-view report-menu-surface">
      <button size="mini" class="native-button task-button {{!reportMenuOpen || actionBusy ? 'task-disabled' : ''}} report-menu-item {{item.action === 'deleteReport' ? 'is-danger' : ''}}" wx:for="{{reportMenu.options}}" wx:key="action" data-action="{{item.action}}" catchtap="chooseReportMenuAction" disabled="{{!reportMenuOpen || actionBusy}}" aria-role="menuitem">
        <view class="task-view report-menu-icon icon-{{item.icon}}"><view class="task-view pencil-body" wx:if="{{item.icon === 'edit'}}"></view><view class="task-view trash-body" wx:if="{{item.icon === 'delete'}}"><view class="task-view trash-lid"></view><view class="task-view trash-handle"></view></view><view class="task-view restore-ring" wx:if="{{item.icon === 'restore'}}"></view></view><text class="task-text">{{item.label}}</text>
      </button>
    </view>
  </view>
  <view class="task-view report-mask" wx:if="{{reportPanel}}" catchtap="closeReportLayer"/>
  <view class="task-view report-panel {{reportPanel.isEditor ? 'report-editor-panel' : ''}} {{reportPeopleOpen ? 'is-selecting-people' : ''}} {{reportDefectsOpen ? 'is-editing-defects' : ''}}" style="{{reportPanel.isEditor ? 'height:' + reportEditorHeight + 'px;' + reportExpandStyle : ''}}" wx:if="{{reportPanel}}" aria-role="dialog" aria-label="{{reportPeopleMounted ? '选择生产人员' : reportPanel.title}}" aria-modal="true" aria-hidden="{{!!reportTimeWheel}}" catchtap="stopProcessBubble">
    <view mark:backIgnore="{{true}}" class="task-view report-editor-grip" wx:if="{{reportPanel.isEditor && !reportPeopleMounted && !reportTimeWheel}}" bindtouchstart="reportEditorResizeStart" catchtouchmove="reportEditorResizeMove" bindtouchend="reportEditorResizeEnd" bindtouchcancel="reportEditorResizeEnd" aria-label="上下拖动调整编辑报工高度"><view class="task-view sheet-grip-line"/></view>
    <view class="task-view report-panel-heading"><view class="task-view"><text class="task-text">{{reportPeopleMounted ? '选择人员' : reportPanel.title}}</text><text class="task-text">{{reportPanel.processName}} · {{reportPanel.isEditor ? reportEditor.workerName : reportPanel.workerName}}</text></view><button size="mini" class="native-button task-button {{actionBusy ? 'task-disabled' : ''}}" bindtap="closeReportLayer" disabled="{{actionBusy}}" aria-label="{{reportPeopleMounted ? '返回报工编辑' : '关闭报工编辑'}}"><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></button></view>
    <view class="task-view report-editor-stage" wx:if="{{reportPanel.isEditor}}">
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="report-editor-scroll report-editor-main {{reportPeopleOpen ? 'is-obscured' : ''}}" scroll-y="true" scroll-into-view="{{reportDefectsOpen ? 'report-defect-fields' : ''}}" aria-hidden="{{reportPeopleOpen}}">
      <text class="task-text editor-section-label">生产信息</text>
      <view class="task-view editor-group">
        <button size="mini" class="native-button task-button editor-row editor-person-trigger" bindtap="openReportPeople" aria-label="选择生产人员" aria-expanded="{{reportPeopleOpen}}"><text class="task-text">生产人员</text><view class="task-view"><text class="task-text">{{reportEditor.workerName}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></view></button>
        <view class="task-view editor-quantity-grid"><view class="task-view"><text class="task-text">良品数</text><input mark:backIgnore="{{true}}" type="number" focus="{{false}}" value="{{reportGood}}" bindinput="onReportGood" aria-label="修改合格数"/></view><view class="task-view"><text class="task-text">不良数</text><input mark:backIgnore="{{true}}" type="number" focus="{{false}}" value="{{reportBad}}" bindinput="onReportBad" aria-label="修改不良数"/></view></view>
        <button size="mini" class="native-button task-button editor-row editor-defect-trigger" bindtap="toggleReportDefects" aria-expanded="{{reportDefectsOpen}}"><text class="task-text">不良品项</text><view class="task-view"><text class="task-text">{{reportBad === '0' ? '无不良' : reportDefectText || '选择并分配数量'}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></view></button>
        <view id="report-defect-fields" class="task-view editor-defects" wx:if="{{reportDefectsOpen}}"><view class="task-view editor-defect-row" wx:for="{{reportEditor.defects}}" wx:key="code"><button size="mini" class="native-button task-button defect-choice {{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="toggleReportDefect" aria-role="checkbox" aria-checked="{{item.selected}}">{{item.name}}</button><input mark:backIgnore="{{true}}" wx:if="{{item.selected}}" type="number" value="{{item.quantity}}" data-code="{{item.code}}" bindinput="onReportDefectQuantity" aria-label="{{item.name}}数量"/></view><text class="task-text editor-small-note">各项数量合计需等于不良数</text></view>
      </view>
      <text class="task-text editor-section-label">时间与工时</text>
      <view class="task-view editor-group">
        <view class="task-view editor-time-grid">
          <button size="mini" class="native-button task-button editor-time-trigger" data-part="start" bindtap="openReportDateTime" aria-label="选择开始时间"><text class="task-text editor-time-label">开始时间</text><text class="task-text editor-date">{{reportEditor.startDate || '选择日期'}}</text><view class="task-view"><text class="task-text editor-time">{{reportEditor.startTime || '选择时间'}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></view></button>
          <button size="mini" class="native-button task-button editor-time-trigger" data-part="end" bindtap="openReportDateTime" aria-label="选择结束时间"><text class="task-text editor-time-label">结束时间</text><text class="task-text editor-date">{{reportEditor.endDate || '选择日期'}}</text><view class="task-view"><text class="task-text editor-time">{{reportEditor.endTime || '选择时间'}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></view></button>
        </view>
        <view class="task-view editor-row editor-worktime"><text class="task-text">工时</text><view class="task-view editor-duration unified-duration"><input mark:backIgnore="{{true}}" type="number" value="{{reportEditor.hours}}" data-field="hours" bindinput="onReportField" aria-label="工时小时"/><text class="task-text">时</text><input mark:backIgnore="{{true}}" type="number" value="{{reportEditor.minutes}}" data-field="minutes" bindinput="onReportField" aria-label="工时分钟"/><text class="task-text">分</text><button size="mini" class="native-button task-button" bindtap="recalculateReport" aria-label="按起止时间重算工时">重算</button></view></view>
      </view>
      <button size="mini" class="native-button task-button editor-extra-toggle" bindtap="toggleReportExtra" aria-expanded="{{reportExtra}}"><text class="task-text">更多信息</text><text class="task-text">{{reportExtra ? '收起' : '用料工序、打卡时长'}}</text><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></button>
      <view class="task-view editor-group" wx:if="{{reportExtra}}"><view class="task-view editor-row"><text class="task-text">用料工序</text><input mark:backIgnore="{{true}}" value="{{reportEditor.materialProcess}}" data-field="materialProcess" bindinput="onReportField" maxlength="100" placeholder="选填" aria-label="用料工序"/></view><view class="task-view editor-row"><text class="task-text">打卡时长</text><view class="task-view"><text class="task-text">{{reportEditor.punchMinutes ? reportEditor.punchMinutes + ' 分钟' : '—'}}</text><text class="task-text editor-punch-auto">按起止时间计算</text></view></view></view>
      <view class="task-view editor-scroll-space"/>
    </scroll-view>
    <view class="task-view report-people-layer {{reportPeopleOpen ? 'is-open' : ''}}" wx:if="{{reportPeopleMounted}}" aria-hidden="{{!reportPeopleOpen}}">
