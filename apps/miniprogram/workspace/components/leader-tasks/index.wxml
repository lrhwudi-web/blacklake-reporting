    </block>
    <block wx:elif="{{queueStep === 'process'}}"><text class="task-text queue-section-label">选择工序</text><button size="mini" class="native-button task-button {{queueLoading || actionBusy ? 'task-disabled' : ''}} queue-process-option" wx:for="{{queueProcesses}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseQueueProcess" disabled="{{queueLoading || actionBusy}}"><text class="task-text">{{item.name}}</text><image class="task-image queue-chevron" src="/workspace/assets/ui-chevron-down.png"/></button><text class="task-text queue-empty" wx:if="{{!queueProcesses.length}}">暂无可插单工序，已有任务可返回选择。</text><text class="task-text queue-empty" wx:if="{{queueLoading}}">正在核对…</text></block>
    <block wx:else><view class="task-view queue-confirm-target"><text class="task-text">{{queueTarget.processName}}</text><text class="task-text">{{queueTarget.orderCode}}</text></view><view class="task-view queue-impact" wx:if="{{queueImpact.length}}"><text class="task-text">将暂停当前任务</text><view class="task-view" wx:for="{{queueImpact}}" wx:key="id"><text class="task-text">{{item.processName}}</text><text class="task-text">{{item.orderCode}}</text></view></view><text class="task-text queue-confirm-note">自动放到第一位，显示在员工端。员工点击开始后计时，原任务和报工保留。</text></block>
  </scroll-view>
  <view class="task-view queue-footer"><view class="task-view queue-error" wx:if="{{queueError}}" aria-role="alert"><text class="task-text">{{queueError}}</text><button size="mini" class="native-button task-button {{actionBusy || queueLoading ? 'task-disabled' : ''}}" bindtap="retryQueueStep" disabled="{{actionBusy || queueLoading}}">重新核对</button></view><view class="task-view queue-footer-buttons" wx:if="{{queueStep === 'queue'}}"><button size="mini" class="native-button task-button {{actionBusy || queueLoading ? 'task-disabled' : ''}} queue-add" bindtap="startQueueInsert" disabled="{{actionBusy || queueLoading}}"><image class="task-image" src="/workspace/assets/ui-circle-plus.png"/><text class="task-text">新增插单</text></button><button size="mini" class="native-button task-button {{!queueDirty || actionBusy || queueLoading || !!assignmentPanel.blockedReason ? 'task-disabled' : ''}} queue-save" data-kind="sort" bindtap="applyTaskQueue" disabled="{{!queueDirty || actionBusy || queueLoading || !!assignmentPanel.blockedReason}}">{{actionBusy ? '保存中…' : '保存顺序'}}</button></view><button size="mini" class="native-button task-button {{actionBusy || queueLoading ? 'task-disabled' : ''}} queue-save queue-confirm" wx:elif="{{queueStep === 'confirm'}}" data-kind="insert" bindtap="applyTaskQueue" disabled="{{actionBusy || queueLoading}}">{{actionBusy ? '处理中…' : '确认插单'}}</button></view>
</view>

  <view class="task-view task-product-mask {{productPanelOpen ? 'is-open' : ''}} {{reduceMotion ? 'product-reduced' : ''}}" wx:if="{{productPanel}}" catchtap="closeTaskProduct" catchtouchmove="stopTaskProductBubble"/>
<view class="task-view task-product-panel {{productPanelOpen ? 'is-open' : ''}} {{reduceMotion ? 'product-reduced' : ''}}" wx:if="{{productPanel}}" aria-role="dialog" aria-label="{{productPanel.taskRecord ? '派工详情' : '产品完整资料'}}" aria-modal="true" aria-hidden="{{!productPanelOpen || !!imageViewer}}" catchtap="stopTaskProductBubble">
  <view class="task-view task-product-heading"><view class="task-view"><text class="task-text">{{productPanel.taskRecord ? '派工详情' : '产品资料'}}</text><text class="task-text">{{productPanel.orderCode}}</text></view><button size="mini" class="native-button task-button" bindtap="closeTaskProduct" aria-label="{{productPanel.taskRecord ? '关闭派工详情' : '关闭产品资料'}}"><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="task-product-scroll" scroll-y="{{!imageViewer}}">
    <view class="task-view task-record-detail" wx:if="{{productPanel.taskRecord}}"><view class="task-view task-record-detail-heading"><text class="task-text">{{productPanel.taskRecord.processName}}</text><text class="task-text task-record-status-text state-{{productPanel.taskRecord.status}}">{{productPanel.taskRecord.statusText}}</text></view><text class="task-text task-record-detail-worker">{{productPanel.taskRecord.workerName}} · {{productPanel.taskRecord.assignedShort}} 派工</text><text class="task-text task-record-detail-time">已生产 {{productPanel.taskRecord.elapsedShortText}}{{productPanel.taskRecord.timerPaused ? ' · 计时已暂停' : ''}}</text><view class="task-view task-pause" wx:if="{{productPanel.taskRecord.status === 'PAUSED'}}"><text class="task-text">{{productPanel.taskRecord.pauseReason || '等待组长继续安排'}}</text><text class="task-text" wx:if="{{productPanel.taskRecord.resumeBlockedReason}}">{{productPanel.taskRecord.resumeBlockedReason}}</text></view></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" mark:backIgnore="{{true}}" class="task-product-gallery" scroll-x="true" wx:if="{{productPanel.images.length}}"><view class="task-view task-product-image-track"><button size="mini" wx:for="{{productPanel.images}}" wx:key="url" id="task-product-image-{{item.index}}" class="native-button task-button {{item.failed ? 'task-disabled' : ''}} task-product-image" data-index="{{item.index}}" bindtap="previewTaskProductImage" disabled="{{item.failed}}" aria-label="放大产品图片{{item.index + 1}}"><image class="task-image" wx:if="{{!item.failed}}" src="{{item.url}}" mode="aspectFit" data-url="{{item.url}}" binderror="taskProductImageError"/><text class="task-text" wx:else>图片加载失败</text></button></view></scroll-view>
    <view class="task-view task-product-no-image" wx:else><view class="task-view product-placeholder-icon"/><text class="task-text">暂无图片</text></view>
    <text class="task-text task-product-title">{{productPanel.title}}</text>
    <view class="task-view task-product-fields"><view wx:for="{{productPanel.fields}}" wx:key="label" class="task-view task-product-field"><text class="task-text">{{item.label}}</text><text class="task-text">{{item.value}}</text></view></view>
    <text class="task-text task-product-source">{{sourceLabel}}{{productPanel.fetchedText ? ' · 查询于 ' + productPanel.fetchedText : ''}}</text>
  </scroll-view>
  <view class="task-view task-record-detail-actions" wx:if="{{productPanel.taskRecord}}"><button size="mini" class="native-button task-button {{!productPanelOpen || actionBusy ? 'task-disabled' : ''}} task-report-capsule" bindtap="showTaskProductReports" disabled="{{!productPanelOpen || actionBusy}}" aria-label="报工记录 {{productPanel.taskRecord.reportCount}}"><image class="task-image task-report-capsule-icon" src="/workspace/assets/liquid-nav-home-blue.png"/><text class="task-text">报工记录</text><text class="task-text task-report-capsule-count">{{productPanel.taskRecord.reportCount}}</text><image class="task-image task-report-capsule-arrow" src="/workspace/assets/ui-chevron-down.png"/></button><button size="mini" wx:if="{{productPanel.taskRecord.status === 'PAUSED'}}" class="native-button task-button {{!productPanelOpen || !productPanel.taskRecord.canResume || !canManageExecution || actionBusy ? 'task-disabled' : ''}} task-resume" bindtap="resumeTaskProduct" disabled="{{!productPanelOpen || !productPanel.taskRecord.canResume || !canManageExecution || actionBusy}}">继续启动</button></view>
</view>

  <view class="task-view task-chooser-mask {{taskChooserOpen ? 'is-open' : ''}}" wx:if="{{taskChooser}}" catchtap="closeTaskChooser" catchtouchmove="stopTaskChooserBubble"/>
<view class="task-view task-chooser {{taskChooserOpen ? 'is-open' : ''}} {{reduceMotion ? 'chooser-reduced' : ''}}" wx:if="{{taskChooser}}" aria-role="dialog" aria-label="{{taskChooser.title}}" aria-modal="true" aria-hidden="{{!taskChooserOpen}}" catchtap="stopTaskChooserBubble">
  <view class="task-view task-chooser-heading"><text class="task-text">{{taskChooser.title}}</text><button size="mini" class="native-button task-button" bindtap="closeTaskChooser" aria-label="关闭筛选"><image class="task-image" src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="task-chooser-body" scroll-y="true" style="height:{{(taskChooser.kind === 'date' || taskChooser.kind === 'history-date') ? 360 : taskChooser.options.length * 44}}px">
    <button size="mini" class="native-button task-button task-chooser-option {{item.selected ? 'selected' : ''}}" wx:for="{{taskChooser.options}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseTaskOption" aria-pressed="{{item.selected}}"><text class="task-text">{{item.label}}</text><text class="task-text" wx:if="{{item.selected}}">已选</text></button>
    <view class="task-view task-custom-date" wx:if="{{taskChooser.kind === 'date' || taskChooser.kind === 'history-date'}}"><text class="task-text">自选日期</text><view class="task-view task-date-pickers"><picker mark:backIgnore="{{true}}" mode="date" value="{{taskDateDraft.start}}" data-field="start" bindchange="onTaskDateChange" aria-label="{{taskChooser.kind === 'history-date' ? '历史开始日期' : '报工开始日期'}}"><view class="task-view"><text class="task-text">开始</text><text class="task-text">{{taskDateDraft.start || '选择日期'}}</text></view></picker><picker mark:backIgnore="{{true}}" mode="date" value="{{taskDateDraft.end}}" data-field="end" bindchange="onTaskDateChange" aria-label="{{taskChooser.kind === 'history-date' ? '历史结束日期' : '报工结束日期'}}"><view class="task-view"><text class="task-text">结束</text><text class="task-text">{{taskDateDraft.end || '选择日期'}}</text></view></picker></view><text class="task-text task-date-error" wx:if="{{taskDateError}}">{{taskDateError}}</text><button size="mini" class="native-button task-button task-date-apply" bindtap="applyTaskDates">应用日期</button><view class="task-view task-record-states" wx:if="{{taskChooser.kind === 'date'}}"><button size="mini" class="native-button task-button {{!showDeleted ? 'selected' : ''}}" data-deleted="false" bindtap="chooseTaskDeleted" aria-pressed="{{!showDeleted}}">有效记录</button><button size="mini" class="native-button task-button {{showDeleted ? 'selected' : ''}}" data-deleted="true" bindtap="chooseTaskDeleted" aria-pressed="{{showDeleted}}">已删除 {{deletedCount}}</button></view></view>
  </scroll-view>
  <view class="task-view task-chooser-footer"><text class="task-text">{{sourceLabel}}{{updatedLabel ? ' · 已加载资料' : ''}}</text><button size="mini" class="native-button task-button {{executionLoading || actionBusy ? 'task-disabled' : ''}}" bindtap="refreshFromTaskChooser" disabled="{{executionLoading || actionBusy}}">刷新资料</button></view>
</view>

  <template wx:if="{{imageViewer}}" is="glass-image-viewer" data="{{...imageViewer}}"/>
</view>
