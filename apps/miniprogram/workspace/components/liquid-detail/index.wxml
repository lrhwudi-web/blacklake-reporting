<view class="liquid-root {{reduceMotion ? 'liquid-reduced' : ''}}" wx:if="{{liquidActive}}">
  <view class="liquid-mask {{liquidOpen ? 'is-open' : ''}}" bindtap="maskTap" catchtouchmove="stopBubble"></view>
  <view class="liquid-shell {{liquidOpen ? 'is-open' : ''}}" style="left:{{panelX}}px;top:{{panelY}}px;width:{{panelWidth}}px;height:{{panelHeight}}px;transform:{{liquidOpen ? openTransform : closedTransform}};border-radius:{{liquidOpen ? '24px' : closedRadius}};" aria-hidden="true"></view>
  <view class="liquid-content {{liquidOpen ? 'is-open' : ''}}" style="left:{{panelX}}px;top:{{panelY}}px;width:{{panelWidth}}px;height:{{panelHeight}}px;" catchtap="stopBubble" aria-role="dialog" aria-label="工单详情" aria-modal="true">
<import src="../../templates/image-viewer.wxml"/>
<view class="liquid-view detail-page glass-theme {{employeeView ? 'employee-order-detail' : ''}}">
  <view class="liquid-view detail-header">
    <button size="mini" class="native-button liquid-button back-entry" bindtap="returnToOrders" aria-label="收起详情"><image class="liquid-image" src="/workspace/assets/ui-chevron-down.png"/></button>
    <view class="liquid-view detail-heading"><text class="liquid-text detail-eyebrow">安心报工 · 工单</text><text class="liquid-text detail-title">工单详情</text></view>
    <button size="mini" class="native-button liquid-button {{loading || !hasContext ? 'liquid-disabled' : ''}} refresh-entry" bindtap="refreshDetail" disabled="{{loading || !hasContext}}">{{loading ? '更新中' : '刷新'}}</button>
  </view>
  <scroll-view enhanced="{{true}}" class="detail-scroll" scroll-y="{{!swipeDragging}}" scroll-into-view="{{detailScrollTarget}}" show-scrollbar="{{false}}" wx:if="{{ready}}">
    <view class="liquid-view detail-refresh-note" wx:if="{{detailRefreshText}}" style="padding:8px 20px;color:#526882;font-size:12px"><text class="liquid-text">{{detailRefreshText}}</text></view>
    <view class="liquid-view detail-error" wx:if="{{loadError}}"><text class="liquid-text">{{loadError}}</text><text class="liquid-text">以下保留上次读取的信息。</text></view>
    <view class="liquid-view detail-hero">
      <view class="liquid-view hero-top">
        <view id="detail-product-photo" class="liquid-view detail-picture" bindtap="previewImage" aria-role="button" aria-label="查看产品图片"><image class="liquid-image" wx:if="{{order.imageUrl && !imageFailed}}" src="{{order.imageUrl}}" mode="aspectFit" binderror="imageError"/><text class="liquid-text" wx:else>{{imageFailed ? '图片加载失败' : '暂无图片'}}</text></view>
        <view class="liquid-view hero-copy"><view class="liquid-view detail-badges"><text class="liquid-text order-state {{order.status === 'IN_PROGRESS' ? 'running' : ''}}">{{order.statusText}}</text><text class="liquid-text detail-due {{order.overdue ? 'is-overdue' : ''}}" wx:if="{{order.dueText}}">{{order.dueLabel}} {{order.dueText}}</text></view><text class="liquid-text detail-order-code">{{order.code}}</text></view>
        <view class="liquid-view detail-plan {{order.planText.length > 8 ? 'plan-long' : order.planText.length > 4 ? 'plan-wide' : ''}}"><text class="liquid-text">{{order.planText}}</text><text class="liquid-text">计划数</text></view>
      </view>
      <view class="liquid-view detail-summary-meta"><view class="liquid-view"><image class="liquid-image" src="/workspace/assets/ui-file-description.png"/><text class="liquid-text">工单编号：{{order.code}}</text></view><view class="liquid-view"><image class="liquid-image" src="/workspace/assets/ui-clock.png"/><text class="liquid-text">计划时间：{{order.startAt}} ~ {{order.endAt}}</text></view><view class="liquid-view"><image class="liquid-image" src="/workspace/assets/ui-package.png"/><text class="liquid-text">产品信息：{{order.product}}</text></view><view class="liquid-view"><image class="liquid-image" src="/workspace/assets/ui-progress.png"/><text class="liquid-text">工单进度：{{order.actualText}}/{{order.planText}}{{order.unitText}}</text></view></view>
      <button size="mini" class="native-button liquid-button summary-toggle" bindtap="toggleSummary" aria-expanded="{{summaryExpanded}}">{{summaryExpanded ? '收起工单信息' : '展开工单信息'}}<image class="liquid-image {{summaryExpanded ? 'turned' : ''}}" src="/workspace/assets/ui-chevron-down.png"/></button>
      <view class="liquid-view summary-information" wx:if="{{summaryExpanded}}">
        <view class="liquid-view information-row"><text class="liquid-text">创建时间</text><text class="liquid-text">{{order.createdAt || '未提供'}}</text></view>
        <view class="liquid-view information-row"><text class="liquid-text">上次同步</text><text class="liquid-text">{{updatedLabel || '未提供'}}</text></view>
        <view class="liquid-view information-row"><text class="liquid-text">上游更新时间</text><text class="liquid-text">{{upstreamUpdatedLabel}}</text></view>
      </view>
    </view>
    <view id="detail-section-start" class="liquid-view detail-section-anchor"/>
    <view mark:backIgnore="{{true}}" id="segment-tabs" class="liquid-view detail-tabs glass-segments segment-interactive {{segmentTracks.tabs.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="tabs" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist">
      <view class="liquid-view segment-lens" style="transform:translate3d({{segmentTracks.tabs ? segmentTracks.tabs.x + 'px' : (tab === 'progress' ? 0 : tab === 'materials' ? 100 : tab === 'history' ? 200 : 300) + '%'}},0,0) scale({{segmentTracks.tabs ? segmentTracks.tabs.scaleX : 1}},{{segmentTracks.tabs ? segmentTracks.tabs.scaleY : 1}})" aria-hidden="true"/>
      <button size="mini" class="native-button liquid-button segment-option {{tab === 'progress' ? 'active' : ''}} {{segmentTracks.tabs.hover === 0 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="0" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'progress'}}"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.tabs.scales[0] || 1}})">生产进度</view></button>
      <button size="mini" class="native-button liquid-button segment-option {{tab === 'materials' ? 'active' : ''}} {{segmentTracks.tabs.hover === 1 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="1" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'materials'}}"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.tabs.scales[1] || 1}})">用料明细</view></button>
      <button size="mini" class="native-button liquid-button segment-option {{tab === 'history' ? 'active' : ''}} {{segmentTracks.tabs.hover === 2 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="2" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'history'}}"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.tabs.scales[2] || 1}})">生产履历</view></button>
      <button size="mini" class="native-button liquid-button segment-option {{tab === 'outsource' ? 'active' : ''}} {{segmentTracks.tabs.hover === 3 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="3" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'outsource'}}"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.tabs.scales[3] || 1}})">委外进度</view></button>
    </view>
    <view class="liquid-view" wx:if="{{tab === 'progress'}}">
      <view class="liquid-view process-section-heading"><text class="liquid-text">{{completeProcesses ? '完整工序' : '已知工序'}} · {{processCounts.all}} 道</text><button size="mini" wx:if="{{canDispatch && sourceMode !== 'ui-fixture'}}" class="native-button liquid-button route-edit-entry" bindtap="openProcessManagement">管理工序</button><text class="liquid-text" wx:elif="{{!employeeView}}">左滑工序查看详情</text></view>
      <view mark:backIgnore="{{true}}" wx:if="{{!employeeView}}" id="segment-processes" class="liquid-view process-filters glass-segments segment-interactive segment-three segment-fast {{segmentTracks.processes.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="processes" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel">
        <view class="liquid-view segment-lens" style="transform:translate3d({{segmentTracks.processes ? segmentTracks.processes.x + 'px' : (processFilter === 'all' ? 0 : processFilter === 'paused' ? 100 : 200) + '%'}},0,0) scale({{segmentTracks.processes ? segmentTracks.processes.scaleX : 1}},{{segmentTracks.processes ? segmentTracks.processes.scaleY : 1}})" aria-hidden="true"/>
        <button size="mini" class="native-button liquid-button segment-option {{processFilter === 'all' ? 'active' : ''}} {{segmentTracks.processes.hover === 0 ? 'segment-hover' : ''}}" data-segment="processes" data-index="0" aria-pressed="{{processFilter === 'all'}}" bindtap="onGlassSegmentTap" hover-class="none"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.processes.scales[0] || 1}})">全部 {{processCounts.all}}</view></button>
        <button size="mini" class="native-button liquid-button {{!executionLoaded ? 'liquid-disabled' : ''}} segment-option {{processFilter === 'paused' ? 'active' : ''}} {{segmentTracks.processes.hover === 1 ? 'segment-hover' : ''}}" data-segment="processes" data-index="1" aria-pressed="{{processFilter === 'paused'}}" bindtap="onGlassSegmentTap" hover-class="none" disabled="{{!executionLoaded}}"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.processes.scales[1] || 1}})">已暂停 {{processCounts.paused}}</view></button>
        <button size="mini" class="native-button liquid-button {{!executionLoaded ? 'liquid-disabled' : ''}} segment-option {{processFilter === 'running' ? 'active' : ''}} {{segmentTracks.processes.hover === 2 ? 'segment-hover' : ''}}" data-segment="processes" data-index="2" aria-pressed="{{processFilter === 'running'}}" bindtap="onGlassSegmentTap" hover-class="none" disabled="{{!executionLoaded}}"><view class="liquid-view segment-label" style="transform:scale({{segmentTracks.processes.scales[2] || 1}})">进行中 {{processCounts.running}}</view></button>
      </view>
      <view id="process-results" class="liquid-view process-results" style="min-height:{{processResultsMinHeight}}px">
      <view class="liquid-view execution-read-state" wx:if="{{!employeeView && executionError}}"><text class="liquid-text">{{executionError}}</text><button size="mini" class="native-button liquid-button {{executionLoading ? 'liquid-disabled' : ''}}" bindtap="loadExecution" disabled="{{executionLoading}}">刷新人员任务</button></view>
      <text class="liquid-text execution-source" wx:if="{{!employeeView && sourceMode === 'ui-fixture'}}">本地演示 · 派遣和报工不写入黑湖</text>
      <view class="liquid-view process-read-error" wx:if="{{processError}}"><text class="liquid-text">{{processError}}</text><button size="mini" class="native-button liquid-button" bindtap="loadProcesses">重试读取工序</button></view>
      <view class="liquid-view process-loading" wx:if="{{processLoading}}">正在读取工序进度…</view>
      <view mark:backIgnore="{{true}}" class="liquid-view process-swipe" wx:for="{{visibleProcesses}}" wx:key="id" data-id="{{item.id}}" bindtouchstart="onProcessSwipeStart" bindtouchmove="onProcessSwipeMove" bindtouchend="onProcessSwipeEnd" bindtouchcancel="onProcessSwipeCancel">
        <view wx:if="{{!employeeView}}" class="liquid-view process-swipe-action {{swipeProcessId === item.id + '' && processSwipeOffset < 0 ? 'revealed' : ''}}" aria-hidden="{{swipeProcessId !== item.id + '' || processSwipeOffset >= 0}}"><button size="mini" class="native-button liquid-button" data-id="{{item.id}}" catchtap="openProcessDetail" disabled="{{swipeProcessId !== item.id + '' || processSwipeOffset >= 0}}" aria-label="查看{{item.name}}详情">详情</button></view>
        <view class="liquid-view detail-process-card process-swipe-front {{selectedProcessId === item.id ? 'selected' : ''}} {{item.closed ? 'closed' : ''}} {{processSwipeDragging && swipeProcessId === item.id + '' ? 'is-dragging' : ''}}" style="transform:translate3d({{swipeProcessId === item.id + '' ? processSwipeOffset : 0}}px,0,0)" data-id="{{item.id}}" catchtap="onProcessRowTap" bindlongpress="revealProcessActions" aria-role="{{canDispatch && item.selectable ? 'radio' : 'button'}}" aria-checked="{{selectedProcessId === item.id}}" aria-label="{{item.orderLabel}} {{item.name}}，{{item.closed ? '已关闭，仅查看' : item.percent + '，' + item.statusText}}">
          <view class="liquid-view process-selection-glass {{selectedProcessId === item.id ? 'is-selected' : ''}}" aria-hidden="true"/>
          <view class="liquid-view detail-process-main"><text class="liquid-text process-number">{{item.orderLabel}}</text><view class="liquid-view process-copy"><text class="liquid-text process-title">{{item.name}}</text><text class="liquid-text process-state">{{selectedProcessId === item.id && !employeeView ? '已选中 · ' : ''}}{{item.statusText}}</text></view></view>
          <view class="liquid-view employee-process-amounts"><view class="liquid-view"><text class="liquid-text">计划数</text><text class="liquid-text">{{item.planText}}</text></view><view class="liquid-view"><text class="liquid-text">良品数</text><text class="liquid-text">{{item.goodText}}</text></view><view class="liquid-view employee-defective"><text class="liquid-text">不良数</text><text class="liquid-text">{{item.defectiveText}}</text></view><view class="liquid-view process-ring {{item.closed ? 'ring-closed' : ''}}"><image class="liquid-image" wx:if="{{item.closed}}" src="/workspace/assets/step-check.png"/><text class="liquid-text" wx:else>{{item.percent}}</text></view></view>
          <button size="mini" wx:if="{{!employeeView}}" class="native-button liquid-button swipe-access" data-id="{{item.id}}" catchtap="revealProcessActions" aria-label="显示{{item.name}}的详情操作">详情操作</button>
        </view>
      </view>
      <text class="liquid-text detail-empty" wx:if="{{!visibleProcesses.length && !processLoading && !processError}}">{{processFilter === 'all' ? '暂无工序资料' : '当前分类暂无工序'}}</text>
      <view class="liquid-view detail-footnote"><text class="liquid-text">达到计划数不代表工序已关闭。各工序数量不能相加作为成品产量。</text><text class="liquid-text" wx:if="{{processTime}}">工序资料更新于 {{processTime}}。</text><text class="liquid-text" wx:if="{{!completeProcesses}}">当前只含已知工序，未确认完整流程。</text></view>
      </view>
    </view>
    <view class="liquid-view section-body" wx:else>
      <view class="liquid-view section-heading"><text class="liquid-text">{{tab === 'materials' ? '用料明细' : tab === 'history' ? '生产履历' : '委外进度'}}{{activeSection.loaded && activeSection.available !== false ? ' · ' + activeSection.items.length + (tab === 'materials' ? ' 项' : ' 条') : ''}}<text class="liquid-text section-demo" wx:if="{{activeSection.demo}}">样本</text></text><button size="mini" class="native-button liquid-button {{activeSection.loading ? 'liquid-disabled' : ''}}" bindtap="loadSection" disabled="{{activeSection.loading}}">刷新</button></view>
      <view class="liquid-view process-read-error" wx:if="{{activeSection.error}}"><text class="liquid-text">{{activeSection.error}}</text><text class="liquid-text" wx:if="{{activeSection.stale}}">以下保留上次读取的明细。</text><button size="mini" class="native-button liquid-button" bindtap="loadSection">重新读取</button></view>
      <text class="liquid-text process-loading" wx:if="{{activeSection.loading && !activeSection.items.length}}">正在读取{{tab === 'materials' ? '用料明细' : tab === 'history' ? '生产履历' : '委外进度'}}…</text>
      <text class="liquid-text detail-footnote" wx:if="{{activeSection.loading && activeSection.items.length}}">正在更新，以下保留上次读取的明细。</text>
      <view class="liquid-view" wx:if="{{tab === 'materials'}}">
        <view class="liquid-view section-card material-card" wx:for="{{activeSection.items}}" wx:key="id">
          <view class="liquid-view section-card-top"><text class="liquid-text section-index">{{item.indexLabel}}</text><text class="liquid-text section-title">{{item.title}}<text class="liquid-text material-spec"> | {{item.specText}}</text></text><view class="liquid-view material-quantity"><text class="liquid-text">{{item.unissuedText}}</text><text class="liquid-text">未领料</text></view></view>
          <view class="liquid-view material-fields">
            <view class="liquid-view material-row"><text class="liquid-text">产品信息</text><text class="liquid-text material-product">{{item.codeText}}{{item.name ? ' | ' + item.name : ''}}</text></view>
            <view class="liquid-view material-row"><text class="liquid-text">供应商</text><text class="liquid-text">{{item.supplierText}}</text></view>
            <view class="liquid-view material-row"><text class="liquid-text">库存数量</text><text class="liquid-text">{{item.inventoryText}}</text></view>
            <view class="liquid-view material-row"><text class="liquid-text">需求数量</text><text class="liquid-text">{{item.requiredText}}</text></view>
            <view class="liquid-view material-row"><text class="liquid-text">单位用量</text><text class="liquid-text">{{item.unitText}}</text></view>
            <view class="liquid-view material-row"><text class="liquid-text">图片</text><button size="mini" id="material-image-{{item.id}}" class="native-button liquid-button material-image" wx:if="{{item.imageUrl && !item.imageFailed}}" data-id="{{item.id}}" bindtap="previewMaterial" aria-label="查看{{item.title}}图片"><image class="liquid-image" src="{{item.imageUrl}}" mode="aspectFit" data-id="{{item.id}}" binderror="materialImageError"/></button><text class="liquid-text" wx:else>{{item.imageFailed ? '图片加载失败' : '—'}}</text></view>
          </view>
        </view>
      </view>
      <view class="liquid-view history-list" wx:elif="{{tab === 'history'}}">
        <view class="liquid-view history-entry" wx:for="{{activeSection.items}}" wx:key="id"><view class="liquid-view history-dot"/><view class="liquid-view section-card history-card"><text class="liquid-text history-time">{{item.occurredText}}</text><text class="liquid-text section-title">{{item.title}}</text><view class="liquid-view history-person"><text class="liquid-text">{{item.operatorText}}</text><text class="liquid-text" wx:if="{{item.process}}"> · {{item.processText}}</text></view><text class="liquid-text history-description" wx:if="{{item.description}}">{{item.descriptionText}}</text><view class="liquid-view history-amounts" wx:if="{{item.goodQuantity !== null && item.goodQuantity !== undefined || item.defectiveQuantity !== null && item.defectiveQuantity !== undefined}}"><text class="liquid-text">合格 {{item.goodText}}</text><text class="liquid-text">不良 {{item.defectiveText}}</text></view></view></view>
      </view>
      <view class="liquid-view" wx:else>
        <view class="liquid-view section-card outsource-card" wx:for="{{activeSection.items}}" wx:key="id"><view class="liquid-view section-card-top"><text class="liquid-text section-index">{{item.indexLabel}}</text><text class="liquid-text section-title">{{item.title}}</text><text class="liquid-text outsource-status">{{item.stateText}}</text></view><view class="liquid-view material-fields"><view class="liquid-view material-row"><text class="liquid-text">委外单号</text><text class="liquid-text">{{item.codeText}}</text></view><view class="liquid-view material-row"><text class="liquid-text">供应商</text><text class="liquid-text">{{item.supplierText}}</text></view><view class="liquid-view material-row"><text class="liquid-text">计划完成</text><text class="liquid-text">{{item.endText}}</text></view></view><view class="liquid-view outsource-amounts"><view class="liquid-view"><text class="liquid-text">{{item.plannedText}}</text><text class="liquid-text">计划数</text></view><view class="liquid-view"><text class="liquid-text">{{item.deliveredText}}</text><text class="liquid-text">已发出</text></view><view class="liquid-view"><text class="liquid-text">{{item.receivedText}}</text><text class="liquid-text">已收回</text></view></view></view>
      </view>
      <text class="liquid-text detail-empty" wx:if="{{activeSection.loaded && !activeSection.loading && !activeSection.error && !activeSection.items.length}}">{{activeSection.available === false ? activeSection.scopeNote : (tab === 'materials' ? '当前工单暂无用料明细' : tab === 'history' ? '当前工单暂无生产履历' : '当前工单暂无委外记录')}}</text>
      <button size="mini" class="native-button liquid-button {{activeSection.loading ? 'liquid-disabled' : ''}} section-load-more" wx:if="{{activeSection.hasMore}}" bindtap="loadSection" data-more="{{true}}" disabled="{{activeSection.loading}}">{{activeSection.loading ? '正在读取…' : '加载更多'}}</button>
      <view class="liquid-view detail-footnote" wx:if="{{(activeSection.loaded || activeSection.stale) && activeSection.available !== false}}"><text class="liquid-text">{{activeSection.sourceLabel}}{{activeSection.updatedLabel ? ' · 查询于 ' + activeSection.updatedLabel : ''}}</text><text class="liquid-text" wx:if="{{activeSection.scopeNote && activeSection.available !== false}}">{{activeSection.scopeNote}}</text><text class="liquid-text" wx:if="{{activeSection.hasMore}}">当前仅展示已加载记录。</text></view>
    </view>
    <view class="liquid-view detail-bottom-space"/>
  </scroll-view>
  <view class="liquid-view detail-initial" wx:else><text class="liquid-text">{{loadError || '正在读取工单详情…'}}</text><button size="mini" class="native-button liquid-button" wx:if="{{loadError && hasContext}}" bindtap="refreshDetail">重新读取</button><button size="mini" class="native-button liquid-button" bindtap="returnToOrders">收起详情</button></view>
  <view class="liquid-view detail-dock" wx:if="{{ready}}"><text class="liquid-text dock-caption">{{canDispatch ? (selectedProcessName ? '已选工序 · ' + selectedProcessName : '可先选工序，再选择派工人员') : '当前工单 · 只读查看'}}</text><button size="mini" wx:if="{{canDispatch}}" class="native-button liquid-button {{!dispatchEnabled ? 'liquid-disabled' : ''}} detail-primary" bindtap="openDispatch" disabled="{{!dispatchEnabled}}">{{loading || processLoading ? '正在读取…' : (order.status === 'FINISHED' ? '工单已结束' : (dispatchEnabled ? (selectedProcessId ? '按所选工序派工' : '选择人员派工') : '暂无可派工序'))}}</button><button size="mini" wx:else class="native-button liquid-button detail-primary" bindtap="returnToOrders">收起详情</button></view>
  <view wx:if="{{routePanel}}" class="liquid-view process-detail-mask is-open" catchtap="closeProcessManagement" catchtouchmove="stopProcessBubble"/>
  <view wx:if="{{routePanel}}" class="liquid-view process-detail-sheet route-edit-sheet is-open" aria-role="dialog" aria-modal="true" aria-label="管理工序" catchtap="stopProcessBubble">
    <view class="liquid-view route-edit-heading">
      <view class="liquid-view"><text class="liquid-text route-edit-title">{{routeDraft ? (routeDraft.id ? '编辑工序' : '新增工序') : '管理工序'}}</text><text class="liquid-text route-edit-subtitle">{{routeSku ? 'SKU ' + routeSku : order.code}}</text></view>
      <button size="mini" class="native-button liquid-button route-edit-close" bindtap="closeProcessManagement" disabled="{{routeBusy}}" aria-label="{{routeDraft ? '返回工序管理' : '关闭工序管理'}}">{{routeDraft ? '返回' : '×'}}</button>
    </view>
    <block wx:if="{{routeDraft}}">
      <view class="liquid-view route-edit-form">
        <text class="liquid-text route-edit-subtitle" wx:if="{{!routeDraft.id}}">计划数随工单 · {{routePlan}} 件</text>
        <view class="liquid-view route-edit-quantity" wx:else><text class="liquid-text">计划数</text><input value="{{routeDraft.planQuantity}}" type="number" bindinput="onProcessEditQuantity" disabled="{{routeBusy}}" aria-label="工序计划数"/></view>
        <input class="route-edit-search" value="{{routeCatalogQuery}}" bindinput="onProcessCatalogSearch" placeholder="搜索黑湖工序名称或编码" disabled="{{routeBusy}}" aria-label="搜索黑湖工序"/>
        <text class="liquid-text route-edit-subtitle" wx:if="{{routeDraft.definition}}">已选 {{routeDraft.definition.name}}</text>
        <text class="liquid-text route-edit-subtitle" wx:elif="{{routeDraft.id}}">当前工序 {{routeDraft.name}}</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" scroll-y="{{true}}" class="route-edit-scroll">
        <text class="liquid-text route-edit-message" wx:if="{{routeCatalogLoading}}">正在读取黑湖工序目录…</text>
        <button wx:for="{{routeCatalogRows}}" wx:key="id" size="mini" class="native-button liquid-button route-edit-choice {{routeDraft.definition.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectProcessDefinition" aria-pressed="{{routeDraft.definition.id === item.id}}" disabled="{{routeBusy}}"><text>{{item.name}}</text><text>{{item.code}}</text></button>
        <text class="liquid-text route-edit-message" wx:if="{{routeCatalogMore}}">可输入名称或编码缩小结果范围</text>
        <text class="liquid-text route-edit-message" wx:if="{{!routeCatalogLoading && !routeCatalogRows.length && !routeError}}">暂无匹配工序</text>
