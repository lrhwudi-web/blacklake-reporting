        <button size="mini" class="native-button liquid-button route-edit-primary" wx:elif="{{!routeBlocked && !routeLoading}}" bindtap="openProcessEdit" disabled="{{routeBusy}}">新增工序</button>
      </view>
    </block>
  </view>
