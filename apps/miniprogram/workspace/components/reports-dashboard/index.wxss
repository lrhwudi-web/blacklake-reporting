.rd-editor-motion.rd-editor-motion.rd-editor-closing .report-mask.report-mask{animation:rd-report-mask-out 220ms ease forwards}
.rd-reduced.rd-reduced .report-editor-panel.report-editor-panel{animation:rd-report-mask-in 120ms ease backwards}
@keyframes rd-report-expand{from{transform:var(--rd-editor-origin);border-radius:var(--rd-editor-radius);opacity:.45}to{transform:none;opacity:1}}
@keyframes rd-report-collapse{from{transform:none;opacity:1}to{transform:var(--rd-editor-origin);border-radius:var(--rd-editor-radius);opacity:0}}
@keyframes rd-report-mask-in{from{opacity:0}to{opacity:1}}
@keyframes rd-report-mask-out{from{opacity:1}to{opacity:0}}
@media(max-width:350px){
 .rd-top.rd-top{padding:15px 12px 10px}
 .rd-main.rd-main{padding:0 12px}
 .rd-top.rd-top .rd-tabs.rd-tabs{height:43px;min-height:43px}
 .rd-filters.rd-filters button{padding:0 10px}
 .rd-tile{min-height:80px;padding:9px 10px}
 .rd-tile-value{font-size:20px}
 .rd-tile-note{font-size:10px}
}

.rd-picker.rd-picker.rd-filter-sheet{padding:14px 14px calc(14px + env(safe-area-inset-bottom)/2);border-radius:21px;max-height:87%;background:#f4f9fc;box-shadow:0 14px 50px #172c4940;animation:rd-filter-enter 200ms cubic-bezier(.32,.72,0,1)}
.rd-filter-heading{display:flex;align-items:center;justify-content:space-between;flex:none;margin-bottom:10px;color:#203651;font-size:20px;font-weight:750}
.rd-filter-close.rd-filter-close{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:#e6eef9;color:#627b98;font-size:23px;font-weight:400}
.rd-employee-search{flex:none;width:100%;height:38px;padding:0 9px;margin-bottom:7px;border:1px solid #d8e4f6;border-radius:9px;box-sizing:border-box;background:white;color:#263b54;font-size:14px}
.rd-employee-list,.rd-date-list{min-height:0;box-sizing:border-box}
.rd-batch-list{min-height:0;max-height:45vh}
.rd-filter-option.rd-filter-option{display:flex;align-items:center;gap:9px;width:100%;height:38px;margin:0 0 4px;padding:0 9px;box-sizing:border-box;border-radius:9px;background:white;text-align:left;color:#243b58;white-space:nowrap;font-size:14px}
.rd-filter-option.rd-filter-option:last-child{margin-bottom:0}
.rd-choice-box,.rd-choice-radio{display:flex;align-items:center;justify-content:center;width:16px;height:16px;box-sizing:border-box;border:1px solid #b6c8e2;background:white;flex:none}
.rd-choice-box{border-radius:2px}
.rd-choice-radio{border-radius:50%}
.rd-choice-box.rd-choice-checked{background:#2457bf;border-color:#2457bf}
.rd-choice-box image{width:13px;height:13px}
.rd-choice-radio.rd-choice-current{border:5px solid #2457bf}
.rd-option-title{min-width:0;overflow:hidden;text-overflow:ellipsis;flex:1}
.rd-option-caption{max-width:45%;min-width:0;overflow:hidden;text-overflow:ellipsis;color:#617c9c;font-size:12px}
.rd-employee-empty{display:block;padding:10px 4px;color:#627b98;font-size:13px}
.rd-filter-footer{display:flex;flex:none;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;padding-top:7px;border-top:1px solid #d9e4f6}
.rd-filter-all.rd-filter-all{min-height:38px;color:#2457bf;padding:0 6px;font-size:14px}
.rd-filter-apply.rd-filter-apply{margin-left:auto;min-width:88px;height:38px;line-height:38px;border-radius:10px;color:white;background:#2859bd;font-size:14px;font-weight:750}
.rd-batch-more.rd-batch-more{align-self:center}
.rd-batch-apply.rd-batch-apply{padding:0 10px;white-space:nowrap}
.rd-filter-dates{display:flex;gap:8px;margin-top:7px}
.rd-filter-dates picker{flex:1;min-width:0;padding:6px 9px;border:1px solid #d8e4f6;border-radius:9px;background:white}
.rd-filter-dates text{display:block;color:#536e91;font-size:11px}
.rd-filter-dates text+text{color:#243b58;font-size:14px}
.rd-filter-error{display:block;margin-top:5px;color:#a13642;font-size:12px}
@keyframes rd-filter-enter{from{transform:translateY(12px) scale(.975);opacity:0}to{transform:none;opacity:1}}
.rd-reduced.rd-reduced .rd-filter-sheet.rd-filter-sheet{animation:rd-report-mask-in 100ms ease}
