.rd-approval-switch.rd-approval-switch{width:56px;height:32px;min-height:32px;border-radius:22px;background:#e3edf8;border:1px solid #c8d8ee;padding:3px;box-sizing:border-box;display:flex;align-items:center;justify-content:flex-start;flex:none;transition:background-color 200ms ease,border-color 200ms ease}
