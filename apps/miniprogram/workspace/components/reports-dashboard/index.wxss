.report-dashboard.report-dashboard{display:flex;flex-direction:column;overflow:hidden}
.rd-top.rd-top{flex:none;padding:22px 17px 12px}
.rd-top.rd-top .rd-header.rd-header{margin-bottom:13px}
.rd-top.rd-top .rd-tabs.rd-tabs{margin-bottom:0}
.rd-main.rd-main{flex:1;height:0;min-height:0;padding:0 17px;box-sizing:border-box}
.rd-bottom-space{height:calc(96px + env(safe-area-inset-bottom))}
.rd-filters.rd-filters{gap:0;margin-bottom:12px;padding:4px 0;border:1px solid #fff;border-radius:18px;background:rgba(255,255,255,.78);box-sizing:border-box}
.rd-filters.rd-filters button{min-height:42px;height:auto;justify-content:flex-start;border:0;border-radius:0;background:transparent;padding:0 14px;text-align:left;gap:7px}
.rd-filters.rd-filters button+button{border-left:1px solid #dbe6f8}
.rd-filters.rd-filters button>text:first-child{flex:none;font-size:11px;color:#657e9e}
.rd-filters.rd-filters button>text:nth-child(2){flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#132641;font-weight:650}
.rd-filters.rd-filters image{flex:none}
.rd-summary-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-bottom:13px}
.rd-tile{min-width:0;min-height:88px;padding:10px 12px;box-sizing:border-box;border:1px solid white;border-radius:18px;line-height:1.32}
.rd-tile-good{background:#e2f3ed;color:#206b59}
.rd-tile-approval{background:#e5edfc;color:#2357b9}
.rd-tile-output{background:#fff1dc;color:#865317}
.rd-tile-defect{background:#fbe9e8;color:#a13642}
.rd-tile-label,.rd-tile-note{display:block;font-size:11px}
.rd-tile-label{font-size:12px;font-weight:650}
.rd-tile-value{display:block;font-size:24px;line-height:1.14;font-variant-numeric:tabular-nums;font-weight:750;margin:5px 0 3px;overflow-wrap:anywhere}
.rd-tile-value>text{font-size:15px;font-weight:600;padding-left:3px}
.rd-approval-toolbar{
 display:flex;align-items:center;justify-content:space-between;gap:5px;min-height:48px;
 margin:0 0 11px;padding:3px 5px;box-sizing:border-box;border:1px solid #fff;border-radius:18px;background:rgba(249,252,255,.83)
}
.rd-approval-filters.rd-approval-filters{
 position:relative;display:flex;align-items:center;flex:none;width:160px;padding:3px;box-sizing:border-box;border:1px solid #fff;
 border-radius:18px;background:#f2f7fc;box-shadow:0 1px 3px #28558d12
}
