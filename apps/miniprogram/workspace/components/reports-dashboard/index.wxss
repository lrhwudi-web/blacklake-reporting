.rd-approval-unknown.rd-approval-unknown.selected{color:#2458bf;background:#e7f0fd;border-radius:8px}
.rd-reduced .rd-approval-slider{transition:opacity 100ms ease}
@media(max-width:350px){
 .rd-approval-filters.rd-approval-filters{width:151px}
 .rd-approval-tools.rd-approval-tools button{padding:0 6px}
}
