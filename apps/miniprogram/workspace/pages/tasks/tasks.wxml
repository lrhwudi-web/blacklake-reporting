<import src="../../templates/image-viewer.wxml"/>
<view class="layer-back-surface" capture-bind:touchstart="onLayerBackTouchStart" capture-bind:touchmove="onLayerBackTouchMove" capture-bind:touchend="onLayerBackTouchEnd" capture-bind:touchcancel="onLayerBackTouchCancel">

<view class="orders-page glass-theme tasks-page tasks-minimal">
  <view class="task-header" aria-hidden="{{!!reportPanel || !!assignmentPanel || !!productPanel || !!taskChooser}}">
    <view class="task-toolbar">
      <block wx:if="{{!searchOpen}}"><text class="task-title">任务</text><view class="task-tools"><button size="mini" class="native-button" bindtap="toggleTaskSearch" aria-label="搜索任务"><image src="/workspace/assets/people-search.png"/></button></view></block>
      <view class="search-row" wx:else><input mark:backIgnore="{{true}}" class="search-input" value="{{keyword}}" bindinput="onTaskSearch" focus="{{searchOpen}}" placeholder="工单、产品、人员、工序" aria-label="搜索工单、产品、人员、工序"/><button size="mini" class="native-button" bindtap="toggleTaskSearch" aria-label="取消任务搜索">取消</button></view>
    </view>
    <view mark:backIgnore="{{true}}" id="segment-taskTabs" class="task-tabs glass-segments segment-two segment-interactive {{segmentTracks.taskTabs.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="taskTabs" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist" aria-label="任务记录分类">
      <view class="segment-lens" style="transform:translate3d({{segmentTracks.taskTabs ? segmentTracks.taskTabs.x + 'px' : taskTab === 'assignments' ? '0%' : '100%'}},0,0) scale({{segmentTracks.taskTabs ? segmentTracks.taskTabs.scaleX : 1}},{{segmentTracks.taskTabs ? segmentTracks.taskTabs.scaleY : 1}})" aria-hidden="true"/>
      <button size="mini" class="native-button segment-option {{taskTab === 'assignments' ? 'active' : ''}} {{segmentTracks.taskTabs.hover === 0 ? 'segment-hover' : ''}}" data-segment="taskTabs" data-index="0" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{taskTab === 'assignments'}}"><view class="segment-label" style="transform:scale({{segmentTracks.taskTabs.scales[0] || 1}})">派工记录</view></button>
      <button size="mini" class="native-button segment-option {{taskTab === 'reports' ? 'active' : ''}} {{segmentTracks.taskTabs.hover === 1 ? 'segment-hover' : ''}}" data-segment="taskTabs" data-index="1" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{taskTab === 'reports'}}"><view class="segment-label" style="transform:scale({{segmentTracks.taskTabs.scales[1] || 1}})">报工记录</view></button>
    </view>
  </view>
  <view class="task-overview-controls" wx:if="{{!taskDrill}}" aria-hidden="{{!!taskChooser}}"><button size="mini" class="native-button task-history-entry {{assignmentHistory ? 'is-history' : ''}}" wx:if="{{taskTab === 'assignments'}}" bindtap="openTaskHistory" aria-label="{{assignmentHistory ? '返回当前排工' : '按时间查看排工历史'}}"><view class="task-history-clock"><view class="task-history-hour"/><view class="task-history-minute"/></view><text>{{assignmentHistory ? '当前' : '历史'}}</text></button><button size="mini" class="native-button task-overview-filter" data-kind="filter" bindtap="openTaskChooser" aria-label="{{taskTab === 'assignments' ? '筛选派工状态' : '选择报工日期和记录状态'}}"><text>{{overviewFilterLabel}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button><button size="mini" class="native-button task-overview-group" data-kind="group" bindtap="openTaskChooser" aria-label="选择分组方式"><text>{{overviewGroupLabel}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <view class="task-drill-controls" wx:else><button size="mini" class="native-button task-drill-back" bindtap="closeTaskGroup" aria-label="返回人员和记录分组"><image src="/workspace/assets/ui-chevron-down.png"/><text>{{taskDrill.label}}</text></button><text>{{taskTab === 'assignments' ? (assignmentHistory ? '历史 ' : '未完成 ') : ''}}{{drillCount}} {{taskTab === 'assignments' ? '项' : '条报工'}}</text><button size="mini" class="native-button task-history-entry {{assignmentHistory ? 'is-history' : ''}}" wx:if="{{taskTab === 'assignments'}}" bindtap="openTaskHistory" aria-label="{{assignmentHistory ? '返回当前排工' : '按时间查看排工历史'}}"><view class="task-history-clock"><view class="task-history-hour"/><view class="task-history-minute"/></view><text>{{assignmentHistory ? '当前' : '历史'}}</text></button><button size="mini" class="native-button task-drill-filter" data-kind="filter" bindtap="openTaskChooser">筛选</button></view>
  <view class="task-error" wx:if="{{executionError}}" aria-role="alert"><text>{{executionError}}</text><button size="mini" class="native-button" bindtap="refreshTasks" disabled="{{executionLoading || actionBusy}}">重试</button></view>
  <scroll-view enhanced="{{true}}" class="task-scroll" scroll-y="{{!reportPanel && !assignmentPanel && !assignmentMenu && !productPanel && !taskChooser}}" aria-hidden="{{!!reportPanel || !!assignmentPanel || !!assignmentMenu || !!productPanel || !!taskChooser}}" show-scrollbar="{{false}}">
    <text class="task-loading" wx:if="{{executionLoading}}">正在读取…</text>
    <block wx:if="{{!taskDrill}}"><view class="task-overview-list" wx:if="{{overviewGroups.length}}"><button size="mini" class="native-button task-summary-row {{index ? 'has-divider' : ''}}" wx:for="{{overviewGroups}}" wx:key="key" data-key="{{item.key}}" bindtap="openTaskGroup" aria-label="查看{{item.label}}的{{item.count}}{{taskTab === 'assignments' ? '项派工' : '条报工'}}"><view class="task-summary-copy"><text class="task-summary-title">{{item.label}}</text><view class="task-summary-subtitle"><text class="task-summary-preview">{{item.preview}}</text><text wx:if="{{item.state}}"> · </text><text class="task-summary-state state-{{item.stateCode}}" wx:if="{{item.state}}">{{item.state}}</text></view></view><text class="task-summary-count" wx:if="{{taskTab === 'assignments'}}">{{item.count}} 项</text><image class="task-summary-chevron" src="/workspace/assets/ui-chevron-down.png"/></button></view><text class="task-empty" wx:if="{{loaded && !overviewGroups.length && !executionLoading}}">{{taskTab === 'assignments' ? '暂无匹配派工' : '暂无匹配报工'}}</text></block>
    <block wx:else>
    <block wx:if="{{taskTab === 'assignments'}}">
      <view class="task-assignment-list {{inlineSorting ? 'is-inline-sorting' : ''}}" wx:if="{{displayTasks.length}}" style="{{inlineSorting ? 'height:' + inlineListHeight + 'px' : ''}}">
      <view class="task-card task-assignment-row {{item.inlineHandle ? 'has-inline-handle' : ''}} {{item.inlinePreviewCurrent ? 'is-employee-current' : ''}} {{inlineSorting ? 'is-inline-positioned' : ''}} {{item.inlineHeld ? 'is-inline-held' : ''}} {{reduceMotion ? 'inline-reduced' : ''}}" id="assignment-card-{{index}}" wx:for="{{displayTasks}}" wx:key="id" style="{{inlineSorting ? 'height:' + item.inlineHeight + 'px;transform:translate3d(0,' + item.inlineY + 'px,0) scale(' + (item.inlineHeld && !reduceMotion ? '1.015' : '1') + ')' : ''}}">
        <button size="mini" mark:backIgnore="{{true}}" class="native-button task-card-grip" wx:if="{{item.inlineHandle}}" data-id="{{item.id}}" bindtouchstart="onInlineSortStart" catchtouchmove="onInlineSortMove" bindtouchend="onInlineSortEnd" bindtouchcancel="onInlineSortCancel" catchtap="stopQueueTap" disabled="{{!item.inlineDraggable || (actionBusy && !inlineSorting)}}" aria-label="拖动调整{{item.processName}}顺序"><image src="/workspace/assets/ui-grip-vertical.png"/></button>
        <button size="mini" class="native-button task-record-main" data-id="{{item.id}}" data-record="true" bindtap="openTaskProduct" bindlongpress="openTaskQueue" disabled="{{actionBusy}}" aria-label="查看{{item.workerName}}的{{item.processName}}派工详情，工单{{item.orderCode || '编号未提供'}}" aria-expanded="{{productPanel.assignmentId === '' + item.id && productPanelOpen}}">
          <view class="task-record-title"><text>{{item.processName}}</text><text class="task-current-badge" wx:if="{{item.inlinePreviewCurrent}}">员工当前</text><text class="task-urgent" wx:elif="{{item.priority === 'URGENT'}}">加急</text></view>
          <view class="task-record-meta"><text>{{item.assignedShort}} 派工</text><text wx:if="{{taskDrill.mode !== 'person'}}">{{item.workerName}}</text><text>· 已生产 {{item.elapsedShortText}}{{item.timerPaused ? ' · 计时已暂停' : ''}}</text></view>
          <text class="task-record-order">工单编号 {{item.orderCode || '未提供'}}</text>
        </button>
        <text class="task-record-status state-{{item.timerPaused ? 'PAUSED' : item.status}}">{{item.statusText}}</text>
        <button size="mini" wx:if="{{canManageExecution && (item.canEditAssignment || item.canCancelAssignment)}}" id="assignment-more-{{index}}" class="native-button task-assignment-more {{assignmentMenu.assignmentId === item.id && assignmentMenuOpen ? 'is-active' : ''}}" data-id="{{item.id}}" data-anchor="assignment-more-{{index}}" bindtap="showAssignmentActions" disabled="{{actionBusy}}" aria-label="{{item.workerName}}派工更多操作" aria-expanded="{{assignmentMenu.assignmentId === item.id && assignmentMenuOpen}}"><image src="/workspace/assets/ui-dots-vertical.png"/></button>
      </view>
      </view>
      <text class="task-empty" wx:if="{{loaded && !displayTasks.length && !executionLoading}}">暂无匹配派工</text>
    </block>
    <block wx:else>
      <view class="task-report-context" wx:if="{{sourceLabel || reportScope}}"><view><text>{{sourceLabel}}</text><text class="task-context-separator" wx:if="{{sourceLabel && scopeLabel}}"> · </text><text class="task-context-scope" wx:if="{{scopeLabel}}">{{scopeLabel}}</text></view><button size="mini" class="native-button" wx:if="{{reportScope}}" bindtap="clearReportScope">全部记录</button></view>
      <view class="task-report-card record-compact {{item.deleted ? 'is-deleted' : ''}}" wx:for="{{displayReports}}" wx:key="id">
        <view class="record-head"><button size="mini" class="native-button record-person record-person-button record-order-title" data-id="{{item.assignmentId}}" bindtap="openTaskProduct" aria-label="查看工单{{item.orderCode || '编号未提供'}}的报工详情">{{item.orderCode || '工单编号未提供'}}</button><text class="record-sync {{item.recordSyncWarning ? 'record-sync-warning' : ''}}" wx:if="{{item.recordSyncText}}">{{item.recordSyncText}}</text><text class="record-stamp">{{item.recordTimeText}}</text></view>
        <view class="record-bottom"><view class="record-metrics"><view class="record-stat"><text class="record-label">良品数</text><text class="record-value">{{item.recordGoodText}}</text></view><view class="record-stat"><text class="record-label">不良数</text><text class="record-value record-bad">{{item.recordBadText}}</text></view><view class="record-stat"><text class="record-label">时长</text><text class="record-value record-duration">{{item.recordDurationText}}</text></view></view><button size="mini" wx:if="{{canManageExecution && (item.canEdit || item.canDelete || item.canRestore)}}" id="{{item.anchorId}}" class="native-button record-action {{reportMenu.reportId === '' + item.id && reportMenuOpen ? 'is-active' : ''}}" data-id="{{item.id}}" data-anchor="{{item.anchorId}}" bindtap="showReportActions" aria-label="{{item.recordWorkerText}}报工更多操作" aria-expanded="{{reportMenu.reportId === '' + item.id && reportMenuOpen}}"><image class="record-action-icon" src="/workspace/assets/ui-dots-vertical.png"/></button></view>
        <text class="record-deleted" wx:if="{{item.deleted}}">已删除</text>
      </view>
      <text class="task-empty" wx:if="{{loaded && !displayReports.length && !executionLoading}}">{{showDeleted ? '暂无已删除报工' : '暂无匹配报工'}}</text>
    </block>
    </block>
    <view class="task-empty" wx:if="{{assignmentHistory && taskTab === 'assignments'}}"><text wx:if="{{historyLoading}}">正在读取历史派工…</text><button size="mini" class="native-button" wx:elif="{{historyError}}" bindtap="retryAssignmentHistory">{{historyError}} · 重试</button><button size="mini" class="native-button" wx:elif="{{historyHasMore}}" bindtap="loadMoreAssignmentHistory">加载更多历史派工</button></view>
    <view class="task-bottom-space"/>
  </scroll-view>
  <view aria-hidden="{{!!reportPanel || !!assignmentPanel}}"><include src="../../templates/glass-navigation.wxml"/></view>
  <include src="../../templates/task-report-overlays.wxml"/>
  <include src="../../templates/assignment-overlays.wxml"/>
  <include src="../../templates/task-product.wxml"/>
  <include src="../../templates/task-chooser.wxml"/>
  <template wx:if="{{imageViewer}}" is="glass-image-viewer" data="{{...imageViewer}}"/>
</view>

</view>
<view wx:if="{{backHint}}" class="layer-back-hint layer-back-hint-{{backHint.side}}" style="top:{{backHint.y}}px;opacity:{{backHint.opacity}};transform:{{backHint.transform}}" aria-hidden="true"><image src="/workspace/assets/ui-chevron-down.png"/></view>
<page-container show="{{backGuardVisible}}" overlay="{{false}}" duration="{{0}}" position="center" close-on-slide-down="{{false}}" custom-style="width:0;height:0;min-height:0;padding:0;background:transparent;overflow:hidden;" bindbeforeleave="onLayerBackBeforeLeave" bindafterleave="onLayerBackAfterLeave"/>
