<import src="../../templates/image-viewer.wxml"/>
<view class="layer-back-surface" capture-bind:touchstart="onLayerBackTouchStart" capture-bind:touchmove="onLayerBackTouchMove" capture-bind:touchend="onLayerBackTouchEnd" capture-bind:touchcancel="onLayerBackTouchCancel">

<view class="worker-page {{reduceMotion ? 'worker-reduced' : ''}}" aria-hidden="{{detailMounted}}">
  <view wx:if="{{workerTab !== 'reports'}}" class="worker-header {{workerTab === 'orders' ? 'worker-orders-header' : ''}}" aria-hidden="{{!!workerPanel || !!imageViewer}}">
    <view class="worker-order-search" wx:if="{{workerTab === 'orders' && workerOrderSearchOpen}}"><image src="/workspace/assets/people-search.png"/><input mark:backIgnore="{{true}}" value="{{workerOrderKeyword}}" bindinput="onWorkerOrderSearch" focus="{{workerOrderSearchOpen}}" placeholder="工单编号、产品信息" aria-label="搜索员工工单"/><button size="mini" class="native-button" bindtap="toggleWorkerOrderSearch" aria-label="取消工单搜索">取消</button></view>
    <block wx:elif="{{workerTab === 'orders'}}"><button size="mini" id="worker-order-scope" class="native-button worker-orders-scope" data-tool="scope" bindtap="openWorkerOrderTools" hover-class="worker-toolbar-pressed" aria-label="选择工单范围，{{workerOrderScopeLabel}}" disabled="{{busy}}"><text>{{workerOrderScopeLabel}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button><view class="worker-orders-toolbar-actions"><button size="mini" class="native-button worker-orders-icon" bindtap="toggleWorkerOrderSearch" hover-class="worker-toolbar-pressed" aria-label="搜索工单" disabled="{{busy}}"><image src="/workspace/assets/people-search.png"/></button><button size="mini" id="worker-order-sort" class="native-button worker-orders-icon {{workerOrderSort !== 'default' ? 'is-active' : ''}}" data-tool="sort" bindtap="openWorkerOrderTools" hover-class="worker-toolbar-pressed" aria-label="工单排序" disabled="{{busy}}"><image src="/workspace/assets/ui-sort-descending.png"/></button><button size="mini" id="worker-order-filter" class="native-button worker-orders-icon {{workerOrderStatus !== 'ALL' ? 'is-active' : ''}}" data-tool="filter" bindtap="openWorkerOrderTools" hover-class="worker-toolbar-pressed" aria-label="筛选工单" disabled="{{busy}}"><image src="/workspace/assets/ui-filter.png"/></button></view></block>
    <block wx:else><view><text class="worker-eyebrow">安心报工 · {{workerName}}</text><text class="worker-heading">{{workerTab === 'mine' ? '我的' : current ? (current.status === 'PAUSED' ? '组长已暂停' : current.status === 'REPORTING' || current.status === 'NEEDS_REVIEW' ? current.timerStateText : current.status === 'AWAITING_QUANTITY' ? '确认数量' : current.timerPaused ? (current.timerStateText === '组长已暂停' ? '组长已暂停' : '计时已暂停') : '生产中') : next ? '待开始' : canSelfStart ? '任务' : '等待派工'}}</text><text class="worker-sync-note" wx:if="{{workerTab === 'tasks' && activeTask.orderSyncText}}">{{activeTask.orderSyncText}}</text></view><view class="worker-header-actions"><button size="mini" class="native-button worker-refresh" bindtap="refreshCurrentView" disabled="{{loading || workerOrdersLoading || busy || !!workerPanel || !!imageViewer}}" aria-label="刷新任务"><image src="/workspace/assets/worker-refresh.png"/></button></view></block>
  </view>
  <view class="worker-order-filters" wx:if="{{workerTab === 'orders'}}" aria-hidden="{{detailMounted || !!imageViewer || !!workerPanel}}"><view mark:backIgnore="{{true}}" id="segment-workerOrders" class="glass-segments segment-interactive segment-fast {{segmentTracks.workerOrders.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="workerOrders" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist" aria-label="员工工单状态"><view class="segment-lens" style="transform:translate3d({{segmentTracks.workerOrders ? segmentTracks.workerOrders.x + 'px' : workerOrderStatus === 'ALL' ? '0%' : workerOrderStatus === 'NOT_STARTED' ? '100%' : workerOrderStatus === 'IN_PROGRESS' ? '200%' : '300%'}},0,0) scale({{segmentTracks.workerOrders ? segmentTracks.workerOrders.scaleX : 1}},{{segmentTracks.workerOrders ? segmentTracks.workerOrders.scaleY : 1}})" aria-hidden="true"/><button size="mini" wx:for="{{workerOrderStatuses}}" wx:key="key" class="native-button segment-option {{workerOrderStatus === item.key ? 'active' : ''}}" data-segment="workerOrders" data-index="{{index}}" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{workerOrderStatus === item.key}}"><view class="segment-label" style="transform:scale({{segmentTracks.workerOrders.scales[index] || 1}})">{{item.label}}</view></button></view></view>
  <view class="worker-error" wx:if="{{workerTab === 'orders' ? workerOrdersError || (!workerPanel && selfError) : error}}" aria-role="alert">{{workerTab === 'orders' ? workerOrdersError || selfError : error}}</view>
  <view class="worker-loading" wx:if="{{workerTab === 'orders' ? workerOrdersLoading : loading || activeOrderRefreshing}}">{{workerTab === 'orders' || activeOrderRefreshing ? '正在更新工单…' : '正在更新任务…'}}</view>
  <view wx:if="{{workerTab !== 'reports'}}" class="worker-main" aria-hidden="{{!!workerPanel || !!imageViewer}}">
    <scroll-view enhanced="{{true}}" scroll-anchoring="{{true}}" show-scrollbar="{{false}}" bindscroll="onWorkerOrderScroll" bindscrolltolower="loadMoreWorkerOrders" lower-threshold="240" class="worker-scroll worker-order-scroll worker-view-pane {{workerTab === 'orders' ? 'is-active' : ''}}" scroll-y="{{workerTab === 'orders' && !detailMounted && !imageViewer && !operationPanel}}" aria-hidden="{{workerTab !== 'orders' || detailMounted || !!imageViewer || !!operationPanel}}">
      <view class="worker-order-count"><text>已加载 {{workerOrders.length}} 条</text><text wx:if="{{workerOrderKeyword || workerOrderStatus !== 'ALL' || workerOrderScope !== 'all'}}">匹配 {{visibleWorkerOrders.length}} 条</text></view>
      <view id="worker-order-card-{{item.id}}" class="worker-order-card {{detailMounted && detailOrderId === '' + item.id ? 'worker-order-source' : ''}}" wx:for="{{visibleWorkerOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="openWorkerOrder" aria-role="button" aria-label="查看工单{{item.title}}">
        <view class="worker-order-heading"><button size="mini" id="worker-order-image-{{item.id}}" class="native-button worker-order-picture" wx:if="{{item.imageUrl && !item.imageFailed}}" data-id="{{item.id}}" catchtap="previewWorkerOrderImage" aria-label="放大工单{{item.title}}产品图片"><image src="{{item.imageUrl}}" data-id="{{item.id}}" binderror="workerOrderImageError" mode="aspectFit"/></button><view class="worker-order-picture worker-order-missing" wx:else>{{item.imageFailed ? '图片加载失败' : '暂无图片'}}</view><view class="worker-order-title-block"><text class="worker-order-state {{item.status === 'IN_PROGRESS' ? 'is-running' : ''}}">{{item.status === 'IN_PROGRESS' ? '执行中' : item.statusText}}</text><text class="worker-order-due {{item.overdue ? 'is-overdue' : ''}}" wx:if="{{item.dueText}}">{{item.dueLabel}} {{item.dueText}}</text><text class="worker-order-title">{{item.title}}</text></view><view class="worker-order-plan"><text class="worker-order-plan-number {{item.planText.length > 8 ? 'plan-long' : item.planText.length > 4 ? 'plan-wide' : ''}}">{{item.planText}}</text><text>计划数</text><text class="worker-list-remaining">剩余 {{item.remainingText}}</text></view></view>
        <view class="worker-order-meta"><view><image src="/workspace/assets/ui-file-description.png"/><text>工单编号：{{item.code}}</text></view><view><image src="/workspace/assets/ui-clock.png"/><text>计划时间：{{item.startAt || '未确认'}} ~ {{item.endAt || '未确认'}}</text></view><view><image src="/workspace/assets/ui-package.png"/><text>产品信息：{{item.productText}}</text></view><view><image src="/workspace/assets/ui-progress.png"/><text>工单进度：{{item.actualText}}/{{item.planText}}{{item.unitText}}</text></view></view>
        <scroll-view enhanced="{{true}}" mark:backIgnore="{{true}}" class="worker-order-process-scroll" scroll-x="true" show-scrollbar="{{false}}" wx:if="{{item.processes.length}}"><view class="worker-order-process-track"><view class="worker-order-step" wx:for="{{item.processes}}" wx:for-item="process" wx:for-index="processIndex" wx:key="id" data-id="{{item.id}}" data-process="{{process.id}}" catchtap="openWorkerOrder" aria-role="button" aria-label="查看{{process.name}}报工"><view class="worker-order-node {{process.closed ? 'is-closed' : ''}}"><text>{{process.percent}}</text></view><text>{{process.name}}</text><view class="worker-order-line" wx:if="{{processIndex < item.processes.length - 1}}"/></view></view></scroll-view>
        <view class="worker-order-actions {{canOperateOrders ? 'card-actions' : ''}}" wx:if="{{canOperateOrders || selfServiceEnabled && (item.status === 'NOT_STARTED' || item.status === 'IN_PROGRESS')}}">
          <button size="mini" wx:if="{{selfServiceEnabled && (item.status === 'NOT_STARTED' || item.status === 'IN_PROGRESS')}}" id="worker-order-report-{{item.id}}" class="native-button worker-order-report" data-id="{{item.id}}" catchtap="openSelfOrder" disabled="{{!canSelfStart || busy || loading || !!error || !!workerOrdersError}}" aria-label="报工工单{{item.code}}">报工</button>
          <button size="mini" wx:if="{{canOperateOrders}}" id="order-operation-{{item.id}}" class="native-button order-operation-entry {{operationSourceHidden && operationPanel.id === item.id ? 'operation-liquid-source' : ''}}" data-id="{{item.id}}" catchtap="openOrderOperations" disabled="{{busy || !!workerPanel || !!operationPanel}}" aria-label="操作工单{{item.code}}">操作</button>
        </view>
      </view>
      <view class="worker-empty" wx:if="{{!visibleWorkerOrders.length && !workerOrdersLoading && !workerOrdersError}}">{{workerOrders.length ? '暂无匹配工单' : '暂无工单'}}</view>
      <button size="mini" class="native-button worker-load-more" wx:if="{{workerOrdersHasMore || workerOrdersLoading}}" bindtap="loadMoreWorkerOrders" disabled="{{workerOrdersLoading}}">{{workerOrdersLoading ? '正在加载…' : '继续显示工单'}}</button><view class="worker-order-bottom-space"/>
    </scroll-view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="worker-scroll worker-task-scroll worker-view-pane {{workerTab === 'tasks' ? 'is-active' : ''}}" scroll-y="{{workerTab === 'tasks' && !workerPanel && !imageViewer}}" aria-hidden="{{workerTab !== 'tasks' || !!workerPanel || !!imageViewer}}">
      <view class="worker-workspace">
        <view class="worker-machine-bar" wx:if="{{embroideryMode && embroideryTasks.length > 1}}">
          <scroll-view class="worker-machine-strip" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}" aria-label="切换在做工单">
            <view class="worker-machine-tabs">
              <button size="mini" class="native-button worker-machine-tab {{item.id === activeTask.id ? 'is-selected' : ''}}" wx:for="{{embroideryTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="selectEmbroideryTask" disabled="{{busy || loading}}" aria-pressed="{{item.id === activeTask.id}}">{{item.orderCode}} {{item.embroideryPart}}</button>
            </view>
          </scroll-view>
        </view>
        <view id="worker-active-order" class="worker-hero {{detailMounted && workerTab === 'tasks' ? 'worker-active-source' : ''}}" wx:if="{{activeTask}}" bindtap="openActiveOrder" hover-class="pressed" aria-role="button" aria-label="查看任务工单{{activeTask.orderCode}}">
          <view class="worker-hero-copy">
            <view class="worker-hero-tags"><text class="worker-station" wx:if="{{embroideryMode && activeTask.embroideryPart}}">{{activeTask.embroideryPart}}</text><text class="worker-station" wx:elif="{{!embroideryMode && activeTask.unitId}}">{{activeTask.unitId}}</text><text class="worker-urgent" wx:if="{{activeTask.priority === 'URGENT'}}">加急</text></view>
            <text class="worker-process">{{activeTask.processName}}</text>
            <text class="worker-order">工单 {{activeTask.orderCode}}</text>
            <view class="worker-plan"><text class="worker-plan-caption">工单计划</text><view><text class="worker-plan-number">{{activeTask.planText}}</text><text class="worker-plan-unit">{{activeTask.unitText}}</text></view><text class="worker-hero-remaining">工单剩余 {{activeTask.remainingText}}</text></view>
          </view>
          <button size="mini" id="worker-product-image" class="native-button worker-product-picture" wx:if="{{activeTask.imageUrl && !activeTask.imageFailed}}" catchtap="previewWorkerImage" aria-label="放大本工单产品图片"><image src="{{activeTask.imageUrl}}" data-id="{{activeTask.id}}" mode="aspectFit" binderror="workerImageError"/></button>
          <view class="worker-product-picture worker-picture-empty" wx:else catchtap="workerStopBubble"><text>{{activeTask.imageFailed ? '图片加载失败' : '暂无图片'}}</text></view>
        </view>
        <text class="worker-note" wx:if="{{activeTask.canExitClosedSelfTask}}">黑湖工单或工序已关闭，可退出后继续下一单。</text>
        <text class="worker-note" wx:elif="{{activeTask.orderUnavailableReason}}">{{activeTask.orderUnavailableReason}}</text>
        <view class="worker-timer {{current.timerPaused ? 'worker-timer-paused' : ''}}" wx:if="{{current || next.elapsedSeconds > 0}}">
          <view class="worker-timer-heading"><text>生产用时</text><text class="worker-timer-state">{{error ? '状态待刷新' : activeTask.timerStateText}}</text></view>
          <text class="worker-clock">{{clockText}}</text>
        </view>
        <text class="worker-ready-note" wx:elif="{{next}}">准备好后，点击开始生产</text>
        <view class="worker-idle" wx:elif="{{!loading && !error}}"><image src="/workspace/assets/worker-nav-home.png"/><text>{{canSelfStart ? '暂无进行中的任务' : '等待组长安排'}}</text><button size="mini" class="native-button worker-idle-report" wx:if="{{canSelfStart}}" bindtap="openSelfOrders">去工单报工</button><text wx:if="{{paused.length}}">还有 {{paused.length}} 项已暂停任务可自行开始</text></view>
        <view class="worker-peek-row" wx:if="{{queued.length > 1 || (current && queued.length) || paused.length}}">
          <button size="mini" class="native-button" id="worker-queue-entry" wx:if="{{queued.length > 1 || (current && queued.length)}}" bindtap="openWorkerQueue"><text>待做队列</text><text class="worker-peek-count">{{queued.length}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button>
          <button size="mini" class="native-button" id="worker-paused-entry" wx:if="{{paused.length}}" bindtap="openWorkerPaused"><text>组长已暂停</text><text class="worker-peek-count">{{paused.length}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button>
        </view>
      </view>
    </scroll-view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="worker-scroll worker-mine-scroll worker-view-pane {{workerTab === 'mine' ? 'is-active' : ''}}" scroll-y="{{workerTab === 'mine' && !workerPanel && !imageViewer}}" aria-hidden="{{workerTab !== 'mine' || !!workerPanel || !!imageViewer}}">
      <view class="worker-person"><view class="worker-profile-avatar" aria-hidden="true">{{workerAvatar}}</view><text>{{workerName}}</text><text>员工</text></view>
      <button size="mini" id="worker-records-entry" class="native-button worker-records-entry" bindtap="openWorkerRecords" aria-label="查看我的报工记录"><image src="/workspace/assets/worker-nav-history.png"/><text>报工记录</text><text class="worker-records-count">{{records.length}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button>
      <view class="worker-profile-card"><view><text>数据来源</text><text>{{source || (version === null ? '尚未连接' : '当前任务服务')}}</text></view><view><text>更新时间</text><text>{{updatedText || '未读取'}}</text></view></view>
      <button size="mini" class="native-button worker-profile-refresh" wx:if="{{embroideryMode ? canUseStandard : canUseEmbroidery}}" bindtap="switchWorkerReportingMode">{{embroideryMode ? '普通报工' : '绣花报工'}}</button><button size="mini" class="native-button worker-profile-refresh" bindtap="logoutWorkspace">退出登录</button><button size="mini" class="native-button worker-profile-refresh" bindtap="refresh" disabled="{{loading || busy}}">刷新资料</button>
    </scroll-view>
  </view>
  <button size="mini" id="worker-order-scan" class="native-button self-scan-float" wx:if="{{workerTab === 'orders' && selfServiceEnabled && !workerPanel && !imageViewer && !detailMounted}}" bindtap="scanSelfWork" hover-class="self-scan-pressed" disabled="{{!canSelfStart || selfScanning || workerOrdersLoading || !workerOrdersLoaded || !!error || !!workerOrdersError}}" aria-label="扫码报工"><image src="/workspace/assets/scan-camera-blue.png"/><text>{{selfScanning ? '扫码中' : '扫码'}}</text></button>
  <view class="worker-action-dock" wx:if="{{workerTab === 'tasks' && (current || next)}}" aria-hidden="{{!!workerPanel || !!imageViewer}}">
    <button size="mini" class="native-button worker-main-action" wx:if="{{activeTask.canExitClosedSelfTask}}" bindtap="exitClosedSelfTask" disabled="{{busy || loading || !!workerPanel || !!imageViewer}}">{{busy ? '处理中…' : '退出当前任务'}}</button>
    <button size="mini" class="native-button worker-main-action" wx:elif="{{activeTask.canSkipClosedAssignment}}" bindtap="skipClosedAssignment" disabled="{{busy || loading || activeOrderRefreshing || !!workerPanel || !!imageViewer}}">{{busy ? '正在核对…' : '跳过已关闭工序'}}</button>
    <view class="worker-timer-actions" wx:elif="{{current && current.canFinish}}">
      <button size="mini" class="native-button worker-pause-action {{current.timerPaused ? 'worker-resume-action' : ''}}" bindtap="toggleWorkTimer" disabled="{{busy || loading || !!error || !!workerPanel || !!imageViewer}}" aria-label="{{current.canStart ? '开始生产' : current.timerPaused ? '继续计时' : '暂停计时'}}">{{current.timerPaused ? '继续计时' : '暂停计时'}}</button>
      <button size="mini" id="worker-finish-entry" class="native-button worker-main-action worker-finish-action" bindtap="endWork" disabled="{{busy || loading || !!error || !!workerPanel || !!imageViewer}}">{{busy ? '处理中…' : '结束报工'}}</button>
    </view>
    <view class="worker-timer-actions" wx:elif="{{current && current.canConfirmQuantity}}"><button size="mini" class="native-button worker-pause-action" wx:if="{{embroideryMode && current.canReturnToWork}}" bindtap="returnToWork" disabled="{{busy || loading || !!workerPanel || !!imageViewer}}">返回计时</button><button size="mini" class="native-button worker-pause-action" wx:else bindtap="cancelQuantity" disabled="{{busy || loading || (current.isSelfService ? !current.canCancelSelfReport : !current.canReturnToWork) || !!workerPanel || !!imageViewer}}">{{current.quantityCancelLabel}}</button><button size="mini" id="worker-finish-entry" class="native-button worker-main-action worker-confirm-action" bindtap="openQuantity" disabled="{{busy || loading || !!error || !!workerPanel || !!imageViewer}}">确认数量</button></view>
    <button size="mini" class="native-button worker-main-action" wx:elif="{{!current && next && next.canStart}}" bindtap="startWork" disabled="{{busy || loading || !!error || !!workerPanel || !!imageViewer}}">{{busy ? '正在开始…' : '开始生产'}}</button>
  </view>
<view class="worker-reports-pane {{workerTab === 'reports' ? 'is-active' : ''}}"><reports-dashboard id="reports-panel" wx:if="{{reportsMounted}}" active="{{workerTab === 'reports'}}" reduce-motion="{{reduceMotion}}" bind:statechange="onReportWorkspaceState"/></view>
  <view class="worker-nav-wrap {{workerReportModal ? 'worker-reports-hidden' : ''}} {{selfServiceEnabled ? 'worker-liquid-nav-wrap' : ''}}" aria-hidden="{{!!workerPanel || !!imageViewer}}">
    <view mark:backIgnore="{{true}}" wx:if="{{selfServiceEnabled}}" id="worker-glass-navigation" class="bottom-nav worker-liquid-nav {{reduceMotion ? 'nav-reduced' : ''}} {{navPressed ? 'is-pressed' : ''}}" bindtouchstart="onGlassNavStart" catchtouchmove="onGlassNavMove" bindtouchend="onGlassNavEnd" bindtouchcancel="cancelGlassNav" aria-role="tablist" aria-label="员工导航">
      <view class="nav-platter" style="transform:translate3d({{navBarShift}}px,0,0) scale({{navBarScaleX}},{{navBarScaleY}})">
        <view class="nav-glass-base" aria-hidden="true"/>
        <view class="nav-finger-glow" style="opacity:{{navLift * .2845}};transform:translate3d({{navGlowX - 46.5}}px,0,0)" aria-hidden="true"/>
        <button size="mini" wx:for="{{navItems}}" wx:key="key" id="worker-nav-{{item.key}}" class="native-button nav-item {{item.index === navActiveIndex ? 'active' : ''}}" style="left:{{item.left}}px;width:{{navPillWidth}}px" data-index="{{item.index}}" bindtap="onGlassNavTap" hover-class="none" aria-role="tab" aria-label="{{item.label}}" aria-selected="{{item.index === navActiveIndex}}" disabled="{{busy || !!workerPanel || !!imageViewer || detailMounted}}"><view class="nav-symbols"><image src="/workspace/assets/worker-nav-{{item.icon}}.png"/><text>{{item.label}}</text></view></button>
        <view class="nav-lens" style="width:{{navPillWidth}}px;transform:translate3d({{navLensLeft}}px,0,0)" aria-hidden="true">
          <view class="nav-lens-surface" style="transform:scale({{1 + navLift * 16 / navPillWidth}},{{1 + navLift * 16 / 54}})"/>
          <view class="nav-lens-window" style="transform:scale({{1 + navLift * 16 / navPillWidth}},{{1 + navLift * 16 / 54}})"><view class="nav-lens-counter" style="transform:scale({{1 / (1 + navLift * 16 / navPillWidth)}},{{1 / (1 + navLift * 16 / 54)}})"><view class="nav-tinted-track" style="transform:translate3d({{-navLensLeft}}px,0,0)"><view wx:for="{{navItems}}" wx:key="key" class="nav-tinted-item" style="left:{{item.left}}px;width:{{navPillWidth}}px"><view class="nav-symbols" style="transform:scale({{1 + navLift * .16}})"><image src="/workspace/assets/worker-nav-{{item.icon}}.png"/><text>{{item.label}}</text></view></view></view></view></view>
        </view>
      </view>
    </view>
    <view mark:backIgnore="{{true}}" wx:else id="segment-workerTabs" class="worker-nav glass-segments segment-three segment-interactive {{segmentTracks.workerTabs.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="workerTabs" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist" aria-label="员工导航">
      <view class="segment-lens" style="transform:translate3d({{segmentTracks.workerTabs ? segmentTracks.workerTabs.x + 'px' : workerTab === 'tasks' ? '0%' : workerTab === 'orders' ? '100%' : '200%'}},0,0) scale({{segmentTracks.workerTabs ? segmentTracks.workerTabs.scaleX : 1}},{{segmentTracks.workerTabs ? segmentTracks.workerTabs.scaleY : 1}})" aria-hidden="true"/>
      <button size="mini" wx:for="{{workerTabs}}" wx:key="key" class="native-button segment-option {{workerTab === item.key ? 'active' : ''}}" data-segment="workerTabs" data-index="{{index}}" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{workerTab === item.key}}"><view class="segment-label" style="transform:scale({{segmentTracks.workerTabs.scales[index] || 1}})"><image src="/workspace/assets/worker-nav-{{item.icon}}.png"/><text>{{item.label}}</text></view></button>
    </view>
  </view>
  <block wx:if="{{workerPanel}}">
    <view class="worker-panel-mask {{panelOpen ? 'is-open' : ''}}" bindtap="dismissWorkerPanel" catchtouchmove="workerStopBubble"/>
    <view class="worker-panel-shell {{panelOpen ? 'is-open' : ''}}" style="{{workerPanel.boxStyle}}transform:{{reduceMotion || panelOpen ? workerPanel.openTransform : workerPanel.closedTransform}};border-radius:{{panelOpen ? '24px' : workerPanel.closedRadius}}"/>
    <view class="worker-panel {{panelOpen ? 'is-open' : ''}}" data-anchor="{{workerPanel.anchorId}}" style="{{workerPanel.boxStyle}}clip-path:{{reduceMotion || panelOpen ? 'inset(0 round 24px)' : workerPanel.closedClip}}" aria-role="dialog" aria-label="{{workerPanel.kind === 'orderTools' ? workerOrderToolTitle : workerPanel.kind === 'self' ? '自主报工选择工序' : workerPanel.kind === 'records' ? '我的报工记录' : workerPanel.kind === 'quantity' ? '确认本次数量' : workerPanel.kind === 'queue' ? '待做队列' : '组长暂停的任务'}}" aria-modal="true" aria-hidden="{{!panelOpen || !!selfDefectEditor}}" catchtap="workerStopBubble">
      <view class="worker-panel-heading"><view><text>{{workerPanel.kind === 'orderTools' ? workerOrderToolTitle : workerPanel.kind === 'self' ? '选择工序' : workerPanel.kind === 'records' ? '报工记录' : workerPanel.kind === 'quantity' ? '确认数量' : workerPanel.kind === 'queue' ? '待做队列' : '组长已暂停'}}</text><text wx:if="{{workerPanel.kind === 'quantity'}}">{{current.processName}}</text></view><button size="mini" wx:if="{{workerPanel.kind === 'records'}}" class="native-button worker-record-date-trigger {{recordFilterOpen ? 'is-active' : ''}}" bindtap="toggleWorkerRecordFilter" aria-label="筛选报工日期，{{recordRangeText}}" aria-expanded="{{recordFilterOpen}}"><text>{{recordDateLabel}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button><button size="mini" id="worker-panel-dismiss" class="native-button" bindtap="dismissWorkerPanel" aria-label="{{workerPanel.kind === 'quantity' && embroideryMode && current.canReturnToWork ? '返回计时' : '收起面板'}}" disabled="{{busy}}"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
      <view class="self-selected-order" wx:if="{{workerPanel.kind === 'self'}}"><view><text>{{selfOrder.code}}</text><text>{{selfOrder.productName || selfOrder.productText}}</text></view><button size="mini" class="native-button" bindtap="closeWorkerPanel">换工单</button></view>
      <block wx:if="{{workerPanel.kind === 'records'}}">
        <view class="worker-record-filter {{recordFilterOpen ? 'is-open' : ''}}" style="height:{{recordFilterHeight}}px" aria-hidden="{{!recordFilterOpen}}"><view id="worker-record-filter-content" class="worker-record-filter-content">
          <view class="worker-record-date-presets"><button size="mini" wx:for="{{recordDateOptions}}" wx:key="key" class="native-button {{(recordDateCustom ? 'custom' : recordDateMode) === item.key ? 'selected' : ''}}" data-mode="{{item.key}}" bindtap="chooseWorkerRecordDate" aria-pressed="{{(recordDateCustom ? 'custom' : recordDateMode) === item.key}}" disabled="{{!recordFilterOpen}}">{{item.label}}</button></view>
          <block wx:if="{{recordDateCustom}}">
            <view class="worker-record-date-fields"><picker mark:backIgnore="{{true}}" mode="date" value="{{recordDateDraft.start}}" end="{{recordToday}}" data-field="start" bindchange="onWorkerRecordDate" disabled="{{!recordFilterOpen}}" aria-label="报工开始日期"><view><text>开始日期</text><text>{{recordDateDraft.start}}</text></view></picker><text>—</text><picker mark:backIgnore="{{true}}" mode="date" value="{{recordDateDraft.end}}" end="{{recordToday}}" data-field="end" bindchange="onWorkerRecordDate" disabled="{{!recordFilterOpen}}" aria-label="报工结束日期"><view><text>结束日期</text><text>{{recordDateDraft.end}}</text></view></picker></view>
            <view class="worker-record-date-footer"><text class="worker-record-date-error" aria-role="alert">{{recordDateError}}</text><button size="mini" class="native-button" bindtap="applyWorkerRecordDates" disabled="{{!recordFilterOpen}}">应用日期</button></view>
          </block>
        </view></view>
        <view class="worker-record-total"><view><text>报工件数</text><text class="worker-record-kpi">{{version === null ? '—' : recordQuantityText}}</text><text wx:if="{{version !== null}}" class="worker-record-range">{{recordQuantityNote}}</text></view><view><text>{{recordTotalLabel}}</text><text class="worker-record-kpi">{{recordTotalText}}</text><text class="worker-record-range">{{version === null ? '尚未读取' : visibleRecords.length + ' 条 · ' + recordDateLabel}}</text></view></view>
        <text class="worker-record-incomplete" wx:if="{{recordUnknownDurationCount || recordUnknownDateCount}}">{{recordUnknownDurationCount ? recordUnknownDurationCount + ' 条用时未确认' : ''}}{{recordUnknownDurationCount ? (recordUnknownDateCount ? ' · ' : '') : ''}}{{recordUnknownDateCount ? recordUnknownDateCount + ' 条日期未确认' : ''}}</text>
        <view class="worker-record-read-error" wx:if="{{error}}"><text>{{error}}{{version !== null ? ' · 已保留上次记录' : ''}}</text><button size="mini" class="native-button" bindtap="refresh" disabled="{{loading}}">重新读取</button></view>
      </block>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="worker-panel-body" scroll-y="true" scroll-into-view="{{workerPanel.kind === 'self' ? selfProcessScrollTarget : ''}}">
        <block wx:if="{{workerPanel.kind === 'orderTools'}}"><view class="worker-order-tool-options" aria-role="radiogroup" aria-label="{{workerOrderToolTitle}}"><button size="mini" wx:for="{{workerOrderToolOptions}}" wx:key="key" class="native-button worker-order-tool-option {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="chooseWorkerOrderTool" aria-role="radio" aria-checked="{{item.selected}}" disabled="{{!panelOpen}}"><text>{{item.label}}</text><view class="worker-order-tool-check"><image wx:if="{{item.selected}}" src="/workspace/assets/step-check.png"/></view></button></view></block>
        <block wx:elif="{{workerPanel.kind === 'self'}}"><view class="self-process-list" aria-role="radiogroup" aria-label="选择自主报工工序">
          <view wx:for="{{selfProcesses}}" wx:key="id" id="self-process-{{item.id}}" class="self-process {{selfSelected.id === item.id ? 'selected' : ''}} {{!item.selectable ? 'unavailable' : ''}}" data-id="{{item.id}}" bindtap="chooseSelfProcess" aria-role="radio" aria-checked="{{selfSelected.id === item.id}}" aria-disabled="{{!item.selectable}}"><text class="self-process-index">{{item.orderLabel}}</text><view class="self-process-copy"><view><text>{{item.name}}</text><text wx:if="{{item.recommended}}" class="self-recommended">推荐</text></view><text>{{item.closed ? '已关闭' : '计划 ' + item.planText + ' · 剩余 ' + item.remainingText}}</text></view><view class="self-process-progress"><image wx:if="{{item.closed}}" src="/workspace/assets/step-check.png"/><text wx:else>{{item.percent}}</text></view></view>
        </view><text class="self-empty" wx:if="{{selfContextLoading}}">正在更新工序…</text><view class="worker-record-read-error" wx:if="{{selfError}}"><text>{{selfError}}</text><button size="mini" class="native-button" bindtap="retrySelfProcesses" disabled="{{busy || selfContextLoading}}">重试</button></view><text class="self-empty" wx:if="{{!selfContextLoading && !selfError && !selfProcesses.length}}">暂无可用工序</text>
          <view class="self-machine" wx:if="{{embroideryMode && selfSelected.selectable && !selfContextLoading}}">
            <view class="self-machine-parts" aria-label="选择绣花幅位">
              <button size="mini" class="native-button worker-machine-tab {{item === selfEmbroideryPart ? 'is-selected' : ''}}" wx:for="{{selfEmbroideryParts}}" wx:key="*this" data-part="{{item}}" bindtap="chooseSelfEmbroideryPart" disabled="{{busy}}" aria-pressed="{{item === selfEmbroideryPart}}">{{item}}</button>
            </view>
            <text class="self-machine-error" wx:if="{{selfStartError}}" aria-role="alert">{{selfStartError}}</text>
          </view>
        </block>
        <block wx:elif="{{workerPanel.kind === 'quantity'}}">
          <view class="worker-quantity-stat" aria-label="工序计划和剩余数"><view><text>工序计划</text><text>{{current.reportPlanText}}</text></view><view><text>工序剩余</text><text>{{current.reportRemainingText}}</text></view></view>
          <view class="worker-quantity-grid"><view><text>本次数量</text><input mark:backIgnore="{{true}}" type="number" value="{{good}}" bindinput="onGood" bindkeyboardheightchange="onQuantityKeyboard" adjust-position="{{false}}" aria-label="本次数量" placeholder="填写数量" disabled="{{busy || !!selfDefectEditor}}"/></view></view>
          <view class="self-quality-items" wx:if="{{(current.isSelfService || embroideryMode) && current.isQualityInspection}}"><view class="self-quality-heading"><text>不良品项</text><text>{{selfDefectQuantity > 0 ? '共 ' + selfDefectQuantity + ' 件' : ''}}</text></view><view class="self-quality-reasons"><button size="mini" wx:for="{{selfDefectOptions}}" wx:key="code" id="self-defect-{{item.code}}" data-code="{{item.code}}" class="native-button {{item.selected ? 'selected' : ''}}" bindtap="openSelfDefect" aria-label="{{item.name}}，{{item.quantity > 0 ? item.quantity + '件' : '填写不良数量'}}" aria-haspopup="dialog" disabled="{{busy || !!selfDefectEditor}}"><text>{{item.name}}</text><text class="self-defect-count" wx:if="{{item.quantity > 0}}">{{item.quantity}}</text><text wx:else class="self-defect-add">＋</text></button></view></view>
          <text class="worker-form-error" wx:if="{{quantityError}}" aria-role="alert">{{quantityError}}</text>
          <text class="worker-form-error" wx:if="{{!current.canReturnToWork && current.returnToWorkBlockedReason}}">{{current.returnToWorkBlockedReason}}</text>
        </block>
        <block wx:elif="{{workerPanel.kind === 'records'}}">
          <view class="worker-record record-compact" wx:for="{{visibleRecords}}" wx:key="id"><view class="record-head"><button size="mini" class="native-button record-person record-person-button" data-id="{{item.id}}" data-index="{{index}}" bindtap="toggleWorkerReportContext" aria-label="查看{{item.recordWorkerText}}的{{item.processName}}报工资料" aria-expanded="{{workerRecordContextId === item.id + ''}}">{{item.recordWorkerText}}</button><text class="record-sync {{item.recordSyncWarning ? 'record-sync-warning' : ''}}" wx:if="{{item.recordSyncText}}">{{item.recordSyncText}}</text><text class="record-stamp">{{item.recordTimeText}}</text></view><view class="record-bottom"><view class="record-metrics"><view class="record-stat"><text class="record-label">良品数</text><text class="record-value">{{item.recordGoodText}}</text></view><view class="record-stat"><text class="record-label">不良数</text><text class="record-value record-bad">{{item.recordBadText}}</text></view><view class="record-stat"><text class="record-label">时长</text><text class="record-value record-duration">{{item.recordDurationText}}</text></view></view></view><view class="record-context {{workerRecordContextId === item.id + '' ? 'is-open' : ''}}" style="height:{{workerRecordContextId === item.id + '' ? workerRecordContextHeight : 0}}px" aria-hidden="{{workerRecordContextId !== item.id + ''}}"><view id="worker-report-context-{{index}}" class="record-context-content"><text class="record-context-line">{{item.processName}}</text><text class="record-context-line">{{item.orderCode}}</text><text class="record-context-line">{{item.productName}}</text></view></view></view>
          <view class="worker-empty" wx:if="{{!visibleRecords.length}}">{{version === null ? (loading ? '正在读取报工记录…' : '报工记录尚未读取') : (records.length ? '所选日期暂无报工记录' : '暂无报工记录')}}</view>
        </block>
        <block wx:else>
          <view class="worker-queue-item" wx:for="{{workerPanel.kind === 'queue' ? queued : paused}}" wx:key="id"><view><text>{{item.processName}}</text><text class="worker-urgent" wx:if="{{item.priority === 'URGENT'}}">加急</text></view><text>{{item.orderCode}}</text><text>{{workerPanel.kind === 'queue' ? item.statusText : item.canStart ? '待开始' : '等待排到当前任务'}}</text></view>
        </block>
      </scroll-view>
      <view class="worker-panel-footer" wx:if="{{workerPanel.kind === 'orderTools' && workerOrderTool === 'scope'}}"><button size="mini" class="native-button worker-order-reload" bindtap="refreshWorkerOrderList" disabled="{{workerOrdersLoading || busy}}"><image src="/workspace/assets/worker-refresh.png"/><text>刷新工单</text></button></view>
      <view class="worker-panel-footer worker-quantity-actions" wx:if="{{workerPanel.kind === 'quantity'}}">
        <button size="mini" class="native-button worker-pause-action {{current.isSelfService ? 'self-withdraw-action' : ''}}" wx:if="{{!quantityError && current.canConfirmQuantity && (current.isSelfService ? current.canCancelSelfReport : current.canReturnToWork)}}" bindtap="cancelQuantity" disabled="{{busy || loading || !!selfDefectEditor}}">{{current.quantityCancelLabel}}</button>
        <button size="mini" class="native-button worker-pause-action" wx:else bindtap="refreshQuantityTask" disabled="{{busy || loading || activeOrderRefreshing || !!selfDefectEditor}}">刷新工序</button>
        <button size="mini" class="native-button worker-main-action" bindtap="confirmQuantity" disabled="{{busy || loading || !current.canConfirmQuantity || !!selfDefectEditor}}">{{busy ? '确认中…' : '确认数量'}}</button>
      </view>
      <view class="worker-panel-footer self-start-footer" wx:if="{{workerPanel.kind === 'self'}}"><picker mark:backIgnore="{{true}}" wx:if="{{!embroideryMode && selfUnits.length > 1}}" range="{{selfUnitChoices}}" range-key="id" value="{{selfUnitIndex}}" bindchange="chooseSelfUnit" disabled="{{busy}}"><view>{{selfUnitId || '选择工位'}}</view></picker><button size="mini" class="native-button worker-main-action" bindtap="startSelfWork" disabled="{{busy || selfContextLoading || !selfSelected || !canSelfStart || !!selfError || (embroideryMode ? !selfEmbroideryPart : !selfUnitId)}}">{{busy ? '正在开工…' : selfSelected ? '开始生产 · ' + selfSelected.name : '请选择工序'}}</button><text wx:if="{{!embroideryMode && !selfContextLoading && selfProcesses.length && !selfUnits.length}}">暂无可用工位，请联系组长</text></view>
    </view>
  </block>
  <block wx:if="{{selfDefectEditor}}">
    <view class="self-defect-mask {{selfDefectEditorOpen ? 'is-open' : ''}}" bindtap="closeSelfDefect"/>
    <view class="self-defect-material" style="{{selfDefectEditor.boxStyle}}transform:{{reduceMotion || selfDefectEditorOpen ? selfDefectEditor.openTransform : selfDefectEditor.closedTransform}};border-radius:{{selfDefectEditorOpen ? '24px' : selfDefectEditor.closedRadius}};opacity:{{reduceMotion && !selfDefectEditorOpen ? 0 : 1}}" aria-hidden="true"/>
    <view class="self-defect-editor {{selfDefectEditorOpen ? 'is-open' : ''}}" style="{{selfDefectEditor.boxStyle}}clip-path:{{reduceMotion || selfDefectEditorOpen ? 'inset(0 round 24px)' : selfDefectEditor.closedClip}}" aria-role="dialog" aria-label="{{selfDefectEditor.name}}不良数量" aria-modal="true" aria-hidden="{{!selfDefectEditorOpen}}" catchtap="workerStopBubble">
      <view class="self-defect-heading"><text>{{selfDefectEditor.name}}</text><button size="mini" class="native-button" bindtap="closeSelfDefect" aria-label="取消不良项修改"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="self-defect-body" scroll-y="true"><input mark:backIgnore="{{true}}" type="number" value="{{selfDefectDraft}}" bindinput="onSelfDefectInput" bindkeyboardheightchange="onSelfDefectKeyboard" bindconfirm="saveSelfDefect" adjust-position="{{false}}" aria-label="不良项数量" placeholder="填写数量" disabled="{{!selfDefectEditorOpen || selfDefectClosing}}"/><text wx:if="{{selfDefectError}}" class="self-defect-error" aria-role="alert">{{selfDefectError}}</text></scroll-view>
      <button size="mini" class="native-button self-defect-save" bindtap="saveSelfDefect" disabled="{{!selfDefectEditorOpen || selfDefectClosing}}">确定</button>
    </view>
  </block>
  <template is="glass-image-viewer" data="{{...imageViewer}}"/>
</view>
<liquid-detail id="workspace-detail" wx:if="{{detailMounted}}" visible="{{detailVisible}}" origin="{{detailOrigin}}" order-id="{{detailOrderId}}" process-id="{{detailProcessId}}" reduce-motion="{{reduceMotion}}" bind:requestclose="closeDetail" bind:requestopen="reopenDetail" bind:closed="detailClosed"/>
<include src="../../templates/order-operations.wxml"/>




</view>
<view wx:if="{{backHint}}" class="layer-back-hint layer-back-hint-{{backHint.side}}" style="top:{{backHint.y}}px;opacity:{{backHint.opacity}};transform:{{backHint.transform}}" aria-hidden="true"><image src="/workspace/assets/ui-chevron-down.png"/></view>
<page-container show="{{backGuardVisible}}" overlay="{{false}}" duration="{{0}}" position="center" close-on-slide-down="{{false}}" custom-style="width:0;height:0;min-height:0;padding:0;background:transparent;overflow:hidden;" bindbeforeleave="onLayerBackBeforeLeave" bindafterleave="onLayerBackAfterLeave"/>
