.worker-main.worker-main{position:relative}
.worker-view-pane.worker-view-pane{position:absolute;inset:0;width:100%;height:100%;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 120ms cubic-bezier(.23,1,.32,1),visibility 0s linear 120ms}
.worker-view-pane.worker-view-pane.is-active.is-active{z-index:1;opacity:1;visibility:visible;pointer-events:auto;transition:opacity 120ms cubic-bezier(.23,1,.32,1),visibility 0s}
.worker-reduced.worker-reduced .worker-view-pane.worker-view-pane{transition:opacity 100ms ease,visibility 0s linear 100ms}
.worker-reduced.worker-reduced .worker-view-pane.worker-view-pane.is-active.is-active{transition:opacity 100ms ease,visibility 0s}
@media(prefers-reduced-motion:reduce){.worker-view-pane.worker-view-pane{transition:opacity 100ms ease,visibility 0s linear 100ms}.worker-view-pane.worker-view-pane.is-active.is-active{transition:opacity 100ms ease,visibility 0s}}

.worker-hero.worker-hero{cursor:pointer}
.worker-active-source.worker-active-source{opacity:0;pointer-events:none}
.worker-workspace.worker-workspace .worker-timer.worker-timer{margin-top:16px}
.worker-confirm-action.worker-confirm-action{width:auto;flex:1;min-width:0}
.worker-quantity-actions.worker-quantity-actions{display:flex;gap:12px}
.worker-quantity-actions.worker-quantity-actions .worker-main-action.worker-main-action{flex:1;width:auto;min-width:0;font-size:17px}
.worker-quantity-actions.worker-quantity-actions .worker-pause-action.worker-pause-action{font-size:15px}

/* Personal report filters expand in place; record totals never animate. */
.worker-panel-heading.worker-panel-heading .worker-record-date-trigger.worker-record-date-trigger{margin-left:auto;width:auto;min-width:72px;gap:6px;padding:0 12px;height:36px;border-radius:14px;background:#EAF2FF;border:1px solid #D8E6FA;color:#1D4ED8;font-size:12px;font-weight:600;transition:background 160ms ease}
.worker-record-date-trigger.worker-record-date-trigger image{width:13px;height:13px;transition:transform 200ms cubic-bezier(.23,1,.32,1)}
.worker-record-date-trigger.worker-record-date-trigger.is-active.is-active image{transform:rotate(180deg)}
.worker-record-filter.worker-record-filter{flex-shrink:0;overflow:hidden;border-radius:18px;background:rgba(231,240,253,.7);opacity:0;pointer-events:none;transition:height 200ms cubic-bezier(.23,1,.32,1),opacity 160ms cubic-bezier(.23,1,.32,1)}
.worker-record-filter.worker-record-filter.is-open.is-open{opacity:1;pointer-events:auto}
.worker-record-filter-content.worker-record-filter-content{padding:12px}
.worker-record-date-presets.worker-record-date-presets{display:flex;gap:6px}
.worker-record-date-presets.worker-record-date-presets button{flex:1;min-width:0;min-height:36px;border-radius:12px;background:rgba(255,255,255,.75);color:#617B9B;font-size:12px;display:flex;align-items:center;justify-content:center}
.worker-record-date-presets.worker-record-date-presets button.selected.selected{background:#fff;color:#1D4ED8;box-shadow:0 2px 8px rgba(29,78,216,.1);font-weight:700}
.worker-record-date-fields.worker-record-date-fields{display:flex;align-items:center;gap:8px;margin-top:12px}
.worker-record-date-fields.worker-record-date-fields>text{color:#96A9BF;font-size:12px}
.worker-record-date-fields.worker-record-date-fields picker{min-width:0;flex:1;border:1px solid #D9E5F4;border-radius:12px;background:rgba(255,255,255,.8)}
.worker-record-date-fields.worker-record-date-fields picker view{padding:9px 10px}
.worker-record-date-fields.worker-record-date-fields picker text{display:block;font-size:10px;color:#7389A2}
.worker-record-date-fields.worker-record-date-fields picker text+text{margin-top:4px;font-size:12px;font-weight:650;color:#284968;font-variant-numeric:tabular-nums}
.worker-record-date-footer.worker-record-date-footer{display:flex;align-items:center;gap:8px;margin-top:10px;min-height:36px}
.worker-record-date-error.worker-record-date-error{flex:1;min-width:0;font-size:11px;color:#A45423;line-height:1.4}
.worker-record-date-footer.worker-record-date-footer button{margin-left:auto;min-height:36px;padding:8px 14px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#1D4ED8;color:white;font-size:12px;flex-shrink:0}
.worker-record-total.worker-record-total{display:flex;align-items:center;gap:12px;padding:14px 2px 16px;flex-shrink:0}
.worker-record-total.worker-record-total>view{min-width:0;flex:1}
.worker-record-total.worker-record-total>view>text{display:block;font-size:11px;color:#7389A2}
.worker-record-total.worker-record-total .worker-record-kpi.worker-record-kpi{margin-top:3px;font-size:25px;line-height:1.35;font-weight:750;color:#173F73;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.worker-record-total.worker-record-total>view:last-child{border-left:1px solid #dce7f5;padding-left:12px}
.worker-record-total.worker-record-total .worker-record-range.worker-record-range{margin-top:5px;font-size:10px;line-height:1.5;overflow-wrap:anywhere}
.worker-record-incomplete.worker-record-incomplete{display:block;flex-shrink:0;color:#9A702F;font-size:10px;padding:0 2px 10px}
.worker-record-read-error.worker-record-read-error{display:flex;align-items:center;gap:8px;flex-shrink:0;margin-bottom:10px;padding:9px 10px;border-radius:12px;background:#FFF3E7;font-size:11px;color:#945221}
.worker-record-read-error.worker-record-read-error text{flex:1;min-width:0;overflow-wrap:anywhere}
.worker-record-read-error.worker-record-read-error button{flex-shrink:0;min-height:36px;padding:8px;color:#1D4ED8;font-size:11px}
.worker-reduced.worker-reduced .worker-record-filter.worker-record-filter{transition:height 100ms ease,opacity 100ms ease}
.worker-reduced.worker-reduced .worker-record-date-trigger.worker-record-date-trigger image{transition:none}
@media(max-width:350px){.worker-panel-heading.worker-panel-heading .worker-record-date-trigger.worker-record-date-trigger{padding:0 10px;min-width:64px}.worker-record-date-presets.worker-record-date-presets button{font-size:11px}.worker-record-date-fields.worker-record-date-fields{gap:6px}.worker-record-date-fields.worker-record-date-fields picker view{padding:8px}.worker-record-total.worker-record-total .worker-record-kpi.worker-record-kpi{font-size:22px}.worker-record-total.worker-record-total>view:last-child>text{font-size:10px}}
@media(prefers-reduced-motion:reduce){.worker-record-filter.worker-record-filter{transition:height 100ms ease,opacity 100ms ease}.worker-record-date-trigger.worker-record-date-trigger image{transition:none}}

