.worker-panel.worker-panel{position:fixed;z-index:92;display:flex;flex-direction:column;padding:18px;opacity:0;pointer-events:none;transition:clip-path 260ms cubic-bezier(.23,1,.32,1),opacity 160ms cubic-bezier(.23,1,.32,1)}
.worker-panel.worker-panel.is-open.is-open{opacity:1;pointer-events:auto}
.worker-panel-heading.worker-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-shrink:0;padding-bottom:14px}
.worker-panel-heading.worker-panel-heading>view>text{display:block;font-size:21px;font-weight:750}
.worker-panel-heading.worker-panel-heading>view>text+text{font-size:12px;color:#718298;font-weight:400;margin-top:3px}
.worker-panel-heading.worker-panel-heading button{width:44px;height:44px;border-radius:50%;background:#E9F0FA;display:flex;align-items:center;justify-content:center}
.worker-panel-heading.worker-panel-heading image{width:18px;height:18px}
.worker-panel-body.worker-panel-body{flex:1;height:0;min-height:0}
.worker-panel-footer.worker-panel-footer{padding-top:14px;flex-shrink:0}
.worker-quantity-grid.worker-quantity-grid{display:flex;gap:12px;margin-top:8px}
.worker-quantity-grid.worker-quantity-grid>view{flex:1;min-width:0}
