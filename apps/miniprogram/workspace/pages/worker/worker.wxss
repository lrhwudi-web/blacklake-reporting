.worker-person.worker-person>text:last-child{font-size:12px;font-weight:400;color:#718298;margin-top:3px}
.worker-profile-card.worker-profile-card{margin:0 18px;border:1px solid #DFE8F4;border-radius:18px;background:#fff;padding:4px 18px}
.worker-profile-card.worker-profile-card>view{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 0;font-size:12px}
.worker-profile-card.worker-profile-card>view+view{border-top:1px solid #EBF0F7}
.worker-profile-card.worker-profile-card>view>text:first-child{color:#718298;flex-shrink:0}
.worker-profile-card.worker-profile-card>view>text:last-child{text-align:right;overflow-wrap:anywhere}
.worker-profile-refresh.worker-profile-refresh{margin:16px 18px;padding:14px;border-radius:14px;color:#1D4ED8;background:#E5EEFC;font-size:14px}
.worker-panel-mask.worker-panel-mask{position:fixed;inset:0;z-index:90;background:rgba(40,62,91,.23);opacity:0;transition:opacity 200ms cubic-bezier(.23,1,.32,1)}
.worker-panel-mask.worker-panel-mask.is-open.is-open{opacity:1}
