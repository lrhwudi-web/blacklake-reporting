.worker-quantity-grid.worker-quantity-grid input{display:block;width:100%;height:76px;border:1px solid #CFDFF5;background:#EDF4FF;border-radius:16px;color:#173B74;font-size:30px;text-align:center;font-weight:750}
.worker-form-error.worker-form-error{display:block;color:#B45319;font-size:12px;margin-top:14px}
.worker-queue-item.worker-queue-item{padding:16px 0;border-top:1px solid #DFE8F4}
.worker-queue-item.worker-queue-item>view{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:700}
.worker-queue-item.worker-queue-item>text{display:block;font-size:12px;color:#526B8A;margin-top:6px;overflow-wrap:anywhere}
.worker-queue-item.worker-queue-item>text:last-child{font-size:11px;color:#94713E}
.worker-reduced.worker-reduced .worker-panel-shell.worker-panel-shell{transform:none!important;transition:opacity 100ms ease}
.worker-reduced.worker-reduced .worker-panel.worker-panel{clip-path:inset(0 round 24px)!important;transition:opacity 100ms ease}
