.worker-record-order.worker-record-order{display:block;margin-top:5px;font-size:12px;color:#47617F;overflow-wrap:anywhere}
.worker-record-product.worker-record-product{display:block;font-size:11px;color:#718298;margin-top:3px;overflow-wrap:anywhere}
