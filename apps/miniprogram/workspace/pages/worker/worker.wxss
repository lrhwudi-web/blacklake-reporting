@import "../../base.wxss";
@import "../../styles/order-operations.wxss";
.worker-machine-bar{display:flex;align-items:center;gap:8px;margin-bottom:12px}
.worker-machine-strip{flex:1;min-width:0}
.worker-machine-tabs{display:inline-flex;gap:8px;white-space:nowrap;padding:2px}
.native-button.worker-machine-tab{display:flex;align-items:center;justify-content:center;min-height:44px;padding:8px 12px;border:1px solid #D5E3F6;border-radius:13px;background:#F8FBFF;color:#345577;font-size:13px;font-weight:650;white-space:nowrap}
.native-button.worker-machine-tab.is-selected{border-color:#92BAF9;background:#E5EFFF;color:#1748C4}
.self-machine{display:flex;flex-direction:column;gap:10px;margin:12px 0;padding-top:12px;border-top:1px solid #E2EAF5}
.self-machine-parts{display:flex;gap:10px}
.self-machine-parts .worker-machine-tab{flex:1}
.self-machine-error{color:#943E13;font-size:12px}
/* Original employee layout; shared glass controls and image preview stay consistent with the replica. */
.worker-page.worker-page{height:100%;display:flex;flex-direction:column;background:#F1F5F9;color:#0F172A;line-height:1.5}
.worker-header.worker-header{display:flex;align-items:center;justify-content:space-between;min-height:88px;padding:15px 20px 17px;background:#fff;border-bottom:1px solid #DFE7F1;flex-shrink:0}
.worker-eyebrow.worker-eyebrow{display:block;color:#526B8A;font-size:11px;line-height:18px}
.worker-heading.worker-heading{display:block;margin-top:3px;font-size:24px;line-height:30px;font-weight:800;letter-spacing:-.4px}
.worker-refresh.worker-refresh{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#F1F6FF;border:1px solid #E1EBFA}
.worker-refresh.worker-refresh image{width:21px;height:21px}
.worker-error.worker-error{flex-shrink:0;margin:10px 18px 0;padding:10px 14px;border-radius:12px;background:#FFF3E7;color:#943E13;font-size:12px}
.worker-loading.worker-loading{padding:7px 20px;color:#526B8A;font-size:11px;flex-shrink:0}
.worker-main.worker-main{flex:1;min-height:0;display:flex;overflow:hidden}
.worker-scroll.worker-scroll{flex:1;height:100%;min-height:0;width:100%}
.worker-workspace.worker-workspace{padding:20px 18px 24px}
.worker-hero.worker-hero{display:flex;align-items:stretch;gap:16px;min-height:248px;padding:24px;border-radius:20px;background:linear-gradient(135deg,#1D4ED8,#1E3A8A);color:#fff}
.worker-hero-copy.worker-hero-copy{min-width:0;flex:1;display:flex;flex-direction:column}
.worker-hero-tags.worker-hero-tags{display:flex;align-items:center;flex-wrap:wrap;gap:6px;min-height:28px}
.worker-station.worker-station{display:inline-block;border-radius:16px;padding:5px 12px;background:rgba(255,255,255,.18);font-size:12px;font-weight:700;overflow-wrap:anywhere}
.worker-urgent.worker-urgent{display:inline-block;border-radius:8px;padding:3px 8px;background:#FFF1DB;color:#AB4A08;font-size:11px;font-weight:700}
.worker-process.worker-process{display:block;margin-top:14px;font-size:28px;line-height:1.45;font-weight:800;letter-spacing:-.5px;overflow-wrap:anywhere}
.worker-order.worker-order{display:block;margin-top:6px;color:#DBEAFE;font-size:13px;line-height:1.6;overflow-wrap:anywhere}
.worker-plan.worker-plan{margin-top:auto;padding-top:16px}
.worker-plan-caption.worker-plan-caption{display:block;color:#BFDBFE;font-size:10px;margin-bottom:1px}
.worker-plan-number.worker-plan-number{font-size:44px;line-height:1.15;font-weight:800;letter-spacing:-1px;font-variant-numeric:tabular-nums}
.worker-plan-unit.worker-plan-unit{margin-left:6px;font-size:13px;color:#DBEAFE}
.worker-product-picture.worker-product-picture{flex:0 0 41%;min-width:0;max-width:145px;min-height:200px;border-radius:14px;overflow:hidden;background:#fff;display:flex;align-items:center;justify-content:center}
.worker-product-picture.worker-product-picture image{width:100%;height:200px}
.worker-picture-empty.worker-picture-empty{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.22);color:#BFDBFE;font-size:12px}
.worker-timer.worker-timer{padding:17px 20px 20px;border-radius:18px;background:#0F172A;color:#F1F5F9}
.worker-timer-heading.worker-timer-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12px;color:#CBD5E1}
.worker-timer-state.worker-timer-state{color:#55DDB2;font-size:11px}
.worker-timer-paused.worker-timer-paused .worker-timer-state.worker-timer-state{color:#FCD34D}
.worker-clock.worker-clock{display:block;margin-top:6px;text-align:center;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:46px;line-height:1.4;letter-spacing:1px;font-weight:700;font-variant-numeric:tabular-nums}
.worker-ready-note.worker-ready-note{display:block;padding:14px 0;text-align:center;font-size:13px;color:#647B9A}
.worker-sync-note.worker-sync-note{display:block;margin-top:3px;color:#7C8DA3;font-size:10px;line-height:15px}
.worker-peek-row.worker-peek-row{display:flex;gap:10px;margin-top:14px}
.worker-peek-row.worker-peek-row button{display:flex;align-items:center;gap:8px;flex:1;min-height:48px;padding:10px 13px;border:1px solid #DDE7F3;border-radius:14px;background:rgba(255,255,255,.8);color:#456181;font-size:12px;text-align:left}
.worker-peek-count.worker-peek-count{margin-left:auto;color:#1D4ED8;font-size:15px;font-weight:700}
.worker-peek-row.worker-peek-row image{width:13px;height:13px}
.worker-idle.worker-idle{padding:60px 0 42px;display:flex;align-items:center;flex-direction:column;text-align:center;color:#64748B}
.worker-idle.worker-idle image{width:42px;height:42px;opacity:.75;margin-bottom:18px}
.worker-idle.worker-idle>text{display:block;font-size:14px;margin-top:6px}
.worker-idle.worker-idle>text:first-of-type{font-size:23px;color:#253C59;font-weight:700}
.worker-action-dock.worker-action-dock{flex-shrink:0;padding:12px 18px;background:rgba(255,255,255,.92);border-top:1px solid #DFE7F1}
.worker-action-dock.worker-action-dock:empty{display:none}
.worker-timer-actions.worker-timer-actions{display:flex;gap:12px}
.worker-main-action.worker-main-action{display:flex;align-items:center;justify-content:center;min-height:56px;width:100%;border-radius:16px;background:#1D4ED8;color:#fff;font-size:19px;font-weight:750;line-height:1.3;box-shadow:0 5px 14px rgba(29,78,216,.15);padding:12px}
.worker-finish-action.worker-finish-action{background:#E52C30;flex:1;width:auto;box-shadow:0 5px 14px rgba(220,38,38,.13)}
.worker-pause-action.worker-pause-action{width:40%;flex-shrink:0;border-radius:16px;border:1px solid #CBD5E1;background:#fff;color:#334155;font-size:16px;font-weight:700;min-height:56px}
.worker-resume-action.worker-resume-action{background:#EFF6FF;border-color:#BDD5F9;color:#1D4ED8}
.worker-main-action.worker-main-action[disabled],.worker-pause-action.worker-pause-action[disabled]{opacity:.5;box-shadow:none}
.worker-nav-wrap.worker-nav-wrap{flex-shrink:0;padding:7px 18px calc(10px + env(safe-area-inset-bottom));background:rgba(255,255,255,.94)}
.worker-nav.worker-nav.glass-segments.glass-segments{margin:0;min-height:62px;border-radius:22px}
.worker-nav.worker-nav .segment-lens.segment-lens{border-radius:18px}
.worker-nav.worker-nav .segment-option.segment-option{min-height:50px}
.worker-nav.worker-nav .segment-label.segment-label{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:11px;line-height:17px}
.worker-nav.worker-nav .segment-label.segment-label image{width:22px;height:22px}
