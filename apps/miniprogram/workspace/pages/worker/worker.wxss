.worker-record-metrics.worker-record-metrics>view>text:last-child{font-size:17px;color:#1F3C60;font-weight:700;margin-top:2px}
.worker-metric-unit.worker-metric-unit{font-size:10px;font-weight:400}
.worker-empty.worker-empty{padding:90px 20px;text-align:center;font-size:14px;color:#73859B}
.worker-person.worker-person{display:flex;flex-direction:column;align-items:center;padding:40px 18px 28px}
.worker-profile-avatar.worker-profile-avatar{width:64px;height:64px;flex-shrink:0;border-radius:20px;padding:0;display:flex;align-items:center;justify-content:center;background:#E1ECFF;color:#1D4ED8;font-size:24px;font-weight:700;text-align:center}
