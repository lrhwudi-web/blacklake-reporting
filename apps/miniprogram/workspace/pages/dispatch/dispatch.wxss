@import "../../base.wxss";
/* Reference: original app.wxss.wxss + dispatch.wxss.wxss, page-local copy. */
page {
  min-height: 100%;
  background: #f4f8ff;
  color: #0c2b68;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button::after { border: none; }
button { box-sizing: border-box; }
.app-bottom-nav.app-bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 16; display: flex; padding: 8px 0 calc(22px + env(safe-area-inset-bottom)); border-top: 1px solid #E2E8F0; background: #fff; box-sizing: border-box; }
.app-bottom-nav.app-bottom-nav button { flex: 1; min-width: 0; width: 0; min-height: 44px; padding: 4px 0; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 18px; border: 0; background: transparent; color: #64748B; font-size: 11px; font-weight: 600; }
.app-bottom-nav.app-bottom-nav image { display: block; width: 26px; height: 26px; margin-bottom: 4px; padding: 3px; box-sizing: border-box; border-radius: 8px; }
.app-bottom-nav.app-bottom-nav button.active.active { color: #1D4ED8; font-weight: 700; }
.app-bottom-nav.app-bottom-nav button.active.active image { background: #DBEAFE; }


.page.page { min-height: 100vh; padding: 28rpx 24rpx calc(104rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.header.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.brand.brand { display: flex; align-items: center; gap: 14rpx; color: #0c2b68; font-size: 34rpx; font-weight: 800; }
.brand-mark.brand-mark { width: 64rpx; height: 64rpx; border-radius: 20rpx; background: #1686f5; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 34rpx; box-shadow: 0 10rpx 24rpx rgba(22, 134, 245, .22); }
.link-button.link-button { margin: 0; padding: 12rpx; border: 0; background: transparent; color: #196bc8; font-size: 27rpx; font-weight: 700; line-height: 1.25; }
.hero.hero { margin: 42rpx 0 26rpx; }
.hero-title.hero-title { display: block; margin-bottom: 12rpx; color: #0c2b68; font-size: 54rpx; line-height: 1.16; font-weight: 900; letter-spacing: -2rpx; }
.hero-copy.hero-copy { display: block; color: #7382a2; font-size: 28rpx; line-height: 1.5; }
.card.card { padding: 30rpx; border: 2rpx solid #e4ebf6; border-radius: 30rpx; background: #fff; box-shadow: 0 14rpx 38rpx rgba(37, 76, 139, .08); }
.field.field { margin-bottom: 24rpx; }
.field-label.field-label { display: block; margin-bottom: 10rpx; color: #263f73; font-size: 28rpx; font-weight: 800; }
.field-input.field-input { width: 100%; min-height: 100rpx; padding: 18rpx 24rpx; box-sizing: border-box; border: 3rpx solid #dce5f2; border-radius: 22rpx; background: #f9fbff; color: #0c2b68; font-size: 34rpx; }
.field-input.field-input:focus { border-color: #1686f5; background: #fff; }
.primary-button.primary-button { width: 100%; min-height: 102rpx; margin: 22rpx 0 0; border: 0; border-radius: 26rpx; background: #1686f5; color: #fff; font-size: 35rpx; font-weight: 900; line-height: 102rpx; box-shadow: 0 12rpx 26rpx rgba(22, 134, 245, .24); }
.primary-button.primary-button[disabled] { background: #b8c5d8; color: #eef3fa; box-shadow: none; }
.secondary-button.secondary-button { width: 100%; min-height: 92rpx; margin-top: 16rpx; border: 2rpx solid #dce5f2; border-radius: 24rpx; background: #f4f7fc; color: #45618f; font-size: 30rpx; font-weight: 800; line-height: 92rpx; }
.hint.hint { display: block; margin-top: 22rpx; color: #7d8ba7; font-size: 25rpx; line-height: 1.55; text-align: center; }

.login-page.login-page { padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.login-hero.login-hero { margin-top: 30rpx; }
.login-hero.login-hero .hero-title.hero-title { font-size: 50rpx; }
.login-state.login-state { min-height: 64vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.login-state-title.login-state-title { color: #0c2b68; font-size: 44rpx; font-weight: 900; }
.login-state-copy.login-state-copy { margin-top: 18rpx; color: #7382a2; font-size: 28rpx; line-height: 1.55; }
.operator-search.operator-search { margin-bottom: 18rpx; padding: 0 22rpx; border: 2rpx solid #dce5f2; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(37, 76, 139, .06); }
.operator-search.operator-search input { height: 92rpx; color: #0c2b68; font-size: 32rpx; }
.review-entry.review-entry { width: 100%; min-height: 76rpx; margin: 0 0 18rpx; border: 2rpx solid #bcd9fb; border-radius: 22rpx; background: #edf6ff; color: #196bc8; font-size: 27rpx; font-weight: 800; line-height: 76rpx; }
.operator-list.operator-list { height: calc(100vh - 408rpx); overflow: hidden; border: 2rpx solid #e4ebf6; border-radius: 28rpx; background: #fff; box-shadow: 0 14rpx 38rpx rgba(37, 76, 139, .08); }
.operator-row.operator-row { min-height: 104rpx; padding: 18rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 2rpx solid #edf1f7; box-sizing: border-box; }
.operator-row-pressed.operator-row-pressed { background: #edf6ff; }
.operator-name.operator-name { display: block; color: #0c2b68; font-size: 34rpx; font-weight: 900; }
.operator-description.operator-description { display: block; margin-top: 4rpx; color: #8390aa; font-size: 24rpx; }
.operator-arrow.operator-arrow { color: #1686f5; font-size: 48rpx; font-weight: 700; }
.binding-card.binding-card { margin-top: 18rpx; }
.selected-operator.selected-operator { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid #e7edf6; }
.selected-avatar.selected-avatar { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #1686f5; color: #fff; font-size: 36rpx; font-weight: 900; }
.selected-name.selected-name { display: block; color: #0c2b68; font-size: 40rpx; font-weight: 900; }
.binding-label.binding-label { margin-top: 28rpx; text-align: center; }
.confirmation-input.confirmation-input { height: 116rpx; border: 3rpx solid #1686f5; border-radius: 24rpx; background: #f8fbff; color: #0c2b68; text-align: center; font-size: 60rpx; font-weight: 900; letter-spacing: 16rpx; }
.review-code-input.review-code-input { height: 104rpx; padding: 0 22rpx; box-sizing: border-box; border: 3rpx solid #1686f5; border-radius: 24rpx; background: #f8fbff; color: #0c2b68; text-align: center; font-size: 36rpx; font-weight: 800; }
.binding-back.binding-back { width: 100%; margin-top: 20rpx; }
.review-mode-banner.review-mode-banner { margin: -12rpx 0 22rpx; padding: 14rpx 18rpx; border-radius: 18rpx; background: #fff4da; color: #865d10; text-align: center; font-size: 25rpx; font-weight: 800; }

.identity.identity { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; border: 2rpx solid #e1e9f5; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(37, 76, 139, .07); }
.avatar.avatar { width: 84rpx; height: 84rpx; flex: 0 0 auto; border-radius: 24rpx; background: #1686f5; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 900; }
.identity-name.identity-name { display: block; color: #0c2b68; font-size: 36rpx; font-weight: 900; }
.task-card.task-card { margin: 20rpx 0; padding: 26rpx; border: 2rpx solid #cfe3fb; border-radius: 28rpx; background: #edf6ff; }
.task-product.task-product { display: block; color: #6f7fa0; font-size: 27rpx; }
.task-process.task-process { display: block; margin: 8rpx 0; color: #0c2b68; font-size: 44rpx; font-weight: 900; }
.task-meta.task-meta { display: flex; justify-content: space-between; gap: 14rpx; color: #637697; font-size: 25rpx; }
.amount-title.amount-title { display: block; margin: 24rpx 0 15rpx; color: #263f73; text-align: center; font-size: 32rpx; font-weight: 900; }
.amount-row.amount-row { display: grid; grid-template-columns: 100rpx 1fr 100rpx; gap: 14rpx; }
.amount-adjust.amount-adjust { min-height: 108rpx; padding: 0; border-radius: 24rpx; background: #edf4fc; color: #196bc8; font-size: 52rpx; font-weight: 900; line-height: 108rpx; }
.amount-input.amount-input { height: 108rpx; border: 3rpx solid #1686f5; border-radius: 24rpx; background: #fff; color: #0c2b68; text-align: center; font-size: 54rpx; font-weight: 900; }
.quick-row.quick-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 15rpx; }
.quick-button.quick-button { min-height: 78rpx; padding: 0 8rpx; border: 2rpx solid #dce5f2; border-radius: 20rpx; background: #fff; color: #45618f; font-size: 27rpx; font-weight: 800; line-height: 78rpx; }
.defect-row.defect-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 26rpx; padding-top: 22rpx; border-top: 2rpx solid #e7edf6; }
.defect-label.defect-label { color: #263f73; font-size: 29rpx; font-weight: 800; }
.toggle-row.toggle-row { display: flex; gap: 10rpx; }
.toggle.toggle { min-width: 92rpx; min-height: 70rpx; margin: 0; padding: 0 18rpx; border: 2rpx solid #dce5f2; border-radius: 20rpx; background: #fff; color: #45618f; font-size: 27rpx; font-weight: 800; line-height: 70rpx; }
.toggle.toggle.active.active { border-color: #ff405d; background: #fff0f3; color: #c62f49; }
.review-row.review-row { display: flex; justify-content: space-between; gap: 26rpx; padding: 18rpx 0; border-bottom: 2rpx dashed #dce5f2; font-size: 30rpx; }
.review-value.review-value { max-width: 65%; color: #0c2b68; text-align: right; font-weight: 900; }
.status-empty.status-empty { padding: 44rpx 18rpx; color: #7d8ba7; text-align: center; line-height: 1.65; }

page { height: 100%; overflow: hidden; background: #f4f8ff; color: #0c2b68; }
button::after { border: 0; }

.dispatch-page.dispatch-page { height: 100vh; padding: 12rpx 18rpx calc(16rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f4f8ff; overflow: hidden; }
.dispatch-header.dispatch-header { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; }
.dispatch-header.dispatch-header > view:first-child { min-width: 0; margin-right: 18rpx; display: flex; flex: 1; flex-direction: column; }
.dispatch-eyebrow.dispatch-eyebrow { color: #7585aa; font-size: 22rpx; font-weight: 700; line-height: 1.2; }
.dispatch-title.dispatch-title { margin-top: 4rpx; overflow: hidden; color: #0c2b68; font-size: 36rpx; font-weight: 900; letter-spacing: -1rpx; line-height: 1.16; text-overflow: ellipsis; white-space: nowrap; }
.role-pill.role-pill { min-width: 128rpx; height: 50rpx; padding: 0 18rpx; flex: 0 0 auto; box-sizing: border-box; border: 2rpx solid #dce6f4; border-radius: 999rpx; background: #fff; color: #31558b; font-size: 22rpx; font-weight: 800; line-height: 46rpx; text-align: center; box-shadow: 0 6rpx 18rpx rgba(38, 78, 141, .08); }
.soft-pressed.soft-pressed { background: #eaf3ff; }
.history-entry.history-entry { margin: 0 12rpx 0 0; padding: 0 16rpx; height: 54rpx; flex-shrink: 0; border: 2rpx solid #dce6f4; border-radius: 16rpx; background: #fff; color: #31558b; font-size: 23rpx; line-height: 50rpx; }
.dispatch-page-site-map.dispatch-page-site-map .history-entry.history-entry { width: auto; min-width: 0; }

.dispatch-page-scan.dispatch-page-scan { position: relative; padding: 140rpx 0 calc(18rpx + env(safe-area-inset-bottom)); background: #fff; }
.scan-background.scan-background { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.scan-header.scan-header { position: relative; z-index: 1; min-height: 160rpx; padding: 0 32rpx; align-items: flex-start; box-sizing: border-box; }
.scan-header.scan-header .dispatch-eyebrow.dispatch-eyebrow { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 500; }
.scan-header.scan-header .dispatch-title.dispatch-title { margin-top: 50rpx; font-size: 64rpx; letter-spacing: -2rpx; line-height: 1.15; }
.scan-header.scan-header .history-entry.history-entry { width: auto; min-width: 0; height: 84rpx; min-height: 44px; margin: 0 10rpx 0 0; padding: 0 12rpx; border-color: #e0e8f4; border-radius: 14rpx; background: rgba(255, 255, 255, .7); font-size: 12px; line-height: 44px; }
.scan-header.scan-header .role-pill.role-pill { min-width: 44px; height: 84rpx; min-height: 44px; padding: 0 12rpx; font-size: 12px; line-height: 44px; box-shadow: none; background: rgba(255, 255, 255, .7); }
.scan-panel.scan-panel { position: relative; z-index: 1; height: calc(100vh - 318rpx - env(safe-area-inset-bottom)); box-sizing: border-box; }
.scan-content.scan-content { min-height: calc(100vh - 320rpx - env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: flex-start; box-sizing: border-box; padding: 36rpx 32rpx 64rpx; }
.scan-content.scan-content.has-results.has-results { justify-content: flex-start; padding-top: 24rpx; }
.scan-primary.scan-primary { text-align: center; }
.scanner-frame.scanner-frame { width: 560rpx; max-width: 100%; height: 560rpx; position: relative; margin: 0 auto; padding: 0; overflow: visible; border: 0; border-radius: 64rpx; background: transparent; font-size: 0; line-height: 1; transition: transform 140ms cubic-bezier(.23, 1, .32, 1), opacity 140ms ease; }
.scanner-frame.scanner-frame::after { border: 0; }
.scanner-visual.scanner-visual { display: block; width: 100%; height: 100%; pointer-events: none; }
.scanner-disabled.scanner-disabled { opacity: .6; }
.scanner-pressed.scanner-pressed { transform: scale(.98); opacity: .9; }
.scanner-beam.scanner-beam { height: 4rpx; position: absolute; left: 12%; right: 12%; top: 50%; z-index: 2; border-radius: 999rpx; background: #dfffff; box-shadow: 0 0 4rpx #fff, 0 0 18rpx rgba(38, 220, 255, .95), 0 0 32rpx rgba(13, 168, 255, .65); pointer-events: none; animation: scanner-sweep 2.2s cubic-bezier(.77, 0, .175, 1) infinite; }
.scanner-reading.scanner-reading { position: absolute; left: 50%; bottom: 36rpx; z-index: 3; padding: 10rpx 18rpx; transform: translateX(-50%); border-radius: 999rpx; background: rgba(255, 255, 255, .9); color: #31558b; font-size: 24rpx; line-height: 1.4; }
@keyframes scanner-sweep { 0% { transform: translateY(-150rpx); opacity: .35; } 50% { opacity: 1; } 100% { transform: translateY(150rpx); opacity: .35; } }
@keyframes scanner-sweep-compact { 0% { transform: translateY(-120rpx); opacity: .35; } 50% { opacity: 1; } 100% { transform: translateY(120rpx); opacity: .35; } }
@keyframes scanner-sweep-results { 0% { transform: translateY(-64rpx); opacity: .35; } 50% { opacity: 1; } 100% { transform: translateY(64rpx); opacity: .35; } }
.sheet-primary.sheet-primary { width: 100%; min-height: 96rpx; margin: 0; border-radius: 24rpx; background: #1686f5; color: #fff; font-size: 31rpx; font-weight: 900; line-height: 96rpx; box-shadow: 0 12rpx 24rpx rgba(22, 134, 245, .19); }
.sheet-primary.sheet-primary[disabled] { background: #b8c5d8; color: #eef3fa; box-shadow: none; }
.sku-search.sku-search { margin-top: 70rpx; text-align: left; }
.sku-search-row.sku-search-row { display: flex; align-items: stretch; gap: 14rpx; }
.sku-search-input.sku-search-input { min-width: 0; height: 92rpx; min-height: 44px; padding: 0 24rpx; flex: 1; box-sizing: border-box; border: 2rpx solid #d5e4f7; border-radius: 20rpx; background: rgba(248, 251, 255, .8); color: #0c2b68; font-size: 34rpx; }
.sku-placeholder.sku-placeholder { color: #8a9bb6; }
.sku-search-button.sku-search-button { width: 148rpx; min-width: 0; height: 92rpx; min-height: 44px; margin: 0; padding: 0 16rpx; flex: 0 0 148rpx; border: 0; border-radius: 20rpx; background: #1686f5; color: #fff; font-size: 34rpx; font-weight: 800; line-height: 44px; box-shadow: 0 8rpx 16rpx rgba(22, 134, 245, .16); }
.sku-search-button.sku-search-button[disabled] { background: #b8c5d8; color: #eef3fa; }
.sku-search-error.sku-search-error { display: block; margin-top: 14rpx; color: #c62f49; font-size: 24rpx; line-height: 1.4; }
.sku-results.sku-results { margin-top: 24rpx; }
.sku-results-title.sku-results-title { display: block; margin-bottom: 12rpx; color: #31558b; font-size: 24rpx; font-weight: 800; }
.sku-results-list.sku-results-list { overflow: hidden; border: 2rpx solid #e2eaf5; border-radius: 20rpx; }
.sku-result.sku-result { min-height: 90rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #e8eef7; box-sizing: border-box; background: #fff; }
.sku-result.sku-result:last-child { border-bottom: 0; }
.sku-result.sku-result > view { min-width: 0; }
.sku-result-code.sku-result-code { display: block; color: #0c2b68; font-size: 28rpx; font-weight: 900; }
.sku-result-detail.sku-result-detail { display: block; margin-top: 6rpx; color: #71809f; font-size: 22rpx; line-height: 1.35; }
.sku-result-arrow.sku-result-arrow { margin-left: 16rpx; color: #92a3bc; font-size: 42rpx; line-height: 1; }

@media (max-height: 640px) {
  .dispatch-page-scan.dispatch-page-scan { padding-top: 80rpx; }
  .scan-header.scan-header { min-height: 140rpx; }
  .scan-header.scan-header .dispatch-title.dispatch-title { margin-top: 18rpx; }
  .scan-panel.scan-panel { height: calc(100vh - 238rpx - env(safe-area-inset-bottom)); }
  .scan-content.scan-content { min-height: calc(100vh - 240rpx - env(safe-area-inset-bottom)); padding-top: 24rpx; padding-bottom: 36rpx; }
  .scanner-frame.scanner-frame { width: 530rpx; height: 530rpx; }
  .scanner-beam.scanner-beam { animation-name: scanner-sweep-compact; }
  .sku-search.sku-search { margin-top: 48rpx; }
}
.has-results.has-results .scanner-frame.scanner-frame { width: 260rpx; height: 260rpx; }
.has-results.has-results .scanner-beam.scanner-beam { animation-name: scanner-sweep-results; }
.has-results.has-results .sku-search.sku-search { margin-top: 28rpx; }
.scan-search-active.scan-search-active { padding-top: 24rpx; }
.scan-search-active.scan-search-active .scan-header.scan-header { min-height: 112rpx; }
.scan-search-active.scan-search-active .dispatch-title.dispatch-title { margin-top: 12rpx; font-size: 46rpx; }
.scan-search-active.scan-search-active .scan-panel.scan-panel { height: calc(100vh - 154rpx - env(safe-area-inset-bottom)); }
.scan-search-active.scan-search-active .scan-content.scan-content { min-height: calc(100vh - 156rpx - env(safe-area-inset-bottom)); }
@media (prefers-reduced-motion: reduce) { .scanner-beam.scanner-beam { animation: none; opacity: .55; transform: none; } }

.map-screen.map-screen { min-height: 0; }
.order-bar.order-bar { min-height: 64rpx; margin: 4rpx 0 10rpx; padding: 0 2rpx; display: flex; align-items: center; }
.back-button.back-button { width: 76rpx; height: 50rpx; margin-right: 14rpx; flex: 0 0 76rpx; box-sizing: border-box; border: 2rpx solid #dce6f4; border-radius: 17rpx; background: #fff; color: #17407f; font-size: 21rpx; font-weight: 800; line-height: 46rpx; text-align: center; }
.order-summary.order-summary { min-width: 0; display: flex; flex: 1; flex-direction: column; }
.order-bar.order-bar text { color: #8490ad; font-size: 20rpx; line-height: 1.2; }
.order-bar.order-bar .order-code.order-code { margin-top: 3rpx; overflow: hidden; color: #0c2b68; font-size: 28rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.available-badge.available-badge { margin-left: 14rpx; padding: 9rpx 14rpx; display: flex; align-items: center; flex: 0 0 auto; border-radius: 999rpx; background: #e8f9ee; color: #179844; font-size: 22rpx; font-weight: 900; white-space: nowrap; }
.available-badge.available-badge .status-dot.status-dot, .live-badge.live-badge .status-dot.status-dot { width: 13rpx; height: 13rpx; margin-right: 8rpx; flex: 0 0 auto; border-radius: 50%; background: #15c85a; }

.map-card.map-card { position: relative; padding: 16rpx; border: 2rpx solid #e2eaf5; border-radius: 28rpx; background: #fff; box-shadow: 0 14rpx 38rpx rgba(37, 76, 139, .08); }
.map-title-row.map-title-row { display: flex; align-items: flex-start; justify-content: space-between; }
.map-title-row.map-title-row > view:first-child { margin-right: 16rpx; display: flex; flex: 1; flex-direction: column; }
.map-title-row.map-title-row .map-heading.map-heading { color: #0c2b68; font-size: 29rpx; font-weight: 900; }
.map-title-row.map-title-row text { margin-top: 4rpx; color: #8490ad; font-size: 21rpx; }
.live-badge.live-badge { padding: 8rpx 13rpx; display: flex; align-items: center; border-radius: 999rpx; background: #eaf9ef; color: #168c42 !important; font-size: 21rpx !important; font-weight: 900; }
.status-legend.status-legend { margin: 12rpx 0 9rpx; display: flex; flex-wrap: wrap; color: #657395; font-size: 19rpx; }
.status-legend.status-legend > view { margin: 0 14rpx 6rpx 0; display: flex; align-items: center; }
.legend-dot.legend-dot { width: 12rpx; height: 12rpx; margin-right: 6rpx; border-radius: 50%; }
.status-legend.status-legend .available.available { background: #16c95a; }
.status-legend.status-legend .scheduled.scheduled { background: #1686f5; }
.status-legend.status-legend .running.running { background: #ff9b0b; }
.status-legend.status-legend .attention.attention { background: #ff405d; }
.status-legend.status-legend .unmapped.unmapped { background: #aab5c7; }

.map-shell.map-shell { position: relative; width: 100%; overflow: hidden; border: 2rpx solid #e5edf7; border-radius: 24rpx; background: #eef5fb; }
.map-viewport.map-viewport { width: 100%; overflow: hidden; }
.map-movable.map-movable { width: 150%; height: 100%; }
