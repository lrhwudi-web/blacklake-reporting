.people-menu-arrow.people-menu-arrow.arrow-bottom.arrow-bottom{bottom:-5px;border-top:0;border-left:0}
.people-glass-menu.people-glass-menu>button{position:relative;display:flex;align-items:center;gap:11px;width:100%;height:54px;min-height:44px;padding:0 15px;border:0;background:transparent;text-align:left;color:#294B7B;font-size:13px;font-weight:550}
.people-glass-menu.people-glass-menu>button+button{border-top:1px solid rgba(187,208,235,.38)}
.people-glass-menu.people-glass-menu>button image{width:19px;height:19px;opacity:.85;flex-shrink:0}
.people-glass-menu.people-glass-menu>button:active{background:rgba(216,234,255,.65)}
.dispatch-reduced.dispatch-reduced .people-glass-menu.people-glass-menu,.dispatch-reduced.dispatch-reduced .people-selected-sheet.people-selected-sheet{transform:none!important;transition:opacity 100ms ease!important}
@media(prefers-reduced-motion:reduce){.people-glass-menu.people-glass-menu,.dispatch-page.dispatch-page.glass-theme.glass-theme .people-selected-sheet.people-selected-sheet{transform:none!important;transition:opacity 100ms ease!important}.selected-people-mask.selected-people-mask{transition:opacity 100ms ease!important}}
@media(prefers-reduced-transparency:reduce){.people-glass-menu.people-glass-menu,.dispatch-page.dispatch-page.glass-theme.glass-theme .people-selected-sheet.people-selected-sheet{background:#F4F8FF;backdrop-filter:none;-webkit-backdrop-filter:none}}
.dispatch-blocked-list.dispatch-blocked-list{max-height:116px;color:#8b541b}

@import "../../styles/layer-back.wxss";
