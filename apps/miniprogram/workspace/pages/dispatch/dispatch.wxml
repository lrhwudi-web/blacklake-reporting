
<view class="layer-back-surface" capture-bind:touchstart="onLayerBackTouchStart" capture-bind:touchmove="onLayerBackTouchMove" capture-bind:touchend="onLayerBackTouchEnd" capture-bind:touchcancel="onLayerBackTouchCancel">
<view class="dispatch-page dispatch-page-grouped dispatch-page-workspace glass-theme {{reduceMotion ? 'dispatch-reduced' : ''}}" wx:if="{{ready}}">
  <view class="dispatch-flow-header" wx:if="{{!isFloor3 && (stage === 'people' || stage === 'process')}}">
    <view class="people-topbar"><view class="people-header-copy"><text class="people-order">{{floorName}} · 组长 · 工单 {{workOrder.projectCode}}</text><text class="people-title">{{stage === 'people' ? '选择人员' : '选择工序'}}</text></view><button size="mini" id="people-more" class="native-button people-menu people-avatar {{peopleMenuOpen ? 'menu-active' : ''}}" bindtap="openPeopleMenu" disabled="{{submitting}}" aria-label="更多操作" aria-expanded="{{peopleMenuOpen}}" aria-haspopup="menu"><view>{{operator.name ? operator.name[0] : ''}}</view></button></view>
    <view class="people-stepper process-first-stepper" wx:if="{{processFirst}}"><button size="mini" class="native-button people-step process-first-step {{stage === 'process' ? 'step-active' : 'step-done'}}" bindtap="editChosenProcess" disabled="{{submitting || stage === 'process'}}"><view class="step-number {{stage === 'process' ? 'current' : 'done'}}"><text wx:if="{{stage === 'process'}}">1</text><image wx:else src="/workspace/assets/step-check.png" aria-hidden="true"/></view><text>{{stage === 'people' ? selectedProcessName : '选工序'}}</text></button><view class="step-line {{stage === 'people' ? 'done' : ''}}"></view><button size="mini" class="native-button people-step {{stage === 'people' ? 'step-active' : ''}}" bindtap="backToPeople" disabled="{{submitting || !selectedProcessId || stage === 'people'}}"><text class="step-number {{stage === 'people' ? 'current' : ''}}">2</text><text>选人</text></button></view>
    <view class="people-stepper" wx:else><button size="mini" class="native-button people-step {{stage === 'people' ? 'step-active' : 'step-done'}}" bindtap="backToPeople" disabled="{{submitting || stage === 'people'}}"><view class="step-number {{stage === 'people' ? 'current' : 'done'}}"><text wx:if="{{stage === 'people'}}">1</text><image wx:else src="/workspace/assets/step-check.png" aria-hidden="true"/></view><text>选人</text></button><view class="step-line {{stage === 'process' ? 'done' : ''}}"></view><view class="people-step {{stage === 'process' ? 'step-active' : ''}}"><text class="step-number {{stage === 'process' ? 'current' : ''}}">2</text><text>选工序</text></view></view>
  </view>
  <view class="grouped-people" wx:if="{{!isFloor3 && stage === 'people'}}">
    <view class="overview-error" wx:if="{{overviewError}}" bindtap="loadOverview">{{overviewError}} · 重试</view>
    <view class="overview-error" wx:if="{{processesPending}}" bindtap="loadOverview">工序正在后台加载 · 重试读取</view>
    <view class="direct-success" wx:if="{{notice}}" bindtap="openHistory">{{notice}}</view>
    <view class="people-browser">
      <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" scroll-y="true" class="people-group-rail"><view class="people-group {{item.index === departmentIndex ? 'active' : ''}}" wx:for="{{peopleGroups}}" wx:key="id" data-group-index="{{item.index}}" bindtap="choosePeopleGroup" aria-role="button" aria-label="{{item.label}}，{{item.count}}人"><text>{{item.label}}</text><text>{{item.count}}</text></view></scroll-view>
      <view class="people-group-main">
        <view class="people-search-wrap"><view class="worker-search people-search"><icon type="search" size="16" color="#64748B"/><input mark:backIgnore="{{true}}" value="{{employeeQuery}}" bindinput="onEmployeeQuery" placeholder="搜索姓名" bindfocus="onPeopleSearchFocus" bindblur="onPeopleSearchBlur" aria-label="搜索姓名"/></view></view>
        <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="people-grid-scroll" scroll-y="true"><view class="people-grid"><view wx:for="{{groupEmployees}}" wx:key="blacklakeOperatorId" class="person-tile {{item.selected ? 'selected' : ''}} {{item.available || item.canQueue ? '' : 'busy'}}" data-operator-id="{{item.blacklakeOperatorId}}" bindtap="chooseEmployee" aria-role="checkbox" aria-checked="{{item.selected}}" aria-disabled="{{!item.available && !item.canQueue && !item.selected}}" aria-label="{{item.name}}，{{item.available ? '可派' : (item.canQueue ? '可排下一单' : '待处理')}}"><checkbox checked="{{item.selected}}" color="#1D4ED8" class="person-tile-checkbox"/><text class="person-tile-name">{{item.name}}</text><text class="person-tile-busy {{item.canQueue ? 'person-tile-queue' : ''}}" wx:if="{{!item.available}}">{{item.dispatchStateLabel || '忙碌中'}}</text></view></view><text class="worker-empty" wx:if="{{overviewLoaded && !overviewError && !groupEmployees.length}}">没有匹配人员</text></scroll-view>
      </view>
    </view>
    <view class="people-selection-dock"><view class="people-selected-heading"><button size="mini" id="selected-count" class="native-button people-selection-count" bindtap="openSelectedPeople">已选 <text>{{selectedEmployeeIds.length}}</text> 人</button><button size="mini" class="native-button people-select-group" bindtap="selectGroupAvailable" disabled="{{submitting || !peopleGroupAvailableCount}}">{{employeeQuery ? '选搜索可派' : '选本组可派'}}</button><button size="mini" class="native-button people-clear-all" bindtap="clearSelectedEmployees" disabled="{{submitting || !selectedEmployeeIds.length}}">清空</button></view><text class="selection-warning" wx:if="{{selectionWarning}}">{{selectionWarning}}</text><button size="mini" class="native-button people-next" bindtap="continueToProcess" disabled="{{submitting || orderOrbOpen || !selectedEmployeeIds.length || selectionWarning || (processFirst && !selectedProcessId)}}">{{processFirst ? '确认派工' : '下一步：选工序'}}</button></view>
  </view>



  <view class="sheet-mask selected-people-mask {{selectedPanelOpen ? 'is-open' : ''}}" wx:if="{{selectedPanelMounted && stage === 'people'}}" bindtap="closeSelectedPeople"></view>
  <view class="assignment-sheet people-selected-sheet {{selectedPanelOpen ? 'is-open' : ''}}" data-anchor="selected-count" style="height:{{selectedPanelHeight}}px;transform-origin:{{selectedPanelOrigin}}" wx:if="{{selectedPanelMounted && stage === 'people'}}" aria-role="dialog" aria-label="已选人员" aria-modal="true" aria-hidden="{{!selectedPanelOpen}}"><view class="sheet-heading"><view><text class="sheet-unit-title">已选 {{selectedEmployeeIds.length}} 人</text><text>跨分组保留，点击人员可移除</text></view><button size="mini" class="native-button" bindtap="closeSelectedPeople" aria-label="关闭已选人员"><image class="selected-close-chevron" src="/workspace/assets/ui-chevron-down.png"/></button></view><scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" scroll-y="true" class="people-selected-list"><view wx:for="{{selectedChips}}" wx:key="blacklakeOperatorId" class="people-selected-list-item" data-operator-id="{{item.blacklakeOperatorId}}" bindtap="chooseEmployee"><text>{{item.name}}</text><icon type="clear" size="18" color="#1686f5"/></view><text wx:if="{{!selectedEmployeeIds.length}}" class="worker-empty">尚未选择人员</text></scroll-view><button size="mini" class="native-button people-next" bindtap="closeSelectedPeople">返回选人</button></view>

  <view class="process-workspace" wx:if="{{!isFloor3 && stage === 'process'}}">
    <text class="process-status" wx:if="{{predicting || predictionError}}">{{predicting ? '正在推荐…' : predictionError}}</text>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="process-card-scroll" scroll-y="true" scroll-into-view="{{processScrollTarget}}" scroll-with-animation="{{false}}" wx:if="{{processWheelItems.length}}">
      <view class="process-card-list"><view wx:for="{{processWheelItems}}" wx:key="taskId" id="process-card-{{item.taskId}}" class="process-card {{item.taskId === selectedProcessId ? 'selected' : ''}} {{item.taskId === prediction.taskId && item.selectable ? 'recommended' : ''}} {{!item.selectable ? 'unavailable' : ''}}" data-task-id="{{item.taskId}}" bindtap="selectPersonProcess" aria-role="radio" aria-disabled="{{!item.selectable}}" aria-checked="{{item.taskId === selectedProcessId}}" aria-label="{{item.orderLabel}} {{item.processName}}，{{item.closed ? '已关闭' : item.percentLabel + '，' + item.statusLabel}}"><text class="process-card-number">{{item.orderLabel}}</text><view class="leader-process-copy"><text class="process-card-name">{{item.processName}}</text><text class="process-recommended" wx:if="{{item.taskId === prediction.taskId && item.selectable}}">推荐</text></view><view class="leader-process-progress {{item.overPlan ? 'over-plan' : ''}}"><view class="leader-progress-ring"><icon wx:if="{{item.closed}}" type="success_no_circle" size="24" color="#10B981"/><text wx:else>{{item.percentLabel}}</text></view><text class="leader-progress-status">{{item.statusLabel}}</text></view></view></view>
    </scroll-view>
    <view class="process-empty" wx:else>暂无可选工序</view>
    <view class="overview-error" wx:if="{{overviewError}}" bindtap="loadOverview">{{overviewError}} · 重试</view>
    <text class="selection-warning" wx:if="{{selectionWarning}}">{{selectionWarning}}</text>
      <view class="process-dock"><view class="process-dock-summary"><button size="mini" class="native-button" wx:if="{{!processFirst}}" bindtap="backToPeople" disabled="{{submitting}}">已选 {{selectedEmployeeIds.length}} 人 · 修改</button><text>{{selectedProcessName}}</text></view><view class="process-actions"><button size="mini" class="native-button process-next" bindtap="continueFromProcess" disabled="{{submitting || processWheelMoving || !selectedProcessId || (!processFirst && (!selectedEmployeeIds.length || selectionWarning))}}">{{submitting ? '正在派遣…' : (!processes.length ? '暂无可派工序' : (!selectedProcessId ? '请选择工序' : (processFirst ? '下一步：选人员' : '派遣 ' + selectedEmployeeIds.length + ' 人')))}}</button></view></view>
  </view>

  <view class="sheet-mask" wx:if="{{!isFloor3 && reviewOpen}}" bindtap="closeReview"></view>
  <view class="assignment-sheet onepage-review" wx:if="{{!isFloor3 && reviewOpen}}">
    <view class="sheet-grabber"></view><view class="sheet-heading"><view><text class="sheet-unit-title">{{placementOnly ? '补充工位' : '确认派工'}}</text><text>{{workOrder.projectCode}} · {{selectedProcessName}}</text></view><button size="mini" class="native-button" bindtap="closeReview" disabled="{{submitting}}">×</button></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="review-list" scroll-y="true"><view class="placement-row" wx:for="{{employeePlacements}}" wx:key="blacklakeOperatorId"><view><text class="placement-name">{{item.name}}</text><text class="placement-unit {{!item.unitId ? 'unresolved' : ''}}">{{item.unitLabel}}</text><text class="placement-source">{{item.unitId ? (item.source === 'binding' ? '绑定工位自动带入' : '本次临时工位') : '请补充工位'}}</text></view><picker mark:backIgnore="{{true}}" range="{{stationOptions}}" range-key="id" value="{{item.unitIndex}}" data-operator-id="{{item.blacklakeOperatorId}}" bindchange="chooseEmployeeUnit" disabled="{{submitting}}"><view class="placement-edit">{{item.unitId ? '调整' : '选择工位'}}</view></picker></view></scroll-view>
    <input mark:backIgnore="{{true}}" class="adjustment-reason" wx:if="{{!placementOnly && predictionRootId && predictionAdjusted}}" value="{{predictionAdjustmentReason}}" bindinput="onAdjustmentReason" maxlength="200" placeholder="调整说明（选填，便于优化）" disabled="{{submitting}}"/>
    <text class="selection-warning" wx:if="{{selectionWarning}}">{{selectionWarning}}</text>
    <view class="dispatch-priority" wx:if="{{executionMode === 'formal'}}">
      <view mark:backIgnore="{{true}}" id="segment-priority" class="priority-options glass-segments segment-interactive segment-two segment-priority {{segmentTracks.priority.pressed ? 'is-pressed' : ''}} {{dispatchPriority === 'URGENT' ? 'urgent' : ''}}" data-segment="priority" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel">
        <view class="segment-lens" style="transform:translate3d({{segmentTracks.priority ? segmentTracks.priority.x + 'px' : (dispatchPriority === 'URGENT' ? 100 : 0) + '%'}},0,0) scale({{segmentTracks.priority ? segmentTracks.priority.scaleX : 1}},{{segmentTracks.priority ? segmentTracks.priority.scaleY : 1}})" aria-hidden="true"/>
        <button size="mini" class="native-button segment-option {{dispatchPriority === 'NORMAL' ? 'chosen active' : ''}} {{segmentTracks.priority.hover === 0 ? 'segment-hover' : ''}}" data-segment="priority" data-index="0" aria-pressed="{{dispatchPriority === 'NORMAL'}}" bindtap="onGlassSegmentTap" hover-class="none" disabled="{{submitting}}"><view class="segment-label" style="transform:scale({{segmentTracks.priority.scales[0] || 1}})">普通派工</view></button>
        <button size="mini" class="native-button segment-option priority-urgent {{dispatchPriority === 'URGENT' ? 'chosen active' : ''}} {{segmentTracks.priority.hover === 1 ? 'segment-hover' : ''}}" data-segment="priority" data-index="1" aria-pressed="{{dispatchPriority === 'URGENT'}}" bindtap="onGlassSegmentTap" hover-class="none" disabled="{{submitting}}"><view class="segment-label" style="transform:scale({{segmentTracks.priority.scales[1] || 1}})">加急插单</view></button>
      </view>
      <text class="priority-note">{{dispatchPriority === 'URGENT' ? '暂停所选员工正在做的原任务；原任务重新排到第一位后，员工可点击开始。' : '员工忙碌时排入待开始，保留当前生产。'}}</text>
      <text class="priority-note" wx:if="{{impactLoading}}">正在核对人员任务…</text>
      <view class="pause-preview" wx:if="{{dispatchPriority === 'URGENT' && pausePreview.length}}"><text>将自动暂停 {{pausePreview.length}} 人的原任务</text><view wx:for="{{pausePreview}}" wx:key="assignmentId"><text>{{item.workerName}}</text><text>{{item.orderCode}} · {{item.processName}}</text></view></view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="pause-preview dispatch-blocked-list" scroll-y="true" wx:if="{{impactBlocked.length}}"><text>{{impactBlocked.length}} 人暂缓派工</text><view wx:for="{{impactBlocked}}" wx:key="workerId"><text>{{item.workerName}} · {{item.reason}}</text><text wx:if="{{item.orderCode}}">{{item.orderCode}} · {{item.processName}}</text></view></scroll-view>
      <view class="dispatch-impact-error" wx:if="{{dispatchError || impactBlocked.length}}"><text wx:if="{{dispatchError}}">{{dispatchError}}</text><button size="mini" class="native-button" bindtap="refreshDispatchImpact" disabled="{{impactLoading || submitting}}">重新核对</button></view>
    </view>
    <view class="sheet-actions"><button size="mini" class="native-button sheet-primary" bindtap="confirmAssignment" disabled="{{submitting || selectionWarning || (executionMode === 'formal' ? (!impactReady || !impactLoaded || impactLoading) : !placementsReady)}}">{{submitting ? '处理中…' : executionMode === 'formal' ? (impactBlocked.length ? (impactPeople.length ? '确认派出 ' + impactPeople.length + ' 人' : '暂无可派人员') : (dispatchPriority === 'URGENT' ? '确认加急派工' : '确认派工')) : '生成 ' + selectedEmployeeIds.length + ' 人派工草稿'}}</button></view>
  </view>

  <view class="station-manager" wx:if="{{!isFloor3 && stage === 'stations'}}">
    <view class="station-manager-heading"><button size="mini" class="native-button" bindtap="backFromStation" disabled="{{stationSaving}}">{{stationUnit ? '返回工位' : '返回扫码'}}</button><text>{{stationUnit ? stationUnit.id + ' · 常驻人员' : '人员与工位'}}</text><button size="mini" class="native-button" bindtap="refreshStationBindings" disabled="{{stationLoading || stationSaving}}">刷新</button></view>
    <text class="station-manager-note">保存后用于后续派工；当前任务保留原工位。</text><view class="overview-error" wx:if="{{stationError}}">{{stationError}}</view>
    <view class="worker-search"><icon type="search" size="18" color="#8594ad"/><input mark:backIgnore="{{true}}" wx:if="{{!stationUnit}}" value="{{stationQuery}}" bindinput="onStationQuery" placeholder="搜索工位 / 已绑人员"/><input mark:backIgnore="{{true}}" wx:else value="{{stationPersonQuery}}" bindinput="onStationPersonQuery" placeholder="搜索人员 / 部门"/></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" mark:backIgnore="{{true}}" class="binding-selected" wx:if="{{stationUnit && stationDraftIds.length}}" scroll-x="true"><view class="chip-track"><view class="selected-chip" wx:for="{{stationDraftChips}}" wx:key="blacklakeOperatorId" data-operator-id="{{item.blacklakeOperatorId}}" bindtap="toggleStationEmployee">{{item.name}}<icon type="clear" size="12" color="#7592b8"/></view></view></scroll-view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="station-manager-list" scroll-y="true" wx:if="{{!stationUnit}}"><view class="station-binding-row" wx:for="{{visibleStationUnits}}" wx:key="id" data-unit-id="{{item.id}}" bindtap="editStation"><text>{{item.id}}</text><view>{{item.names || '未安排人员'}}</view><text class="binding-edit-link">编辑</text></view><text class="worker-empty" wx:if="{{stationLoading}}">读取中…</text></scroll-view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="station-manager-list" scroll-y="true" wx:else><view class="worker-row {{item.selected ? 'selected' : ''}}" wx:for="{{visibleBindingEmployees}}" wx:key="blacklakeOperatorId" data-operator-id="{{item.blacklakeOperatorId}}" bindtap="toggleStationEmployee"><checkbox class="worker-checkbox" color="#1686f5" checked="{{item.selected}}"/><view class="worker-identity"><text class="worker-name">{{item.name}}</text><text class="worker-department">{{item.description || '生产员工'}}</text></view></view></scroll-view>
    <view class="station-save-footer" wx:if="{{stationUnit}}"><text>已选 {{stationDraftIds.length}} 人 · 可多选</text><button size="mini" class="native-button" bindtap="saveStationBinding" disabled="{{stationSaving || stationSaveUncertain || stationLoading}}">{{stationSaving ? '保存中…' : '保存常驻绑定'}}</button></view>
  </view>

  <view wx:if="{{peopleMenu}}" class="people-menu-backdrop" bindtap="closePeopleMenu"/>
  <view wx:if="{{peopleMenu}}" class="people-glass-menu {{peopleMenuOpen ? 'is-open' : ''}}" data-anchor="people-more" style="left:{{peopleMenu.x}}px;top:{{peopleMenu.y}}px;width:{{peopleMenu.width}}px;transform-origin:{{peopleMenu.originX}}px {{peopleMenu.originY}}px" aria-role="menu" aria-label="组长更多操作" aria-hidden="{{!peopleMenuOpen}}" catchtap="stopGlassBubble">
    <view class="people-menu-arrow {{peopleMenu.below ? 'arrow-top' : 'arrow-bottom'}}" style="left:{{peopleMenu.arrowX}}px"/>
    <button size="mini" class="native-button" data-key="orders" bindtap="choosePeopleMenu" aria-role="menuitem"><image src="/workspace/assets/nav-home-active.png"/><text>返回工单</text></button>
    <button size="mini" class="native-button" data-key="history" bindtap="choosePeopleMenu" aria-role="menuitem"><image src="/workspace/assets/nav-history.png"/><text>{{executionMode === 'formal' ? '查看派工结果' : '查看派工草稿'}}</text></button>
  </view>

</view>
<view class="dispatch-load-error" wx:else><text>{{loadError || "正在读取派工资料…"}}</text><button size="mini" class="native-button" bindtap="returnToOrders">返回工单</button></view>

</view>
<view wx:if="{{backHint}}" class="layer-back-hint layer-back-hint-{{backHint.side}}" style="top:{{backHint.y}}px;opacity:{{backHint.opacity}};transform:{{backHint.transform}}" aria-hidden="true"><image src="/workspace/assets/ui-chevron-down.png"/></view>
<page-container show="{{backGuardVisible}}" overlay="{{false}}" duration="{{0}}" position="center" close-on-slide-down="{{false}}" custom-style="width:0;height:0;min-height:0;padding:0;background:transparent;overflow:hidden;" bindbeforeleave="onLayerBackBeforeLeave" bindafterleave="onLayerBackAfterLeave"/>
