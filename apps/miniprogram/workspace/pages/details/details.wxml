<import src="../../templates/image-viewer.wxml"/>
<view class="layer-back-surface" capture-bind:touchstart="onLayerBackTouchStart" capture-bind:touchmove="onLayerBackTouchMove" capture-bind:touchend="onLayerBackTouchEnd" capture-bind:touchcancel="onLayerBackTouchCancel">

<view class="detail-page glass-theme {{employeeView ? 'employee-order-detail' : ''}}">
  <view class="detail-header">
    <button size="mini" class="native-button back-entry" bindtap="returnToOrders" aria-label="返回工单列表"><image src="/workspace/assets/ui-chevron-down.png"/></button>
    <view class="detail-heading"><text class="detail-eyebrow">安心报工 · 工单</text><text class="detail-title">工单详情</text></view>
    <button size="mini" class="native-button refresh-entry" bindtap="refreshDetail" disabled="{{loading || !hasContext}}">{{loading ? '更新中' : '刷新'}}</button>
  </view>
  <scroll-view enhanced="{{true}}" class="detail-scroll" scroll-y="{{!swipeDragging}}" scroll-into-view="{{detailScrollTarget}}" show-scrollbar="{{false}}" wx:if="{{ready}}">
    <view class="detail-refresh-note" wx:if="{{detailRefreshText}}" style="padding:8px 20px;color:#526882;font-size:12px"><text>{{detailRefreshText}}</text></view>
    <view class="detail-error" wx:if="{{loadError}}"><text>{{loadError}}</text><text>以下保留上次读取的信息。</text></view>
    <view class="detail-hero">
      <view class="hero-top">
        <view id="detail-product-photo" class="detail-picture" bindtap="previewImage" aria-role="button" aria-label="查看产品图片"><image wx:if="{{order.imageUrl && !imageFailed}}" src="{{order.imageUrl}}" mode="aspectFit" binderror="imageError"/><text wx:else>{{imageFailed ? '图片加载失败' : '暂无图片'}}</text></view>
        <view class="hero-copy"><view class="detail-badges"><text class="order-state {{order.status === 'IN_PROGRESS' ? 'running' : ''}}">{{order.statusText}}</text><text class="detail-due {{order.overdue ? 'is-overdue' : ''}}" wx:if="{{order.dueText}}">{{order.dueLabel}} {{order.dueText}}</text></view><text class="detail-order-code">{{order.code}}</text></view>
        <view class="detail-plan"><text>{{order.planText}}</text><text>计划数</text></view>
      </view>
      <view class="detail-summary-meta"><view><image src="/workspace/assets/ui-file-description.png"/><text>工单编号：{{order.code}}</text></view><view><image src="/workspace/assets/ui-clock.png"/><text>计划时间：{{order.startAt}} ~ {{order.endAt}}</text></view><view><image src="/workspace/assets/ui-package.png"/><text>产品信息：{{order.product}}</text></view><view><image src="/workspace/assets/ui-progress.png"/><text>工单进度：{{order.actualText}}/{{order.planText}}{{order.unitText}}</text></view></view>
      <button size="mini" class="native-button summary-toggle" bindtap="toggleSummary" aria-expanded="{{summaryExpanded}}">{{summaryExpanded ? '收起工单信息' : '展开工单信息'}}<image class="{{summaryExpanded ? 'turned' : ''}}" src="/workspace/assets/ui-chevron-down.png"/></button>
      <view class="summary-information" wx:if="{{summaryExpanded}}">
        <view class="information-row"><text>创建时间</text><text>{{order.createdAt || '未提供'}}</text></view>
        <view class="information-row"><text>上次同步</text><text>{{updatedLabel || '未提供'}}</text></view>
        <view class="information-row"><text>上游更新时间</text><text>{{upstreamUpdatedLabel}}</text></view>
      </view>
    </view>
    <view id="detail-section-start" class="detail-section-anchor"/>
    <view mark:backIgnore="{{true}}" id="segment-tabs" class="detail-tabs glass-segments segment-interactive {{segmentTracks.tabs.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="tabs" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist">
      <view class="segment-lens" style="transform:translate3d({{segmentTracks.tabs ? segmentTracks.tabs.x + 'px' : (tab === 'progress' ? 0 : tab === 'materials' ? 100 : tab === 'history' ? 200 : 300) + '%'}},0,0) scale({{segmentTracks.tabs ? segmentTracks.tabs.scaleX : 1}},{{segmentTracks.tabs ? segmentTracks.tabs.scaleY : 1}})" aria-hidden="true"/>
      <button size="mini" class="native-button segment-option {{tab === 'progress' ? 'active' : ''}} {{segmentTracks.tabs.hover === 0 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="0" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'progress'}}"><view class="segment-label" style="transform:scale({{segmentTracks.tabs.scales[0] || 1}})">生产进度</view></button>
      <button size="mini" class="native-button segment-option {{tab === 'materials' ? 'active' : ''}} {{segmentTracks.tabs.hover === 1 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="1" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'materials'}}"><view class="segment-label" style="transform:scale({{segmentTracks.tabs.scales[1] || 1}})">用料明细</view></button>
      <button size="mini" class="native-button segment-option {{tab === 'history' ? 'active' : ''}} {{segmentTracks.tabs.hover === 2 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="2" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'history'}}"><view class="segment-label" style="transform:scale({{segmentTracks.tabs.scales[2] || 1}})">生产履历</view></button>
      <button size="mini" class="native-button segment-option {{tab === 'outsource' ? 'active' : ''}} {{segmentTracks.tabs.hover === 3 ? 'segment-hover' : ''}}" data-segment="tabs" data-index="3" bindtap="onGlassSegmentTap" hover-class="none" aria-role="tab" aria-selected="{{tab === 'outsource'}}"><view class="segment-label" style="transform:scale({{segmentTracks.tabs.scales[3] || 1}})">委外进度</view></button>
    </view>
    <view wx:if="{{tab === 'progress'}}">
      <view class="process-section-heading"><text>{{completeProcesses ? '完整工序' : '已知工序'}} · {{processCounts.all}} 道</text><text wx:if="{{!employeeView}}">左滑工序查看详情</text></view>
      <view mark:backIgnore="{{true}}" wx:if="{{!employeeView}}" id="segment-processes" class="process-filters glass-segments segment-interactive segment-three segment-fast {{segmentTracks.processes.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="processes" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel">
        <view class="segment-lens" style="transform:translate3d({{segmentTracks.processes ? segmentTracks.processes.x + 'px' : (processFilter === 'all' ? 0 : processFilter === 'paused' ? 100 : 200) + '%'}},0,0) scale({{segmentTracks.processes ? segmentTracks.processes.scaleX : 1}},{{segmentTracks.processes ? segmentTracks.processes.scaleY : 1}})" aria-hidden="true"/>
        <button size="mini" class="native-button segment-option {{processFilter === 'all' ? 'active' : ''}} {{segmentTracks.processes.hover === 0 ? 'segment-hover' : ''}}" data-segment="processes" data-index="0" aria-pressed="{{processFilter === 'all'}}" bindtap="onGlassSegmentTap" hover-class="none"><view class="segment-label" style="transform:scale({{segmentTracks.processes.scales[0] || 1}})">全部 {{processCounts.all}}</view></button>
        <button size="mini" class="native-button segment-option {{processFilter === 'paused' ? 'active' : ''}} {{segmentTracks.processes.hover === 1 ? 'segment-hover' : ''}}" data-segment="processes" data-index="1" aria-pressed="{{processFilter === 'paused'}}" bindtap="onGlassSegmentTap" hover-class="none" disabled="{{!executionLoaded}}"><view class="segment-label" style="transform:scale({{segmentTracks.processes.scales[1] || 1}})">已暂停 {{processCounts.paused}}</view></button>
        <button size="mini" class="native-button segment-option {{processFilter === 'running' ? 'active' : ''}} {{segmentTracks.processes.hover === 2 ? 'segment-hover' : ''}}" data-segment="processes" data-index="2" aria-pressed="{{processFilter === 'running'}}" bindtap="onGlassSegmentTap" hover-class="none" disabled="{{!executionLoaded}}"><view class="segment-label" style="transform:scale({{segmentTracks.processes.scales[2] || 1}})">进行中 {{processCounts.running}}</view></button>
      </view>
      <view id="process-results" class="process-results" style="min-height:{{processResultsMinHeight}}px">
      <view class="execution-read-state" wx:if="{{!employeeView && executionError}}"><text>{{executionError}}</text><button size="mini" class="native-button" bindtap="loadExecution" disabled="{{executionLoading}}">刷新人员任务</button></view>
      <text class="execution-source" wx:if="{{!employeeView && sourceMode === 'ui-fixture'}}">本地演示 · 派遣和报工不写入黑湖</text>
      <view class="process-read-error" wx:if="{{processError}}"><text>{{processError}}</text><button size="mini" class="native-button" bindtap="loadProcesses">重试读取工序</button></view>
      <view class="process-loading" wx:if="{{processLoading}}">正在读取工序进度…</view>
      <view mark:backIgnore="{{true}}" class="process-swipe" wx:for="{{visibleProcesses}}" wx:key="id" data-id="{{item.id}}" bindtouchstart="onProcessSwipeStart" bindtouchmove="onProcessSwipeMove" bindtouchend="onProcessSwipeEnd" bindtouchcancel="onProcessSwipeCancel">
        <view wx:if="{{!employeeView}}" class="process-swipe-action {{swipeProcessId === item.id + '' && processSwipeOffset < 0 ? 'revealed' : ''}}" aria-hidden="{{swipeProcessId !== item.id + '' || processSwipeOffset >= 0}}"><button size="mini" class="native-button" data-id="{{item.id}}" catchtap="openProcessDetail" disabled="{{swipeProcessId !== item.id + '' || processSwipeOffset >= 0}}" aria-label="查看{{item.name}}详情">详情</button></view>
        <view class="detail-process-card process-swipe-front {{selectedProcessId === item.id ? 'selected' : ''}} {{item.closed ? 'closed' : ''}} {{processSwipeDragging && swipeProcessId === item.id + '' ? 'is-dragging' : ''}}" style="transform:translate3d({{swipeProcessId === item.id + '' ? processSwipeOffset : 0}}px,0,0)" data-id="{{item.id}}" catchtap="onProcessRowTap" bindlongpress="revealProcessActions" aria-role="{{canDispatch && item.selectable ? 'radio' : 'button'}}" aria-checked="{{selectedProcessId === item.id}}" aria-label="{{item.orderLabel}} {{item.name}}，{{item.closed ? '已关闭，仅查看' : item.percent + '，' + item.statusText}}">
          <view class="process-selection-glass {{selectedProcessId === item.id ? 'is-selected' : ''}}" aria-hidden="true"/>
          <view class="detail-process-main"><text class="process-number">{{item.orderLabel}}</text><view class="process-copy"><text class="process-title">{{item.name}}</text><text class="process-state">{{selectedProcessId === item.id && !employeeView ? '已选中 · ' : ''}}{{item.statusText}}</text></view></view>
          <view class="employee-process-amounts"><view><text>计划数</text><text>{{item.planText}}</text></view><view><text>良品数</text><text>{{item.goodText}}</text></view><view class="employee-defective"><text>不良数</text><text>{{item.defectiveText}}</text></view><view class="process-ring {{item.closed ? 'ring-closed' : ''}}"><image wx:if="{{item.closed}}" src="/workspace/assets/step-check.png"/><text wx:else>{{item.percent}}</text></view></view>
          <button size="mini" wx:if="{{!employeeView}}" class="native-button swipe-access" data-id="{{item.id}}" catchtap="revealProcessActions" aria-label="显示{{item.name}}的详情操作">详情操作</button>
        </view>
      </view>
      <text class="detail-empty" wx:if="{{!visibleProcesses.length && !processLoading && !processError}}">{{processFilter === 'all' ? '暂无工序资料' : '当前分类暂无工序'}}</text>
      <view class="detail-footnote"><text>达到计划数不代表工序已关闭。各工序数量不能相加作为成品产量。</text><text wx:if="{{processTime}}">工序资料更新于 {{processTime}}。</text><text wx:if="{{!completeProcesses}}">当前只含已知工序，未确认完整流程。</text></view>
      </view>
    </view>
    <view class="section-body" wx:else>
      <view class="section-heading"><text>{{tab === 'materials' ? '用料明细' : tab === 'history' ? '生产履历' : '委外进度'}}{{activeSection.loaded && activeSection.available !== false ? ' · ' + activeSection.items.length + (tab === 'materials' ? ' 项' : ' 条') : ''}}<text class="section-demo" wx:if="{{activeSection.demo}}">样本</text></text><button size="mini" class="native-button" bindtap="loadSection" disabled="{{activeSection.loading}}">刷新</button></view>
      <view class="process-read-error" wx:if="{{activeSection.error}}"><text>{{activeSection.error}}</text><text wx:if="{{activeSection.stale}}">以下保留上次读取的明细。</text><button size="mini" class="native-button" bindtap="loadSection">重新读取</button></view>
      <text class="process-loading" wx:if="{{activeSection.loading && !activeSection.items.length}}">正在读取{{tab === 'materials' ? '用料明细' : tab === 'history' ? '生产履历' : '委外进度'}}…</text>
      <text class="detail-footnote" wx:if="{{activeSection.loading && activeSection.items.length}}">正在更新，以下保留上次读取的明细。</text>
      <view wx:if="{{tab === 'materials'}}">
        <view class="section-card material-card" wx:for="{{activeSection.items}}" wx:key="id">
          <view class="section-card-top"><text class="section-index">{{item.indexLabel}}</text><text class="section-title">{{item.title}}<text class="material-spec"> | {{item.specText}}</text></text><view class="material-quantity"><text>{{item.unissuedText}}</text><text>未领料</text></view></view>
          <view class="material-fields">
            <view class="material-row"><text>产品信息</text><text class="material-product">{{item.codeText}}{{item.name ? ' | ' + item.name : ''}}</text></view>
            <view class="material-row"><text>供应商</text><text>{{item.supplierText}}</text></view>
            <view class="material-row"><text>库存数量</text><text>{{item.inventoryText}}</text></view>
            <view class="material-row"><text>需求数量</text><text>{{item.requiredText}}</text></view>
            <view class="material-row"><text>单位用量</text><text>{{item.unitText}}</text></view>
            <view class="material-row"><text>图片</text><button size="mini" id="material-image-{{item.id}}" class="native-button material-image" wx:if="{{item.imageUrl && !item.imageFailed}}" data-id="{{item.id}}" bindtap="previewMaterial" aria-label="查看{{item.title}}图片"><image src="{{item.imageUrl}}" mode="aspectFit" data-id="{{item.id}}" binderror="materialImageError"/></button><text wx:else>{{item.imageFailed ? '图片加载失败' : '—'}}</text></view>
          </view>
        </view>
      </view>
      <view class="history-list" wx:elif="{{tab === 'history'}}">
        <view class="history-entry" wx:for="{{activeSection.items}}" wx:key="id"><view class="history-dot"/><view class="section-card history-card"><text class="history-time">{{item.occurredText}}</text><text class="section-title">{{item.title}}</text><view class="history-person"><text>{{item.operatorText}}</text><text wx:if="{{item.process}}"> · {{item.processText}}</text></view><text class="history-description" wx:if="{{item.description}}">{{item.descriptionText}}</text><view class="history-amounts" wx:if="{{item.goodQuantity !== null && item.goodQuantity !== undefined || item.defectiveQuantity !== null && item.defectiveQuantity !== undefined}}"><text>合格 {{item.goodText}}</text><text>不良 {{item.defectiveText}}</text></view></view></view>
      </view>
      <view wx:else>
        <view class="section-card outsource-card" wx:for="{{activeSection.items}}" wx:key="id"><view class="section-card-top"><text class="section-index">{{item.indexLabel}}</text><text class="section-title">{{item.title}}</text><text class="outsource-status">{{item.stateText}}</text></view><view class="material-fields"><view class="material-row"><text>委外单号</text><text>{{item.codeText}}</text></view><view class="material-row"><text>供应商</text><text>{{item.supplierText}}</text></view><view class="material-row"><text>计划完成</text><text>{{item.endText}}</text></view></view><view class="outsource-amounts"><view><text>{{item.plannedText}}</text><text>计划数</text></view><view><text>{{item.deliveredText}}</text><text>已发出</text></view><view><text>{{item.receivedText}}</text><text>已收回</text></view></view></view>
      </view>
      <text class="detail-empty" wx:if="{{activeSection.loaded && !activeSection.loading && !activeSection.error && !activeSection.items.length}}">{{activeSection.available === false ? activeSection.scopeNote : (tab === 'materials' ? '当前工单暂无用料明细' : tab === 'history' ? '当前工单暂无生产履历' : '当前工单暂无委外记录')}}</text>
      <button size="mini" class="native-button section-load-more" wx:if="{{activeSection.hasMore}}" bindtap="loadSection" data-more="{{true}}" disabled="{{activeSection.loading}}">{{activeSection.loading ? '正在读取…' : '加载更多'}}</button>
      <view class="detail-footnote" wx:if="{{(activeSection.loaded || activeSection.stale) && activeSection.available !== false}}"><text>{{activeSection.sourceLabel}}{{activeSection.updatedLabel ? ' · 查询于 ' + activeSection.updatedLabel : ''}}</text><text wx:if="{{activeSection.scopeNote && activeSection.available !== false}}">{{activeSection.scopeNote}}</text><text wx:if="{{activeSection.hasMore}}">当前仅展示已加载记录。</text></view>
    </view>
    <view class="detail-bottom-space"/>
  </scroll-view>
  <view class="detail-initial" wx:else><text>{{loadError || '正在读取工单详情…'}}</text><button size="mini" class="native-button" wx:if="{{loadError && hasContext}}" bindtap="refreshDetail">重新读取</button><button size="mini" class="native-button" bindtap="returnToOrders">返回工单列表</button></view>
  <view class="detail-dock" wx:if="{{ready}}"><text class="dock-caption">{{canDispatch ? (selectedProcessName ? '已选工序 · ' + selectedProcessName : '可先选工序，再选择派工人员') : '当前工单 · 只读查看'}}</text><button size="mini" wx:if="{{canDispatch}}" class="native-button detail-primary" bindtap="openDispatch" disabled="{{!dispatchEnabled}}">{{loading || processLoading ? '正在读取…' : (order.status === 'FINISHED' ? '工单已结束' : (dispatchEnabled ? (selectedProcessId ? '按所选工序派工' : '选择人员派工') : '暂无可派工序'))}}</button><button size="mini" wx:else class="native-button detail-primary" bindtap="returnToOrders">返回工单列表</button></view>
  <view class="process-detail-mask {{processDetailOpen ? 'is-open' : ''}}" wx:if="{{processDetailMounted}}" catchtap="closeProcessDetail" catchtouchmove="stopProcessBubble"/>
  <view class="process-detail-sheet process-report-card employee-process-sheet {{processDetailOpen ? 'is-open' : ''}} {{reduceMotion ? 'process-reduced' : ''}}" style="height:{{processSheetHeight || processDetail.ledgerHeight}}px" wx:if="{{processDetailMounted}}" aria-role="dialog" aria-label="{{processDetail.name}}详情" aria-modal="true" aria-hidden="{{!!reportPanel}}" catchtap="stopProcessBubble">
    <view mark:backIgnore="{{true}}" class="process-sheet-grip" bindtouchstart="processSheetResizeStart" catchtouchmove="processSheetResizeMove" bindtouchend="processSheetResizeEnd" bindtouchcancel="processSheetResizeEnd" aria-label="上下拖动调整工序详情高度"><view class="sheet-grip-line"/></view>
    <view class="process-detail-heading process-ledger-heading"><view mark:backIgnore="{{true}}" bindtouchstart="processSheetResizeStart" catchtouchmove="processSheetResizeMove" bindtouchend="processSheetResizeEnd" bindtouchcancel="processSheetResizeEnd"><text class="process-ledger-name">{{processDetail.orderLabel}} · {{processDetail.name}}</text><text class="process-ledger-state">工序{{processDetail.statusText}}</text></view><button size="mini" class="native-button" bindtap="closeProcessDetail" aria-label="关闭工序详情"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
    <view class="employee-process-totals"><view><text>计划数</text><text>{{processDetail.planText}}</text></view><view><text>良品数</text><text>{{processDetail.goodText}}</text></view><view class="employee-defective"><text>不良数</text><text>{{processDetail.defectiveText}}</text></view></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="process-detail-scroll" scroll-y="true" bindscroll="closeReportMenu">
      <view class="employee-process-reports"><view class="employee-report-heading"><text>报工记录{{processReports.length || processReportsComplete ? ' · ' + processReports.length + ' 条' : ''}}</text><button size="mini" class="native-button" bindtap="refreshProcessReports" disabled="{{processReportsRefreshing}}">{{processReportsRefreshing ? '更新中' : '刷新'}}</button></view><view class="process-report-sync" wx:if="{{processReportsStatusText || processReportsUpdatedText}}"><text wx:if="{{processReportsStatusText}}">{{processReportsStatusText}}</text><text wx:if="{{processReportsUpdatedText}}">{{processReportsUpdatedText}}</text></view>
        <view class="record-compact" wx:for="{{processReports}}" wx:key="id"><view class="record-head"><text class="record-person">{{item.recordWorkerText}}</text><text class="record-sync {{item.recordSyncWarning ? 'record-sync-warning' : ''}}" wx:if="{{item.recordSyncText}}">{{item.recordSyncText}}</text><text class="record-stamp">{{item.recordTimeText}}</text></view><view class="record-bottom"><view class="record-metrics"><view class="record-stat"><text class="record-label">良品数</text><text class="record-value">{{item.recordGoodText}}</text></view><view class="record-stat"><text class="record-label">不良数</text><text class="record-value record-bad">{{item.recordBadText}}</text></view><view class="record-stat"><text class="record-label">时长</text><text class="record-value record-duration">{{item.recordDurationText}}</text></view></view><button size="mini" wx:if="{{canEditProcessReports && (item.canManage || item.canEdit || item.canDelete)}}" id="report-more-0-{{index}}" class="native-button record-action {{reportMenu.reportId === item.id + '' && reportMenuOpen ? 'is-active' : ''}}" data-id="{{item.id}}" data-anchor="report-more-0-{{index}}" catchtap="showReportActions" disabled="{{actionBusy || processReportsLoading}}" aria-label="{{item.recordWorkerText}}的报工操作" aria-expanded="{{reportMenu.reportId === item.id + '' && reportMenuOpen}}" aria-haspopup="menu"><image class="record-action-icon" src="/workspace/assets/ui-dots-vertical.png"/></button></view></view>
        <view class="process-report-skeleton" wx:if="{{processReportsLoading && !processReports.length}}" aria-label="正在读取本地记录"><view/><view/><view/></view><view class="employee-record-error" wx:if="{{processReportsError}}"><text>{{processReportsError}}</text><text wx:if="{{processReports.length}}">已保留上次读取的记录</text><button size="mini" class="native-button" bindtap="loadProcessReports">重新读取</button></view><text class="employee-record-empty" wx:if="{{!processReportsLoading && !processReportsError && processReportsComplete && !processReports.length}}">暂无报工记录</text>
      </view>

    </scroll-view>
    <view class="process-report-footer" wx:if="{{canCreateProcessReports}}"><button size="mini" class="native-button process-report-create" bindtap="openCreateProcessReport" disabled="{{actionBusy || processReportsLoading}}"><text class="process-report-plus">＋</text><text>新建报工</text></button></view>
  </view>
  <view class="report-menu-mask" wx:if="{{reportMenu}}" catchtap="closeReportMenu" catchtouchmove="closeReportMenu"/>
  <view class="report-action-menu {{reportMenuOpen ? 'is-open' : ''}} {{reduceMotion ? 'menu-reduced' : ''}}" data-anchor="{{reportMenu.anchorId}}" wx:if="{{reportMenu}}" style="left:{{reportMenu.x}}px;top:{{reportMenu.y}}px;width:{{reportMenu.width}}px;transform-origin:{{reportMenu.originX}}px {{reportMenu.originY}}px" aria-role="menu" aria-label="报工操作" aria-hidden="{{!reportMenuOpen}}" catchtap="stopProcessBubble">
    <view class="report-menu-arrow arrow-{{reportMenu.side}}" style="{{reportMenu.arrowStyle}}"/>
    <view class="report-menu-surface">
      <button size="mini" class="native-button report-menu-item {{item.action === 'deleteReport' ? 'is-danger' : ''}}" wx:for="{{reportMenu.options}}" wx:key="action" data-action="{{item.action}}" catchtap="chooseReportMenuAction" disabled="{{!reportMenuOpen || actionBusy}}" aria-role="menuitem">
        <view class="report-menu-icon icon-{{item.icon}}"><view class="pencil-body" wx:if="{{item.icon === 'edit'}}"></view><view class="trash-body" wx:if="{{item.icon === 'delete'}}"><view class="trash-lid"></view><view class="trash-handle"></view></view><view class="restore-ring" wx:if="{{item.icon === 'restore'}}"></view></view><text>{{item.label}}</text>
      </button>
    </view>
  </view>
  <view class="report-mask" wx:if="{{reportPanel}}" catchtap="closeReportLayer"/>
  <view class="report-panel {{reportPanel.isEditor ? 'report-editor-panel' : ''}} {{reportPeopleOpen ? 'is-selecting-people' : ''}} {{reportDefectsOpen ? 'is-editing-defects' : ''}}" style="{{reportPanel.isEditor ? 'height:' + reportEditorHeight + 'px;' + reportExpandStyle : ''}}" wx:if="{{reportPanel}}" aria-role="dialog" aria-label="{{reportPeopleMounted ? '选择生产人员' : reportPanel.title}}" aria-modal="true" aria-hidden="{{!!reportTimeWheel}}" catchtap="stopProcessBubble">
    <view mark:backIgnore="{{true}}" class="report-editor-grip" wx:if="{{reportPanel.isEditor && !reportPeopleMounted && !reportTimeWheel}}" bindtouchstart="reportEditorResizeStart" catchtouchmove="reportEditorResizeMove" bindtouchend="reportEditorResizeEnd" bindtouchcancel="reportEditorResizeEnd" aria-label="上下拖动调整编辑报工高度"><view class="sheet-grip-line"/></view>
    <view class="report-panel-heading"><view><text>{{reportPeopleMounted ? '选择人员' : reportPanel.title}}</text><text>{{reportPanel.processName}} · {{reportPanel.isEditor ? reportEditor.workerName : reportPanel.workerName}}</text></view><button size="mini" class="native-button" bindtap="closeReportLayer" disabled="{{actionBusy}}" aria-label="{{reportPeopleMounted ? '返回报工编辑' : '关闭报工编辑'}}"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
    <view class="report-editor-stage" wx:if="{{reportPanel.isEditor}}">
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="report-editor-scroll report-editor-main {{reportPeopleOpen ? 'is-obscured' : ''}}" scroll-y="true" scroll-into-view="{{reportDefectsOpen ? 'report-defect-fields' : ''}}" aria-hidden="{{reportPeopleOpen}}">
      <text class="editor-section-label">生产信息</text>
      <view class="editor-group">
        <button size="mini" class="native-button editor-row editor-person-trigger" bindtap="openReportPeople" aria-label="选择生产人员" aria-expanded="{{reportPeopleOpen}}"><text>生产人员</text><view><text>{{reportEditor.workerName}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
        <view class="editor-quantity-grid"><view><text>良品数</text><input mark:backIgnore="{{true}}" type="number" focus="{{false}}" value="{{reportGood}}" bindinput="onReportGood" aria-label="修改合格数"/></view><view><text>不良数</text><input mark:backIgnore="{{true}}" type="number" focus="{{false}}" value="{{reportBad}}" bindinput="onReportBad" aria-label="修改不良数"/></view></view>
        <button size="mini" class="native-button editor-row editor-defect-trigger" bindtap="toggleReportDefects" aria-expanded="{{reportDefectsOpen}}"><text>不良品项</text><view><text>{{reportBad === '0' ? '无不良' : reportDefectText || '选择并分配数量'}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
        <view id="report-defect-fields" class="editor-defects" wx:if="{{reportDefectsOpen}}"><view class="editor-defect-row" wx:for="{{reportEditor.defects}}" wx:key="code"><button size="mini" class="native-button defect-choice {{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="toggleReportDefect" aria-role="checkbox" aria-checked="{{item.selected}}">{{item.name}}</button><input mark:backIgnore="{{true}}" wx:if="{{item.selected}}" type="number" value="{{item.quantity}}" data-code="{{item.code}}" bindinput="onReportDefectQuantity" aria-label="{{item.name}}数量"/></view><text class="editor-small-note">各项数量合计需等于不良数</text></view>
      </view>
      <text class="editor-section-label">时间与工时</text>
      <view class="editor-group">
        <view class="editor-time-grid">
          <button size="mini" class="native-button editor-time-trigger" data-part="start" bindtap="openReportDateTime" aria-label="选择开始时间"><text class="editor-time-label">开始时间</text><text class="editor-date">{{reportEditor.startDate || '选择日期'}}</text><view><text class="editor-time">{{reportEditor.startTime || '选择时间'}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
          <button size="mini" class="native-button editor-time-trigger" data-part="end" bindtap="openReportDateTime" aria-label="选择结束时间"><text class="editor-time-label">结束时间</text><text class="editor-date">{{reportEditor.endDate || '选择日期'}}</text><view><text class="editor-time">{{reportEditor.endTime || '选择时间'}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
        </view>
        <view class="editor-row editor-worktime"><text>工时</text><view class="editor-duration unified-duration"><input mark:backIgnore="{{true}}" type="number" value="{{reportEditor.hours}}" data-field="hours" bindinput="onReportField" aria-label="工时小时"/><text>时</text><input mark:backIgnore="{{true}}" type="number" value="{{reportEditor.minutes}}" data-field="minutes" bindinput="onReportField" aria-label="工时分钟"/><text>分</text><button size="mini" class="native-button" bindtap="recalculateReport" aria-label="按起止时间重算工时">重算</button></view></view>
      </view>
      <button size="mini" class="native-button editor-extra-toggle" bindtap="toggleReportExtra" aria-expanded="{{reportExtra}}"><text>更多信息</text><text>{{reportExtra ? '收起' : '用料工序、打卡时长'}}</text><image src="/workspace/assets/ui-chevron-down.png"/></button>
      <view class="editor-group" wx:if="{{reportExtra}}"><view class="editor-row"><text>用料工序</text><input mark:backIgnore="{{true}}" value="{{reportEditor.materialProcess}}" data-field="materialProcess" bindinput="onReportField" maxlength="100" placeholder="选填" aria-label="用料工序"/></view><view class="editor-row"><text>打卡时长</text><view><text>{{reportEditor.punchMinutes ? reportEditor.punchMinutes + ' 分钟' : '—'}}</text><text class="editor-punch-auto">按起止时间计算</text></view></view></view>
      <view class="editor-scroll-space"/>
    </scroll-view>
    <view class="report-people-layer {{reportPeopleOpen ? 'is-open' : ''}}" wx:if="{{reportPeopleMounted}}" aria-hidden="{{!reportPeopleOpen}}">
      <view class="report-people-search"><image src="/workspace/assets/people-search.png"/><input mark:backIgnore="{{true}}" value="{{reportPeopleQuery}}" bindinput="onReportPeopleSearch" placeholder="搜索姓名或部门" aria-label="搜索生产人员"/><button size="mini" class="native-button" wx:if="{{reportPeopleQuery}}" bindtap="clearReportPeopleSearch" aria-label="清空人员搜索">清空</button></view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="report-people-list {{reportPeopleInstant ? 'people-instant' : ''}}" scroll-y="true">
        <view class="people-result-count"><text>{{reportPeopleQuery ? '搜索结果' : '按部门选择'}}</text><text>{{reportPeopleTotal}} 人</text></view>
        <view class="report-department" wx:for="{{reportPeopleGroups}}" wx:for-item="department" wx:key="key">
          <button size="mini" class="native-button report-department-heading {{department.expanded ? 'expanded' : ''}}" data-key="{{department.key}}" bindtap="toggleReportDepartment" aria-expanded="{{department.expanded}}"><text>{{department.name}}</text><text>{{department.count}}人</text><image src="/workspace/assets/ui-chevron-down.png"/></button>
          <view class="report-department-body {{department.expanded ? 'expanded' : ''}}" style="height:{{department.height}}px" aria-hidden="{{!department.expanded}}"><view class="report-department-members"><button size="mini" class="native-button report-person {{person.selected ? 'selected' : ''}}" wx:for="{{department.members}}" wx:for-item="person" wx:key="id" data-id="{{person.id}}" bindtap="selectReportEmployee" disabled="{{!department.expanded || actionBusy}}" aria-label="选择{{person.name}}" aria-pressed="{{person.selected}}"><view class="report-person-avatar">{{person.initial}}</view><text>{{person.name}}</text><text class="report-person-selected" wx:if="{{person.selected}}">已选</text></button></view></view>
        </view>
        <text class="report-people-empty" wx:if="{{!reportPeopleTotal}}">{{reportPeopleQuery ? '未找到匹配人员' : '暂无可选人员'}}</text>
        <view class="editor-scroll-space"/>
      </scroll-view>
    </view>
    </view>
    <view wx:else><text class="report-delete-copy">{{reportPanel.action === 'deleteReport' ? '删除这条报工？' : '恢复这条已删除的报工记录？'}}</text></view>
    <view class="editor-footer" wx:if="{{!reportPeopleMounted}}"><text class="report-form-error" wx:if="{{reportError}}">{{reportError}}</text><view class="report-panel-actions"><button size="mini" class="native-button" wx:if="{{!reportPanel.isEditor}}" bindtap="closeReportPanel" disabled="{{actionBusy}}">取消</button><button size="mini" class="native-button {{reportPanel.action === 'deleteReport' ? 'report-danger' : 'report-save'}}" bindtap="confirmReportAction" disabled="{{actionBusy}}">{{actionBusy ? '处理中…' : reportPanel.action === 'deleteReport' ? '确认删除' : reportPanel.action === 'restoreReport' ? '恢复记录' : reportPanel.action === 'createReport' ? '新建报工' : '保存修改'}}</button></view></view>
  </view>
  <view class="report-time-mask {{reportTimeOpen ? 'is-open' : ''}}" wx:if="{{reportTimeWheel}}" catchtap="closeReportDateTime" catchtouchmove="stopProcessBubble"/>
  <view class="report-time-sheet {{reportTimeOpen ? 'is-open' : ''}} {{reduceMotion ? 'time-reduced' : ''}}" wx:if="{{reportTimeWheel}}" aria-role="dialog" aria-label="{{reportTimeWheel.part === 'start' ? '选择开始时间' : '选择结束时间'}}" aria-modal="true" catchtap="stopProcessBubble" catchtouchmove="stopProcessBubble">
    <view class="report-time-heading"><text>{{reportTimeWheel.part === 'start' ? '选择开始时间' : '选择结束时间'}}</text><button size="mini" class="native-button" bindtap="closeReportDateTime" aria-label="关闭时间选择"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
    <view class="report-time-wheels">
      <picker-view mark:backIgnore="{{true}}" class="report-date-wheel" value="{{reportTimeWheel.value}}" indicator-style="height:44px;background:rgba(219,234,254,.24);border-top:1px solid rgba(160,190,231,.35);border-bottom:1px solid rgba(160,190,231,.35);" mask-style="background-image:linear-gradient(rgba(248,251,255,.96),rgba(248,251,255,0)),linear-gradient(to top,rgba(248,251,255,.96),rgba(248,251,255,0));" bindchange="onReportDateWheelChange" bindpickstart="onReportDateWheelStart" bindpickend="onReportDateWheelEnd" immediate-change="true">
        <picker-view-column><view class="report-wheel-item" wx:for="{{reportTimeWheel.years}}" wx:key="*this">{{item}}年</view></picker-view-column>
        <picker-view-column><view class="report-wheel-item" wx:for="{{reportTimeWheel.months}}" wx:key="*this">{{item}}月</view></picker-view-column>
        <picker-view-column><view class="report-wheel-item" wx:for="{{reportTimeWheel.days}}" wx:key="*this">{{item}}日</view></picker-view-column>
        <picker-view-column><view class="report-wheel-item" wx:for="{{reportTimeWheel.hours}}" wx:key="*this">{{item}}时</view></picker-view-column>
        <picker-view-column><view class="report-wheel-item" wx:for="{{reportTimeWheel.minutes}}" wx:key="*this">{{item}}分</view></picker-view-column>
      </picker-view>
    </view>
    <text class="report-time-error" wx:if="{{reportTimeError}}" aria-role="alert">{{reportTimeError}}</text>
    <view class="report-time-actions"><button size="mini" class="native-button" bindtap="closeReportDateTime">取消</button><button size="mini" class="native-button time-confirm" bindtap="confirmReportDateTime" disabled="{{!reportTimeOpen || reportTimePicking}}">确定</button></view>
  </view>
  <template wx:if="{{imageViewer}}" is="glass-image-viewer" data="{{...imageViewer}}"/>
</view>

</view>
<view wx:if="{{backHint}}" class="layer-back-hint layer-back-hint-{{backHint.side}}" style="top:{{backHint.y}}px;opacity:{{backHint.opacity}};transform:{{backHint.transform}}" aria-hidden="true"><image src="/workspace/assets/ui-chevron-down.png"/></view>
<page-container show="{{backGuardVisible}}" overlay="{{false}}" duration="{{0}}" position="center" close-on-slide-down="{{false}}" custom-style="width:0;height:0;min-height:0;padding:0;background:transparent;overflow:hidden;" bindbeforeleave="onLayerBackBeforeLeave" bindafterleave="onLayerBackAfterLeave"/>
