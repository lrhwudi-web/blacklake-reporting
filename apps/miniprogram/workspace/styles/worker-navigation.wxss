@import "./glass-navigation.wxss";
.worker-nav-wrap.worker-nav-wrap.worker-liquid-nav-wrap.worker-liquid-nav-wrap{height:calc(94px + env(safe-area-inset-bottom));min-height:94px;padding:0;background:transparent;flex-shrink:0}
.worker-liquid-nav.worker-liquid-nav.bottom-nav.bottom-nav{position:fixed;z-index:22;left:21px;right:21px;bottom:21px;bottom:max(21px,calc(env(safe-area-inset-bottom) - 13px));height:62px;min-height:62px;padding:0;border:0;border-radius:31px;background:transparent;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;overflow:visible;user-select:none;-webkit-user-select:none;touch-action:none}
.worker-liquid-nav.worker-liquid-nav .nav-item.nav-item[disabled]{opacity:1}
.worker-liquid-nav.worker-liquid-nav .nav-tinted-item.nav-tinted-item image{filter:brightness(0) saturate(100%) invert(25%) sepia(86%) saturate(2434%) hue-rotate(216deg) brightness(91%) contrast(98%)}
.self-scan-float.self-scan-float{right:16px;bottom:calc(94px + env(safe-area-inset-bottom));width:68px;height:68px;min-width:68px;padding:9px;gap:5px;border:1px solid rgba(255,255,255,.98);background:rgba(249,252,255,.86);font-size:13px;line-height:18px;font-weight:700;box-shadow:inset 0 1px 2px #fff,inset 0 -1px 2px rgba(186,207,233,.45),0 8px 24px rgba(37,68,111,.18);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);transition:transform 120ms cubic-bezier(.23,1,.32,1)}
.self-scan-pressed.self-scan-pressed{transform:scale(.96)}
@media(prefers-reduced-motion:reduce){.self-scan-float.self-scan-float{transition:none}.self-scan-pressed.self-scan-pressed{transform:none}}
@media(prefers-reduced-transparency:reduce){.self-scan-float.self-scan-float{background:#F8FBFF;backdrop-filter:none;-webkit-backdrop-filter:none}}
