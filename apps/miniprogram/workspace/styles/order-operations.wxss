.card-actions.card-actions{gap:10px}.card-actions.card-actions .quick-action.quick-action{flex:1;min-width:0;width:auto}.card-actions.card-actions .order-operation-entry.order-operation-entry{display:flex;align-items:center;justify-content:center;flex:0 0 96px;min-height:48px;border:1px solid #CFDFF7;border-radius:14px;background:rgba(249,252,255,.86);box-shadow:inset 0 1px 2px #FFF;color:#1D4ED8;font-size:15px;font-weight:650}
