.layer-back-surface.layer-back-surface{position:relative;width:100%;height:100%;min-height:0}
.layer-back-hint.layer-back-hint{position:fixed;z-index:3000;width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.95);border-radius:50%;background:rgba(245,250,255,.9);box-shadow:0 4px 16px #34527b21,inset 0 1px 1px white;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);pointer-events:none;will-change:transform,opacity}
.layer-back-hint-left.layer-back-hint-left{left:5px}.layer-back-hint-right.layer-back-hint-right{right:5px}.layer-back-hint.layer-back-hint image{width:17px;height:17px;transform:rotate(90deg)}.layer-back-hint-right.layer-back-hint-right image{transform:rotate(-90deg)}
@media(prefers-reduced-motion:reduce){.layer-back-hint.layer-back-hint{will-change:opacity}}
