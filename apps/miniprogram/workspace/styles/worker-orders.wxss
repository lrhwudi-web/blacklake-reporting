/* Employee orders follow the leader card's dimensions and density; only reporting is actionable. */
.worker-header.worker-header.worker-orders-header.worker-orders-header{min-height:76px;padding:12px 10px;gap:12px;background:#F1F6FD;border-bottom:0}
.worker-orders-scope.worker-orders-scope{display:flex;align-items:center;gap:7px;flex:1;min-width:0;min-height:46px;text-align:left;font-size:24px;line-height:34px;font-weight:800;letter-spacing:-.5px}
.worker-orders-scope.worker-orders-scope>text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.worker-orders-scope.worker-orders-scope>image{width:16px;height:16px;flex-shrink:0}
.worker-orders-toolbar-actions.worker-orders-toolbar-actions{display:flex;align-items:center;gap:4px;flex-shrink:0}
.worker-orders-icon.worker-orders-icon{position:relative;display:flex;align-items:center;justify-content:center;width:46px;height:46px;border:1px solid rgba(255,255,255,.9);border-radius:16px;background:rgba(255,255,255,.64);box-shadow:inset 0 1px 1px rgba(255,255,255,.96);transition:transform 120ms cubic-bezier(.23,1,.32,1),background 120ms ease}
.worker-orders-icon.worker-orders-icon>image{width:21px;height:21px}
.worker-orders-icon.worker-orders-icon.is-active.is-active{background:rgba(221,235,255,.8);border-color:#BED5F6}
.worker-toolbar-pressed.worker-toolbar-pressed{transform:scale(.94);background:rgba(224,236,254,.8)}
.worker-orders-icon.worker-orders-icon[disabled],.worker-orders-scope.worker-orders-scope[disabled]{opacity:.5}
.worker-orders-header.worker-orders-header .worker-order-search.worker-order-search{min-height:46px}
.worker-order-tool-options.worker-order-tool-options{display:flex;flex-direction:column;gap:8px;padding:8px 0}
.worker-order-tool-option.worker-order-tool-option{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:50px;padding:12px 14px;border:1px solid rgba(219,230,245,.85);border-radius:15px;background:rgba(255,255,255,.6);font-size:14px;color:#3E5876;text-align:left}
.worker-order-tool-option.worker-order-tool-option.selected.selected{color:#1D4ED8;border-color:#AFCBF1;background:#EAF2FF}
.worker-order-tool-check.worker-order-tool-check{width:22px;height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.worker-order-tool-check.worker-order-tool-check image{width:18px;height:18px}
.worker-order-reload.worker-order-reload{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:46px;border:1px solid #DCE8F6;border-radius:15px;background:rgba(234,242,255,.7);color:#315F9E;font-size:14px}
.worker-order-reload.worker-order-reload image{width:18px;height:18px}
@media(max-width:350px){.worker-header.worker-header.worker-orders-header.worker-orders-header{gap:8px}.worker-orders-scope.worker-orders-scope{font-size:22px;gap:4px}.worker-orders-icon.worker-orders-icon{width:44px;height:44px;border-radius:15px}.worker-orders-toolbar-actions.worker-orders-toolbar-actions{gap:4px}.worker-orders-icon.worker-orders-icon>image{width:20px;height:20px}}
@media(prefers-reduced-motion:reduce){.worker-orders-icon.worker-orders-icon{transition:none}}
.worker-order-scroll.worker-order-scroll{background:#EDF3FB}
.worker-order-scroll.worker-order-scroll .worker-order-card.worker-order-card{margin:0 16px 14px;padding:18px;border:1px solid rgba(255,255,255,.96);border-radius:20px;background:rgba(250,252,255,.7);box-shadow:inset 0 1px 1px rgba(255,255,255,.98),inset 0 -1px 1px rgba(166,187,215,.2),0 9px 26px rgba(42,72,117,.07);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);overflow:hidden;line-height:1.6}
.worker-order-scroll.worker-order-scroll .worker-order-heading.worker-order-heading{gap:10px;min-height:62px}
.worker-order-scroll.worker-order-scroll .worker-order-picture.worker-order-picture{width:124.6rpx;height:124.6rpx;border-radius:12px;background:rgba(255,255,255,.52);border-color:rgba(223,231,243,.8);box-shadow:inset 0 1px 1px #fff}
.worker-order-scroll.worker-order-scroll .worker-order-state.worker-order-state{padding:2px 8px;border-radius:6px;background:#F1F5F9;color:#475569;font-size:11px;font-weight:600;line-height:18px}
.worker-order-scroll.worker-order-scroll .worker-order-state.worker-order-state.is-running.is-running{background:#DBEAFE;color:#1D4ED8}
.worker-order-scroll.worker-order-scroll .worker-order-title.worker-order-title{margin-top:5px;color:#0F172A;font-size:16px;font-weight:700;line-height:1.5}
.worker-order-scroll.worker-order-scroll .worker-order-plan.worker-order-plan{width:auto;min-width:60px;max-width:45%;padding:6px;min-height:60px;border:1px solid rgba(255,255,255,.92);border-radius:14px;background:rgba(222,237,255,.56);box-shadow:inset 0 1px 2px rgba(255,255,255,.96)}
.worker-order-scroll.worker-order-scroll .worker-order-plan.worker-order-plan>text{font-size:23px;line-height:30px;color:#1D4ED8;font-weight:800}
.worker-order-scroll.worker-order-scroll .worker-order-plan.worker-order-plan>.worker-order-plan-number.plan-wide{font-size:18px}
.worker-order-scroll.worker-order-scroll .worker-order-plan.worker-order-plan>.worker-order-plan-number.plan-long{font-size:13px}
.worker-order-scroll.worker-order-scroll .worker-order-plan.worker-order-plan>text+text{font-size:10px;line-height:16px;color:#64748B;font-weight:500}
.worker-order-scroll.worker-order-scroll .worker-order-meta.worker-order-meta{display:block;margin-top:16px;color:#53677F;font-size:13px;line-height:1.65}
.worker-order-scroll.worker-order-scroll .worker-order-meta.worker-order-meta>view{display:flex;align-items:flex-start;gap:7px;margin-bottom:8px}
.worker-order-scroll.worker-order-scroll .worker-order-meta.worker-order-meta image{width:15px;height:15px;flex-shrink:0;margin-top:2px;opacity:.8}
.worker-order-scroll.worker-order-scroll .worker-order-meta.worker-order-meta text{flex:1;min-width:0;overflow-wrap:anywhere}
.worker-order-process-scroll.worker-order-process-scroll{width:100%;height:70px;margin-top:14px;white-space:nowrap}
.worker-order-process-track.worker-order-process-track{display:flex;width:max-content}
.worker-order-step.worker-order-step{position:relative;width:74px;text-align:center;flex-shrink:0}
.worker-order-node.worker-order-node{width:38px;height:38px;display:flex;align-items:center;justify-content:center;margin:0 auto 5px;border:3px solid #CBD5E1;border-radius:50%;background:#F8FAFC;color:#64748B;font-size:10px;font-weight:700;font-variant-numeric:tabular-nums}
.worker-order-node.worker-order-node.is-closed.is-closed{border-color:#6EE7B7;color:#059669;background:#ECFDF5}
.worker-order-step.worker-order-step>text{display:block;color:#475569;font-size:10px;font-weight:500;line-height:18px}
.worker-order-line.worker-order-line{position:absolute;width:22px;height:1px;background:#E2E8F0;left:63px;top:18px}
.worker-order-actions.worker-order-actions{display:flex;margin-top:14px}
.worker-order-report.worker-order-report{flex:1;min-width:0;min-height:46px;line-height:46px;padding:0 20px;border-radius:15px;background:#1D4ED8;color:#fff;font-size:15px;font-weight:700;box-shadow:inset 0 1px 1px rgba(255,255,255,.34),0 5px 15px rgba(29,78,216,.18)}
.worker-order-report.worker-order-report[disabled]{opacity:.45;box-shadow:none}
.worker-order-bottom-space.worker-order-bottom-space{height:104px}
.worker-idle-report.worker-idle-report{min-height:48px;margin-top:24px;padding:12px 24px;border-radius:14px;background:#1D4ED8;color:#fff;font-size:15px;font-weight:650}
@media(max-width:350px){.worker-order-scroll.worker-order-scroll .worker-order-card.worker-order-card{margin-left:12px;margin-right:12px;padding:14px}.worker-order-scroll.worker-order-scroll .worker-order-heading.worker-order-heading{gap:8px}.worker-order-scroll.worker-order-scroll .worker-order-plan.worker-order-plan{min-width:54px}.worker-order-scroll.worker-order-scroll .worker-order-title.worker-order-title{font-size:15px}.worker-order-scroll.worker-order-scroll .worker-order-state.worker-order-state{padding-left:6px;padding-right:6px}.worker-order-scroll.worker-order-scroll .worker-order-meta.worker-order-meta{font-size:12px}}
@media(prefers-reduced-transparency:reduce){.worker-order-scroll.worker-order-scroll .worker-order-card.worker-order-card{background:#F8FBFF;backdrop-filter:none;-webkit-backdrop-filter:none}}
