/* Visual reference: the approved glass material and liquid expansion. No floating-ball UI. */
.orders-page.orders-page.glass-theme.glass-theme,.detail-page.detail-page.glass-theme.glass-theme,.glass-theme.glass-theme.dispatch-page.dispatch-page.dispatch-page-workspace.dispatch-page-workspace{background:#EDF3FB;background-image:radial-gradient(ellipse at 10% 0,rgba(199,221,255,.5),transparent 64%),radial-gradient(ellipse at 100% 90%,rgba(222,233,251,.48),transparent 60%)}
.glass-theme.glass-theme .list-header.list-header,.glass-theme.glass-theme .detail-header.detail-header,.glass-theme.glass-theme .dispatch-flow-header.dispatch-flow-header{background:rgba(250,252,255,.7);border-color:rgba(255,255,255,.92);box-shadow:inset 0 1px 1px rgba(255,255,255,.96),0 6px 20px rgba(44,77,120,.035);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.glass-theme.glass-theme .order-card.order-card,.glass-theme.glass-theme .detail-hero.detail-hero,.glass-theme.glass-theme .information-card.information-card,.glass-theme.glass-theme .detail-process-card.detail-process-card,.glass-theme.glass-theme .person-tile.person-tile,.glass-theme.glass-theme .process-card.process-card{border:1px solid rgba(255,255,255,.96);background:rgba(250,252,255,.7);box-shadow:inset 0 1px 1px rgba(255,255,255,.98),inset 0 -1px 1px rgba(166,187,215,.2),0 9px 26px rgba(42,72,117,.07);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:20px}
.glass-theme.glass-theme .order-card.order-card{padding:18px;transition:box-shadow 150ms ease;}
.glass-theme.glass-theme .section-card.section-card{border-color:rgba(255,255,255,.96);background:rgba(250,252,255,.7);box-shadow:inset 0 1px 1px rgba(255,255,255,.98),inset 0 -1px 1px rgba(166,187,215,.2),0 9px 26px rgba(42,72,117,.065);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.glass-theme.glass-theme .order-card.order-card.liquid-source.liquid-source{opacity:0;pointer-events:none}
.glass-theme.glass-theme .order-meta.order-meta{color:#53677F;font-size:13px;line-height:1.7}
.glass-theme.glass-theme .plan.plan,.glass-theme.glass-theme .quantity-grid.quantity-grid>view{background:rgba(222,237,255,.56);border-color:rgba(255,255,255,.92);box-shadow:inset 0 1px 2px rgba(255,255,255,.96);border-radius:14px}
.glass-theme.glass-theme .status-pill.status-pill,.glass-theme.glass-theme .icon-button.icon-button,.glass-theme.glass-theme .back-entry.back-entry,.glass-theme.glass-theme .refresh-entry.refresh-entry,.glass-theme.glass-theme .process-filters.process-filters button{background:rgba(255,255,255,.55);border-color:rgba(204,219,239,.52);box-shadow:inset 0 1px 1px rgba(255,255,255,.96);border-radius:14px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.glass-theme.glass-theme .status-pill.status-pill.selected.selected,.glass-theme.glass-theme .detail-tabs.detail-tabs button.active.active{background:#1D4ED8;color:#fff;border-color:rgba(255,255,255,.7);box-shadow:inset 0 1px 1px rgba(255,255,255,.3),0 5px 15px rgba(29,78,216,.2)}
.glass-theme.glass-theme .search-input.search-input,.glass-theme.glass-theme .worker-search.worker-search.people-search.people-search{background:rgba(223,233,248,.5);box-shadow:inset 0 1px 2px rgba(255,255,255,.75);border:1px solid rgba(255,255,255,.7);border-radius:13px}
.glass-theme.glass-theme .bottom-nav.bottom-nav,.glass-theme.glass-theme .detail-dock.detail-dock,.glass-theme.glass-theme .people-selection-dock.people-selection-dock,.glass-theme.glass-theme .process-dock.process-dock{background:rgba(249,252,255,.74);border-color:rgba(255,255,255,.94);box-shadow:inset 0 1px 1px #fff,0 -8px 26px rgba(55,83,124,.035);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.glass-theme.glass-theme .quick-action.quick-action,.glass-theme.glass-theme .detail-primary.detail-primary,.glass-theme.glass-theme .people-next.people-next,.glass-theme.glass-theme .process-next.process-next{border-radius:15px;box-shadow:inset 0 1px 1px rgba(255,255,255,.34),0 5px 15px rgba(29,78,216,.18)}
.glass-theme.glass-theme .detail-tabs.detail-tabs{background:rgba(255,255,255,.54);border-color:rgba(255,255,255,.94);border-radius:15px;box-shadow:inset 0 1px 2px #fff;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.glass-theme.glass-theme .process-filters.process-filters button.active.active{color:#1D4ED8;background:rgba(226,238,255,.82);border-color:rgba(123,168,231,.48)}
.glass-theme.glass-theme .person-tile.person-tile.selected.selected,.glass-theme.glass-theme .detail-process-card.detail-process-card.selected.selected,.glass-theme.glass-theme .process-card.process-card.selected.selected{border:2px solid #3B82F6;background:rgba(232,243,255,.82);box-shadow:inset 0 1px 1px #fff,0 6px 18px rgba(59,130,246,.09)}
.glass-theme.glass-theme .process-card.process-card.recommended.recommended.selected.selected{border-color:#10B981;background:rgba(235,253,247,.84)}
.glass-theme.glass-theme .detail-process-card.detail-process-card.closed.closed{background:rgba(245,248,253,.68);border-color:rgba(221,229,240,.7)}
.glass-theme.glass-theme .people-group-rail.people-group-rail{background:rgba(247,250,255,.38);border-color:rgba(204,219,239,.4)}
.glass-theme.glass-theme .people-group.people-group.active.active{background:rgba(220,235,255,.54)}
.glass-theme.glass-theme .people-topbar.people-topbar,.glass-theme.glass-theme .people-stepper.people-stepper{border-color:rgba(192,210,234,.4)}
.glass-theme.glass-theme .assignment-sheet.assignment-sheet{background:rgba(248,251,255,.94);border:1px solid rgba(255,255,255,.96);box-shadow:inset 0 1px 2px #fff,0 -15px 44px rgba(35,60,98,.12);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.glass-theme.glass-theme .thumbnail.thumbnail,.glass-theme.glass-theme .detail-picture.detail-picture{background:rgba(255,255,255,.52);border-color:rgba(223,231,243,.8);box-shadow:inset 0 1px 1px #fff}
@media(hover:hover) and (pointer:fine){.glass-theme.glass-theme .order-card.order-card:hover{box-shadow:inset 0 1px 1px #fff,0 12px 28px rgba(42,72,117,.11)}}
@media(prefers-reduced-transparency:reduce){.glass-theme.glass-theme .order-card.order-card,.glass-theme.glass-theme .detail-hero.detail-hero,.glass-theme.glass-theme .detail-process-card.detail-process-card,.glass-theme.glass-theme .person-tile.person-tile,.glass-theme.glass-theme .process-card.process-card,.glass-theme.glass-theme .list-header.list-header,.glass-theme.glass-theme .bottom-nav.bottom-nav,.glass-theme.glass-theme .detail-dock.detail-dock,.glass-theme.glass-theme .dispatch-flow-header.dispatch-flow-header{background:#F8FBFF;backdrop-filter:none;-webkit-backdrop-filter:none}}
@media(max-width:350px){.glass-theme.glass-theme .order-card.order-card{padding:14px}.glass-theme.glass-theme .order-meta.order-meta{font-size:12px}}
