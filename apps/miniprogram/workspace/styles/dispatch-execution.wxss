.dispatch-priority.dispatch-priority{flex-shrink:0;margin:8px 0 14px;padding:12px;border:1px solid rgba(221,232,246,.8);border-radius:16px;background:rgba(239,246,255,.65)}
.priority-options.priority-options{display:flex;gap:8px}.priority-options.priority-options button{flex:1;min-height:42px;border:1px solid #D3DFEE;border-radius:11px;background:rgba(255,255,255,.7);color:#64748B;font-size:13px;font-weight:650;line-height:42px}.priority-options.priority-options .chosen.chosen{border-color:#3B82F6;color:#1D4ED8;background:#E5F0FF}.priority-options.priority-options .priority-urgent.priority-urgent.chosen.chosen{border-color:#F2B66F;background:#FFF3E5;color:#A55B13}
.priority-note.priority-note{display:block;margin-top:9px;font-size:11px;color:#64748B;line-height:1.7}.pause-preview.pause-preview{margin-top:10px;padding:10px;border:1px solid #F6D5A5;border-radius:11px;background:#FFF7ED;font-size:11px;color:#9A5B16}.pause-preview.pause-preview>text{display:block;font-weight:650}.pause-preview.pause-preview>view{display:flex;gap:10px;margin-top:7px}.pause-preview.pause-preview>view>text:first-child{flex-shrink:0;font-weight:650}.pause-preview.pause-preview>view>text:last-child{min-width:0;overflow-wrap:anywhere}.dispatch-impact-error.dispatch-impact-error{margin-top:8px;color:#B45309;font-size:12px}.dispatch-impact-error.dispatch-impact-error button{display:inline-block;min-height:32px;margin-left:6px;color:#1D4ED8;font-size:11px}
