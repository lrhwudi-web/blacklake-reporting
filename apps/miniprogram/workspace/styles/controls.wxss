/* Shared glass tracks. Gesture preview is visual; business selection commits on release. */
.glass-segments.glass-segments{position:relative;display:flex;gap:0;padding:4px;border:1px solid rgba(255,255,255,.96);border-radius:18px;background:rgba(245,250,255,.62);box-shadow:inset 0 1px 2px #fff,inset 0 -1px 1px rgba(157,184,220,.16),0 3px 12px rgba(42,72,117,.035);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.glass-segments.glass-segments .segment-lens.segment-lens{position:absolute;left:4px;top:4px;bottom:4px;width:calc((100% - 8px)/4);border:1px solid rgba(255,255,255,.98);border-radius:14px;background:linear-gradient(150deg,rgba(252,255,255,.92),rgba(209,229,255,.64));box-shadow:inset 0 1px 2px #fff,inset 0 -1px 1px rgba(140,173,217,.18),0 3px 10px rgba(54,92,145,.09);pointer-events:none;transition:transform 150ms cubic-bezier(.23,1,.32,1),opacity 100ms ease}
.glass-segments.glass-segments.segment-three.segment-three .segment-lens.segment-lens{width:calc((100% - 8px)/3)}
.glass-segments.glass-segments.segment-two.segment-two .segment-lens.segment-lens{width:calc((100% - 8px)/2)}
.glass-segments.glass-segments.segment-fast.segment-fast .segment-lens.segment-lens{transition-duration:100ms,100ms}
.glass-segments.glass-segments.segment-priority.segment-priority .segment-lens.segment-lens{transition-duration:120ms,100ms}
.glass-segments.glass-segments.segment-priority.segment-priority.urgent.urgent .segment-lens.segment-lens{background:linear-gradient(145deg,#FFFBF3,rgba(255,226,187,.78));border-color:#F4CD96;box-shadow:inset 0 1px 2px #fff,0 2px 9px rgba(161,100,31,.08)}
.glass-segments.glass-segments .segment-option.segment-option{position:relative;z-index:1;flex:1;min-width:0;min-height:44px;display:flex;align-items:center;justify-content:center;padding:0 6px;border:0;border-radius:14px;background:transparent;color:#657890;font-size:12px;font-weight:550;line-height:1.4;white-space:nowrap;box-shadow:none}
.glass-segments.glass-segments .segment-option.segment-option.active.active{color:#1D4ED8;font-weight:700;background:transparent;box-shadow:none}
.glass-segments.glass-segments.segment-priority.segment-priority.urgent.urgent .segment-option.segment-option.active.active{color:#9A5A12}
.glass-segments.glass-segments .segment-option.segment-option[disabled]{opacity:.42}
.glass-segments.glass-segments .segment-option.segment-option:active{opacity:.65}
.glass-segments.glass-segments.segment-interactive.segment-interactive{overflow:visible;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.glass-segments.glass-segments.segment-interactive.segment-interactive .segment-lens.segment-lens{transition:none!important;transform-origin:50% 50%;will-change:transform}
.glass-segments.glass-segments.segment-interactive.segment-interactive .segment-label.segment-label{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;transform-origin:50% 50%;pointer-events:none}
.glass-segments.glass-segments.segment-interactive.segment-interactive .segment-option.segment-option:active{opacity:1}
.glass-segments.glass-segments.segment-interactive.segment-interactive.is-pressed.is-pressed .segment-lens.segment-lens{background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(207,229,255,.72));box-shadow:inset 0 1px 2px #fff,inset 0 -1px 2px rgba(126,167,219,.24),0 5px 16px rgba(40,84,145,.17)}
.glass-theme.glass-theme .glass-segments.glass-segments.segment-interactive.segment-interactive.is-pressed.is-pressed .segment-option.segment-option{color:#657890}
.glass-theme.glass-theme .glass-segments.glass-segments.segment-interactive.segment-interactive.is-pressed.is-pressed .segment-option.segment-option.segment-hover.segment-hover{color:#1D4ED8}
.glass-theme.glass-theme .glass-segments.glass-segments.segment-interactive.segment-interactive.segment-priority.segment-priority.is-pressed.is-pressed .priority-urgent.priority-urgent.segment-hover.segment-hover{color:#9A5A12}
.glass-theme.glass-theme .detail-tabs.detail-tabs.glass-segments.glass-segments .segment-option.segment-option,.glass-theme.glass-theme .process-filters.process-filters.glass-segments.glass-segments .segment-option.segment-option{border:0;background:transparent;box-shadow:none;color:#657890;line-height:1.4}
.glass-theme.glass-theme .detail-tabs.detail-tabs.glass-segments.glass-segments .segment-option.segment-option.active.active,.glass-theme.glass-theme .process-filters.process-filters.glass-segments.glass-segments .segment-option.segment-option.active.active{color:#1D4ED8;background:transparent;box-shadow:none}
.glass-theme.glass-theme .process-filters.process-filters.glass-segments.glass-segments{margin:10px 16px;padding:4px;gap:0}
.priority-options.priority-options.glass-segments.glass-segments{gap:0}
.priority-options.priority-options.glass-segments.glass-segments .segment-option.segment-option{border:0;background:transparent;box-shadow:none}
.dispatch-reduced.dispatch-reduced .segment-lens.segment-lens{transition:none!important}
.segment-reduced.segment-reduced .segment-lens.segment-lens,.liquid-reduced.liquid-reduced .segment-lens.segment-lens{transition:none!important}
@media(prefers-reduced-motion:reduce){.glass-segments.glass-segments .segment-lens.segment-lens{transition:none!important}}
@media(prefers-reduced-transparency:reduce){.glass-segments.glass-segments{background:#F4F8FD;backdrop-filter:none;-webkit-backdrop-filter:none}.glass-segments.glass-segments .segment-lens.segment-lens{background:#E5F0FF}}
@media(prefers-contrast:more){.glass-segments.glass-segments{background:#F8FBFF;border-color:#B2C6DF}.glass-segments.glass-segments .segment-lens.segment-lens{border-color:#1D4ED8;background:#E2EDFC}}
