.nav-platter.nav-platter { position:absolute;inset:0;border-radius:31px;transform-origin:50% 50%;overflow:visible; }
.nav-finger-glow.nav-finger-glow { position:absolute;left:0;top:-15.5px;width:93px;height:93px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.95),rgba(255,255,255,.08) 65%,transparent 72%);pointer-events:none; }
.nav-glass-base.nav-glass-base { position:absolute;inset:0;border-radius:31px;border:1px solid rgba(255,255,255,.78);background:linear-gradient(165deg,rgba(255,255,255,.56),rgba(245,250,255,.24) 50%,rgba(234,243,255,.44));box-shadow:inset 0 1px 1px rgba(255,255,255,.98),inset 0 -1px 1px rgba(98,125,162,.12),0 9px 30px rgba(40,64,98,.16),0 1px 3px rgba(40,64,98,.08);backdrop-filter:blur(18px) saturate(165%);-webkit-backdrop-filter:blur(18px) saturate(165%);pointer-events:none; }
.nav-item.nav-item,.nav-tinted-item.nav-tinted-item { position:absolute;top:4px;height:54px;min-height:44px;display:flex;align-items:center;justify-content:center;border-radius:27px;color:#53657C;font-size:10px;font-weight:500;line-height:12px;letter-spacing:.1px; }
.nav-item.nav-item { z-index:1; }
.nav-symbols.nav-symbols { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;pointer-events:none;transform-origin:50% 50%; }
.nav-symbols.nav-symbols image { display:block;width:26px;height:26px; }
.nav-lens.nav-lens { position:absolute;z-index:2;left:0;top:4px;height:54px;border-radius:27px;pointer-events:none; }
.nav-lens-surface.nav-lens-surface { position:absolute;inset:0;border-radius:27px;background:linear-gradient(155deg,rgba(246,251,255,.78),rgba(204,225,251,.42) 58%,rgba(236,246,255,.64));border:1px solid rgba(255,255,255,.88);box-shadow:inset 1px 1px 2px rgba(255,255,255,.98),inset -1px -1px 2px rgba(142,172,211,.2),0 2px 7px rgba(65,100,145,.1);transform-origin:50% 50%; }
.bottom-nav.bottom-nav.is-pressed.is-pressed .nav-lens-surface.nav-lens-surface { box-shadow:inset 1px 1px 2px #fff,inset -1px -1px 3px rgba(138,167,211,.22),0 5px 16px rgba(55,87,133,.16); }
.nav-lens-window.nav-lens-window { position:absolute;inset:0;overflow:hidden;border-radius:27px; }
.nav-lens-counter.nav-lens-counter { position:absolute;inset:0;transform-origin:50% 50%; }
.nav-tinted-track.nav-tinted-track { position:absolute;left:0;top:-4px;height:62px; }
.nav-tinted-item.nav-tinted-item { color:#1D4ED8;font-weight:600; }
.nav-reduced.nav-reduced .nav-symbols.nav-symbols,.nav-reduced.nav-reduced .nav-lens-surface.nav-lens-surface,.nav-reduced.nav-reduced .nav-lens-window.nav-lens-window,.nav-reduced.nav-reduced .nav-lens-counter.nav-lens-counter,.nav-reduced.nav-reduced .nav-platter.nav-platter { transform:none!important; }
@media(prefers-reduced-motion:reduce){.bottom-nav.bottom-nav .nav-symbols.nav-symbols,.bottom-nav.bottom-nav .nav-lens-surface.nav-lens-surface,.bottom-nav.bottom-nav .nav-lens-window.nav-lens-window,.bottom-nav.bottom-nav .nav-lens-counter.nav-lens-counter,.bottom-nav.bottom-nav .nav-platter.nav-platter{transform:none!important;}}
@media(prefers-reduced-transparency:reduce){.nav-glass-base.nav-glass-base{background:#F8FBFF;backdrop-filter:none;-webkit-backdrop-filter:none;}.nav-lens-surface.nav-lens-surface{background:#E3EEFC;}}
@media(prefers-contrast:more){.nav-glass-base.nav-glass-base{background:#F8FBFF;border-color:#53657C;backdrop-filter:none;-webkit-backdrop-filter:none;}.nav-lens-surface.nav-lens-surface{background:#E3EEFC;border-color:#1D4ED8;}}
