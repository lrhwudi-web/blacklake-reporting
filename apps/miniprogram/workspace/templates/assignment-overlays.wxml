<view class="report-menu-mask" wx:if="{{assignmentMenu}}" catchtap="closeAssignmentMenu" catchtouchmove="closeAssignmentMenu"/>
<view class="report-action-menu {{assignmentMenuOpen ? 'is-open' : ''}} {{reduceMotion ? 'menu-reduced' : ''}}" data-anchor="{{assignmentMenu.anchorId}}" wx:if="{{assignmentMenu}}" style="left:{{assignmentMenu.x}}px;top:{{assignmentMenu.y}}px;width:{{assignmentMenu.width}}px;transform-origin:{{assignmentMenu.originX}}px {{assignmentMenu.originY}}px" aria-role="menu" aria-label="派工操作" aria-hidden="{{!assignmentMenuOpen}}" catchtap="stopAssignmentBubble">
  <view class="report-menu-arrow arrow-{{assignmentMenu.side}}" style="{{assignmentMenu.arrowStyle}}"/>
  <view class="report-menu-surface"><button size="mini" wx:for="{{assignmentMenu.options}}" wx:key="action" class="native-button report-menu-item {{item.action === 'cancelAssignment' ? 'is-danger' : ''}}" data-action="{{item.action}}" catchtap="chooseAssignmentAction" disabled="{{!assignmentMenuOpen || actionBusy || item.disabled}}" aria-role="menuitem"><image class="queue-menu-icon" wx:if="{{item.icon === 'insert' || item.icon === 'sort'}}" src="{{item.icon === 'insert' ? '/workspace/assets/ui-circle-plus.png' : '/workspace/assets/ui-sort-descending.png'}}"/><view class="report-menu-icon icon-{{item.icon}}" wx:else><view class="pencil-body" wx:if="{{item.icon === 'edit'}}"/><view class="trash-body" wx:elif="{{item.icon === 'delete'}}"><view class="trash-lid"/><view class="trash-handle"/></view></view><text>{{item.label}}</text></button></view>
</view>
<view class="assignment-mask {{assignmentPanelOpen ? 'is-open' : ''}} {{reduceMotion ? 'assignment-reduced' : ''}}" wx:if="{{assignmentPanel}}" catchtap="closeAssignmentPanel" catchtouchmove="stopAssignmentBubble"/>
<view class="assignment-panel {{assignmentPanelOpen ? 'is-open' : ''}} {{assignmentPanel.action === 'cancelAssignment' ? 'assignment-cancel-panel' : ''}} {{reduceMotion ? 'assignment-reduced' : ''}}" wx:if="{{assignmentPanel && assignmentPanel.action !== 'queue'}}" aria-role="dialog" aria-label="{{assignmentSelection === 'people' ? '选择人员' : assignmentSelection === 'process' ? '选择工序' : assignmentSelection === 'unit' ? '选择工位' : assignmentPanel.title}}" aria-modal="true" aria-hidden="{{!assignmentPanelOpen}}" catchtap="stopAssignmentBubble">
  <view class="report-panel-heading"><view><text>{{assignmentSelection === 'people' ? '选择人员' : assignmentSelection === 'process' ? '选择工序' : assignmentSelection === 'unit' ? '选择工位' : assignmentPanel.title}}</text><text>{{assignmentPanel.orderCode}} · {{assignmentPanel.workerName}}</text></view><button size="mini" class="native-button" bindtap="closeAssignmentPanel" disabled="{{actionBusy}}" aria-label="{{assignmentSelection ? '返回派工编辑' : '关闭派工面板'}}"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <view class="assignment-form" wx:if="{{!assignmentSelection && assignmentPanel.action === 'editAssignment'}}">
    <view class="editor-group">
      <button size="mini" class="native-button editor-row assignment-field" data-selection="people" bindtap="openAssignmentSelection" disabled="{{actionBusy}}"><text>人员</text><view><text>{{assignmentDraft.workerName}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
      <button size="mini" class="native-button editor-row assignment-field" data-selection="process" bindtap="openAssignmentSelection" disabled="{{actionBusy}}"><text>工序</text><view><text>{{assignmentDraft.processName}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
      <button size="mini" class="native-button editor-row assignment-field" data-selection="unit" bindtap="openAssignmentSelection" disabled="{{actionBusy}}"><text>工位</text><view><text>{{assignmentDraft.unitId || '请选择工位'}}</text><image src="/workspace/assets/ui-chevron-down.png"/></view></button>
    </view>
    <view mark:backIgnore="{{true}}" id="segment-assignmentPriority" class="assignment-priority glass-segments segment-two segment-interactive {{segmentTracks.assignmentPriority.pressed ? 'is-pressed' : ''}} {{reduceMotion ? 'segment-reduced' : ''}}" data-segment="assignmentPriority" bindtouchstart="onGlassSegmentStart" catchtouchmove="onGlassSegmentMove" bindtouchend="onGlassSegmentEnd" bindtouchcancel="onGlassSegmentCancel" aria-role="tablist" aria-label="派工优先级">
      <view class="segment-lens {{assignmentDraft.priority === 'URGENT' ? 'assignment-urgent-lens' : ''}}" style="transform:translate3d({{segmentTracks.assignmentPriority ? segmentTracks.assignmentPriority.x + 'px' : assignmentDraft.priority === 'URGENT' ? '100%' : '0%'}},0,0) scale({{segmentTracks.assignmentPriority ? segmentTracks.assignmentPriority.scaleX : 1}},{{segmentTracks.assignmentPriority ? segmentTracks.assignmentPriority.scaleY : 1}})" aria-hidden="true"/>
      <button size="mini" class="native-button segment-option {{assignmentDraft.priority === 'NORMAL' ? 'active' : ''}}" data-segment="assignmentPriority" data-index="0" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{assignmentDraft.priority === 'NORMAL'}}" disabled="{{actionBusy}}"><view class="segment-label" style="transform:scale({{segmentTracks.assignmentPriority.scales[0] || 1}})">普通派工</view></button>
      <button size="mini" class="native-button segment-option {{assignmentDraft.priority === 'URGENT' ? 'active assignment-urgent' : ''}}" data-segment="assignmentPriority" data-index="1" bindtap="onGlassSegmentTap" aria-role="tab" aria-selected="{{assignmentDraft.priority === 'URGENT'}}" disabled="{{actionBusy}}"><view class="segment-label" style="transform:scale({{segmentTracks.assignmentPriority.scales[1] || 1}})">加急插单</view></button>
    </view>
    <text class="assignment-note" wx:if="{{assignmentPanel.hasHistory && (assignmentDraft.workerId !== assignmentPanel.workerId || assignmentDraft.processId !== assignmentPanel.processId)}}">原任务与报工保留，修改后的任务待员工开始。</text>
    <text class="assignment-note assignment-note-urgent" wx:elif="{{assignmentDraft.priority === 'URGENT'}}">暂停该员工当前任务；原任务重新排到第一位后，员工可点击开始。</text>
  </view>
  <view class="assignment-cancel-copy" wx:elif="{{!assignmentSelection}}"><text>撤销{{assignmentPanel.workerName}}的「{{assignmentPanel.processName}}」派工？</text><text>{{assignmentPanel.wasRunning ? '撤销后停止计时，' : ''}}已有报工记录保留。</text></view>
  <view class="assignment-selection" wx:else>
    <view class="report-people-search"><image src="/workspace/assets/people-search.png"/><input mark:backIgnore="{{true}}" value="{{assignmentQuery}}" bindinput="onAssignmentSearch" placeholder="{{assignmentSelection === 'people' ? '搜索姓名或部门' : assignmentSelection === 'process' ? '搜索工序' : '搜索工位'}}" aria-label="搜索派工选项"/></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="assignment-choice-scroll" scroll-y="true">
      <block wx:if="{{assignmentSelection === 'people'}}"><view class="report-department" wx:for="{{assignmentGroups}}" wx:for-item="department" wx:key="key"><button size="mini" class="native-button report-department-heading {{department.expanded ? 'expanded' : ''}}" data-key="{{department.key}}" bindtap="toggleAssignmentDepartment" aria-expanded="{{department.expanded}}"><text>{{department.name}}</text><text>{{department.count}}人</text><image src="/workspace/assets/ui-chevron-down.png"/></button><view class="report-department-body {{department.expanded ? 'expanded' : ''}}" style="height:{{department.height}}px" aria-hidden="{{!department.expanded}}"><view class="report-department-members"><button size="mini" class="native-button report-person {{person.selected ? 'selected' : ''}}" wx:for="{{department.members}}" wx:for-item="person" wx:key="id" data-id="{{person.id}}" bindtap="selectAssignmentChoice" disabled="{{!department.expanded || actionBusy}}"><view class="report-person-avatar">{{person.initial}}</view><text>{{person.name}}</text><text class="report-person-selected" wx:if="{{person.selected}}">已选</text></button></view></view></view><text class="report-people-empty" wx:if="{{!assignmentGroups.length}}">暂无匹配人员</text></block>
      <block wx:else><button size="mini" class="native-button assignment-choice {{item.selected ? 'selected' : ''}}" wx:for="{{assignmentChoices}}" wx:key="id" data-id="{{item.id}}" bindtap="selectAssignmentChoice" disabled="{{item.disabled || actionBusy}}"><text>{{item.name}}</text><text>{{item.disabled ? '不可选' : item.selected ? '已选' : ''}}</text></button><text class="report-people-empty" wx:if="{{!assignmentChoices.length}}">暂无匹配选项</text></block>
    </scroll-view>
  </view>
  <view class="assignment-footer" wx:if="{{!assignmentSelection}}"><view class="assignment-error" wx:if="{{assignmentError}}" aria-role="alert"><text>{{assignmentError}}</text><button size="mini" class="native-button" bindtap="refreshAssignmentDraft" disabled="{{actionBusy || executionLoading}}">重新核对</button></view><button size="mini" class="native-button assignment-save {{assignmentPanel.action === 'cancelAssignment' ? 'assignment-danger' : ''}}" bindtap="confirmAssignmentChange" disabled="{{actionBusy || executionLoading || !assignmentPanelOpen}}">{{actionBusy ? '处理中…' : assignmentPanel.action === 'cancelAssignment' ? '确认撤销' : '保存修改'}}</button></view>
</view>
<view class="assignment-panel queue-panel {{assignmentPanelOpen ? 'is-open' : ''}} {{reduceMotion ? 'assignment-reduced' : ''}}" wx:if="{{assignmentPanel.action === 'queue'}}" aria-role="dialog" aria-label="{{queueStep === 'queue' ? '调整工单顺序' : queueStep === 'confirm' ? '确认插单' : '选择插单任务'}}" aria-modal="true" aria-hidden="{{!assignmentPanelOpen}}" catchtap="stopAssignmentBubble">
  <view class="queue-heading"><button size="mini" wx:if="{{queueStep !== 'queue'}}" class="native-button queue-back" bindtap="backQueueStep" disabled="{{actionBusy || queueLoading}}" aria-label="返回待办安排"><image src="/workspace/assets/ui-chevron-down.png"/></button><view><text>{{queueStep === 'queue' ? '工单顺序' : queueStep === 'confirm' ? '确认插单' : '插单'}}</text><text>{{assignmentPanel.workerName}}</text></view><button size="mini" class="native-button queue-close" bindtap="closeQueuePanel" disabled="{{actionBusy || queueLoading}}" aria-label="关闭待办安排"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" class="queue-body" scroll-y="true" show-scrollbar="{{false}}">
    <block wx:if="{{queueStep === 'queue'}}">
      <view class="queue-section-title"><text>工单 {{queueRows.length}}</text><text>首位为员工当前</text></view>
      <view class="queue-sort-list" style="height:{{queueRows.length * 112}}px">
        <view wx:for="{{queueRows}}" wx:key="id" class="queue-sort-row queue-work-card {{item.isEmployeeCurrent ? 'is-employee-current' : ''}} {{item.queueHeld ? 'is-dragging' : ''}} {{reduceMotion ? 'queue-reduced' : ''}}" style="transform:translate3d(0,{{item.queueY}}px,0) scale({{item.queueHeld && !reduceMotion ? 1.02 : 1}})">
          <button size="mini" mark:backIgnore="{{true}}" class="native-button queue-handle" data-id="{{item.id}}" bindtouchstart="onQueueDragStart" catchtouchmove="onQueueDragMove" bindtouchend="onQueueDragEnd" bindtouchcancel="onQueueDragCancel" catchtap="stopQueueTap" disabled="{{actionBusy || !!assignmentPanel.blockedReason}}" aria-label="长按拖动{{item.processName}}"><image src="/workspace/assets/ui-grip-vertical.png"/></button>
          <view class="queue-work-copy"><view><text>{{item.processName}}</text><text class="task-current-badge" wx:if="{{item.isEmployeeCurrent}}">员工当前</text></view><text>{{item.assignedShort}} 派工 · 已生产 {{item.elapsedShortText}}</text><text>工单编号 {{item.orderCode}}</text></view>
          <view class="queue-work-state"><text class="state-{{item.status}}">{{item.statusText}}</text><button size="mini" class="native-button queue-inline-insert" wx:if="{{item.status === 'READY' || item.status === 'PAUSED'}}" data-id="{{item.id}}" bindtap="chooseQueuedInsert" disabled="{{actionBusy || queueLoading}}">插单</button></view>
          <view class="queue-movers"><button size="mini" class="native-button" data-id="{{item.id}}" data-delta="-1" bindtap="moveQueueItem" disabled="{{item.queueNumber === 1 || actionBusy || !!assignmentPanel.blockedReason}}" aria-label="上移{{item.processName}}"><image src="/workspace/assets/ui-chevron-down.png"/></button><button size="mini" class="native-button" data-id="{{item.id}}" data-delta="1" bindtap="moveQueueItem" disabled="{{item.queueNumber === queueRows.length || actionBusy || !!assignmentPanel.blockedReason}}" aria-label="下移{{item.processName}}"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
        </view>
      </view>
      <text class="queue-empty" wx:if="{{!queueRows.length}}">暂无可安排工单</text>
      <text class="queue-blocked" wx:if="{{assignmentPanel.blockedReason}}">{{assignmentPanel.blockedReason}}</text>
      <view class="queue-section-title" wx:if="{{queuePaused.length}}"><text>已暂停 {{queuePaused.length}}</text></view>
      <view class="queue-paused-row" wx:for="{{queuePaused}}" wx:key="id"><view class="queue-row-copy"><text>{{item.processName}}</text><text>{{item.orderCode}}</text></view><button size="mini" class="native-button queue-inline-insert" data-id="{{item.id}}" bindtap="chooseQueuedInsert" disabled="{{actionBusy || queueLoading}}">插单</button></view>
    </block>
    <block wx:elif="{{queueStep === 'orders'}}">
      <view class="queue-existing" wx:if="{{queueInsertChoices.length}}"><text class="queue-section-label">已有任务</text><button size="mini" wx:for="{{queueInsertChoices}}" wx:key="id" class="native-button queue-option" data-id="{{item.id}}" bindtap="chooseQueuedInsert"><view class="queue-row-copy"><text>{{item.processName}}</text><text>{{item.orderCode}}</text></view><text>{{item.status === 'PAUSED' ? '已暂停' : '插单'}}</text></button></view>
      <text class="queue-section-label">新工单</text><view class="queue-search"><image src="/workspace/assets/people-search.png"/><input mark:backIgnore="{{true}}" value="{{queueQuery}}" bindinput="onQueueQuery" placeholder="工单编号、产品" aria-label="查找插单工单"/></view>
      <button size="mini" class="native-button queue-option" wx:for="{{queueOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseQueueOrder" disabled="{{actionBusy || queueLoading}}"><view class="queue-row-copy"><text>{{item.code}}</text><text>{{item.product}}</text></view><image class="queue-chevron" src="/workspace/assets/ui-chevron-down.png"/></button><text class="queue-empty" wx:if="{{queueProcessLoading}}">正在读取所选工单的工序…</text><text class="queue-empty" wx:elif="{{queueCatalogLoading}}">正在查找工单…</text><text class="queue-empty" wx:elif="{{!queueOrders.length && !queueError}}">暂无匹配工单</text><button size="mini" wx:if="{{queueOrdersMore && !queueCatalogLoading && !queueProcessLoading}}" class="native-button queue-add" bindtap="loadMoreQueueOrders">加载更多工单</button>
    </block>
    <block wx:elif="{{queueStep === 'process'}}"><text class="queue-section-label">选择工序</text><button size="mini" class="native-button queue-process-option" wx:for="{{queueProcesses}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseQueueProcess" disabled="{{queueLoading || actionBusy}}"><text>{{item.name}}</text><image class="queue-chevron" src="/workspace/assets/ui-chevron-down.png"/></button><text class="queue-empty" wx:if="{{!queueProcesses.length}}">暂无可插单工序，已有任务可返回选择。</text><text class="queue-empty" wx:if="{{queueLoading}}">正在核对…</text></block>
    <block wx:else><view class="queue-confirm-target"><text>{{queueTarget.processName}}</text><text>{{queueTarget.orderCode}}</text></view><view class="queue-impact" wx:if="{{queueImpact.length}}"><text>将暂停当前任务</text><view wx:for="{{queueImpact}}" wx:key="id"><text>{{item.processName}}</text><text>{{item.orderCode}}</text></view></view><text class="queue-confirm-note">自动放到第一位，显示在员工端。员工点击开始后计时，原任务和报工保留。</text></block>
  </scroll-view>
  <view class="queue-footer"><view class="queue-error" wx:if="{{queueError}}" aria-role="alert"><text>{{queueError}}</text><button size="mini" class="native-button" bindtap="retryQueueStep" disabled="{{actionBusy || queueLoading}}">重新核对</button></view><view class="queue-footer-buttons" wx:if="{{queueStep === 'queue'}}"><button size="mini" class="native-button queue-add" bindtap="startQueueInsert" disabled="{{actionBusy || queueLoading}}"><image src="/workspace/assets/ui-circle-plus.png"/><text>新增插单</text></button><button size="mini" class="native-button queue-save" data-kind="sort" bindtap="applyTaskQueue" disabled="{{!queueDirty || actionBusy || queueLoading || !!assignmentPanel.blockedReason}}">{{actionBusy ? '保存中…' : '保存顺序'}}</button></view><button size="mini" class="native-button queue-save queue-confirm" wx:elif="{{queueStep === 'confirm'}}" data-kind="insert" bindtap="applyTaskQueue" disabled="{{actionBusy || queueLoading}}">{{actionBusy ? '处理中…' : '确认插单'}}</button></view>
</view>
