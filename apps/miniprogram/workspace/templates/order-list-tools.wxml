<block wx:if="{{listPanel}}">
  <view class="order-list-mask {{listOpen ? 'is-open' : ''}}" bindtap="closeOrderListTool"/>
  <view class="order-list-material {{listOpen ? 'is-open' : ''}}" style="{{listPanel.boxStyle}}transform:{{reduceMotion || listOpen ? listPanel.openTransform : listPanel.closedTransform}};border-radius:{{listOpen ? '24px' : listPanel.closedRadius}}" aria-hidden="true"/>
  <view class="order-list-sheet {{listOpen ? 'is-open' : ''}}" style="{{listPanel.boxStyle}}clip-path:{{reduceMotion || listOpen ? 'inset(0 round 24px)' : listPanel.closedClip}}" aria-role="dialog" aria-label="{{listPanel.title}}" aria-modal="true" aria-hidden="{{!listOpen}}">
    <view class="order-list-heading"><text>{{listPanel.title}}</text><button size="mini" class="native-button" bindtap="closeOrderListTool" aria-label="收起工单工具"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="order-list-body" scroll-y="true">
      <view class="order-list-options" wx:if="{{listPanel.kind !== 'filter'}}" aria-role="radiogroup" aria-label="{{listPanel.title}}"><button size="mini" wx:for="{{listOptions}}" wx:key="key" class="native-button {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="chooseOrderListOption" aria-role="radio" aria-checked="{{item.selected}}" disabled="{{listClosing || listScopeLoading || !listOpen}}"><text>{{item.label}}</text><image wx:if="{{item.selected}}" src="/workspace/assets/step-check.png"/></button></view>
      <block wx:else><text class="order-list-label">状态</text><view class="order-list-filter-options" aria-role="radiogroup" aria-label="筛选工单状态"><button size="mini" wx:for="{{listStatuses}}" wx:key="key" class="native-button {{listDraft.status === item.key ? 'selected' : ''}}" data-field="status" data-key="{{item.key}}" bindtap="chooseOrderListFilter" aria-role="radio" aria-checked="{{listDraft.status === item.key}}">{{item.label}}</button></view><text class="order-list-label">优先级</text><view class="order-list-filter-options" aria-role="radiogroup" aria-label="筛选工单优先级"><button size="mini" wx:for="{{listPriorities}}" wx:key="key" class="native-button {{listDraft.priority === item.key ? 'selected' : ''}}" data-field="priority" data-key="{{item.key}}" bindtap="chooseOrderListFilter" aria-role="radio" aria-checked="{{listDraft.priority === item.key}}">{{item.label}}</button></view></block>
      <text class="order-list-loading" wx:if="{{listScopeLoading}}">正在读取本人派工记录…</text><view class="order-list-error" wx:if="{{listError}}" aria-role="alert"><text>{{listError}}</text><button size="mini" class="native-button" bindtap="loadOwnedOrderIds" disabled="{{listScopeLoading}}">重新读取</button></view>
    </scroll-view>
    <view class="order-list-footer" wx:if="{{listPanel.kind === 'filter'}}"><button size="mini" class="native-button" bindtap="resetOrderListFilter" disabled="{{listClosing}}">重置</button><button size="mini" class="native-button" bindtap="applyOrderListFilter" disabled="{{listClosing}}">应用筛选</button></view>
  </view>
</block>
