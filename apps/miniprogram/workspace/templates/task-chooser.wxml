<view class="task-chooser-mask {{taskChooserOpen ? 'is-open' : ''}}" wx:if="{{taskChooser}}" catchtap="closeTaskChooser" catchtouchmove="stopTaskChooserBubble"/>
<view class="task-chooser {{taskChooserOpen ? 'is-open' : ''}} {{reduceMotion ? 'chooser-reduced' : ''}}" wx:if="{{taskChooser}}" aria-role="dialog" aria-label="{{taskChooser.title}}" aria-modal="true" aria-hidden="{{!taskChooserOpen}}" catchtap="stopTaskChooserBubble">
  <view class="task-chooser-heading"><text>{{taskChooser.title}}</text><button size="mini" class="native-button" bindtap="closeTaskChooser" aria-label="关闭筛选"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="task-chooser-body" scroll-y="true" style="height:{{(taskChooser.kind === 'date' || taskChooser.kind === 'history-date') ? 360 : taskChooser.options.length * 44}}px">
    <button size="mini" class="native-button task-chooser-option {{item.selected ? 'selected' : ''}}" wx:for="{{taskChooser.options}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseTaskOption" aria-pressed="{{item.selected}}"><text>{{item.label}}</text><text wx:if="{{item.selected}}">已选</text></button>
    <view class="task-custom-date" wx:if="{{taskChooser.kind === 'date' || taskChooser.kind === 'history-date'}}"><text>自选日期</text><view class="task-date-pickers"><picker mark:backIgnore="{{true}}" mode="date" value="{{taskDateDraft.start}}" data-field="start" bindchange="onTaskDateChange" aria-label="{{taskChooser.kind === 'history-date' ? '历史开始日期' : '报工开始日期'}}"><view><text>开始</text><text>{{taskDateDraft.start || '选择日期'}}</text></view></picker><picker mark:backIgnore="{{true}}" mode="date" value="{{taskDateDraft.end}}" data-field="end" bindchange="onTaskDateChange" aria-label="{{taskChooser.kind === 'history-date' ? '历史结束日期' : '报工结束日期'}}"><view><text>结束</text><text>{{taskDateDraft.end || '选择日期'}}</text></view></picker></view><text class="task-date-error" wx:if="{{taskDateError}}">{{taskDateError}}</text><button size="mini" class="native-button task-date-apply" bindtap="applyTaskDates">应用日期</button><view class="task-record-states" wx:if="{{taskChooser.kind === 'date'}}"><button size="mini" class="native-button {{!showDeleted ? 'selected' : ''}}" data-deleted="false" bindtap="chooseTaskDeleted" aria-pressed="{{!showDeleted}}">有效记录</button><button size="mini" class="native-button {{showDeleted ? 'selected' : ''}}" data-deleted="true" bindtap="chooseTaskDeleted" aria-pressed="{{showDeleted}}">已删除 {{deletedCount}}</button></view></view>
  </scroll-view>
  <view class="task-chooser-footer"><text>{{sourceLabel}}{{updatedLabel ? ' · 已加载资料' : ''}}</text><button size="mini" class="native-button" bindtap="refreshFromTaskChooser" disabled="{{executionLoading || actionBusy}}">刷新资料</button></view>
</view>
