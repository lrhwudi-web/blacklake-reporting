<view wx:if="{{clockoutPanel}}" class="clockout-mask {{clockoutOpen ? 'is-open' : ''}}" bindtap="closeClockout"/>
<view wx:if="{{clockoutPanel}}" class="clockout-material {{clockoutOpen ? 'is-open' : ''}} {{!clockoutMotion || reduceMotion ? 'clockout-fade' : ''}} {{!clockoutOpen && !clockoutClosing ? 'is-preparing' : ''}}" style="{{clockoutMotion ? clockoutMotion.boxStyle : ''}}transform:{{clockoutMotion ? (clockoutOpen ? clockoutMotion.openTransform : clockoutMotion.closedTransform) : 'none'}};border-radius:{{clockoutOpen || !clockoutMotion ? '28px' : clockoutMotion.closedRadius}};" aria-hidden="true"/>
<view wx:if="{{clockoutPanel}}" class="clockout-sheet {{clockoutOpen ? 'is-open' : ''}} {{reduceMotion ? 'clockout-reduced' : ''}}" style="clip-path:{{clockoutMotion ? (clockoutOpen ? 'inset(0px 0px 0px 0px round 28px)' : clockoutMotion.closedClip) : 'none'}};" aria-role="dialog" aria-modal="true" aria-label="{{clockoutView === 'schedule' ? '定时下班' : '一键下班'}}" aria-hidden="{{!clockoutOpen}}" data-anchor="nav-clockout">
  <view class="clockout-header"><button size="mini" wx:if="{{clockoutView === 'schedule'}}" class="native-button clockout-back" bindtap="backClockout" disabled="{{clockoutBusy}}" aria-label="返回下班"><text>‹</text></button><view><text class="clockout-title">{{clockoutView === 'schedule' ? '定时下班' : '下班'}}</text><text class="clockout-caption">{{clockoutView === 'schedule' ? '北京时间' : '暂停组员当前报工计时'}}</text></view><button size="mini" class="native-button clockout-close" bindtap="closeClockout" disabled="{{clockoutBusy}}" aria-label="关闭下班面板"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="clockout-body" scroll-y="true">
    <block wx:if="{{clockoutView === 'overview'}}">
      <view class="clockout-team"><text wx:for="{{clockoutPanel.groups}}" wx:key="id">{{item.name}}</text><text wx:if="{{!clockoutPanel.groups.length && !clockoutLoading}}">尚未分配负责分类</text></view>
      <view class="clockout-stats"><view><text class="clockout-number">{{clockoutLoading ? '—' : clockoutPanel.workingEmployeeCount || 0}}</text><text>正在计时</text></view><view class="clockout-stat-divider"/><view><text class="clockout-number">{{clockoutLoading ? '—' : clockoutPanel.taskCount}}</text><text>待暂停计时</text></view></view>
      <text class="clockout-scope" wx:if="{{clockoutPanel.groups.length}}">所属 {{clockoutPanel.employeeCount}} 人 · 计时已暂停 {{clockoutPanel.alreadyPausedCount}} 项</text>
      <text class="clockout-empty-team" wx:if="{{!clockoutPanel.groups.length && !clockoutLoading}}">在后台「人员分类」中设置负责组长</text>
      <view wx:if="{{clockoutResult}}" class="clockout-success"><image src="/workspace/assets/step-check.png"/><text>已暂停 {{clockoutResult.pausedCount}} 项计时</text></view>
      <button size="mini" class="native-button clockout-primary" bindtap="confirmClockout" disabled="{{clockoutBusy || clockoutLoading || clockoutError || !clockoutPanel.groups.length || !clockoutPanel.taskCount}}">{{clockoutBusy ? '正在暂停…' : clockoutResult && !clockoutPanel.taskCount ? '计时已暂停' : '一键下班'}}</button>
      <button size="mini" class="native-button clockout-schedule-row" bindtap="editClockoutSchedule" disabled="{{clockoutBusy || clockoutLoading || !clockoutPanel.schedule}}"><view class="clockout-schedule-icon"><image src="/workspace/assets/ui-clock.png"/></view><view><text>定时下班</text><text class="clockout-row-value">{{clockoutPanel.scheduleSummary || '未开启'}}</text></view><text class="clockout-chevron">›</text></button>
      <text wx:if="{{clockoutPanel.lastRun.status === 'MISSED'}}" class="clockout-note">上次定时已错过，可手动下班</text><text wx:elif="{{clockoutPanel.lastRun.status === 'DISABLED_SCOPE'}}" class="clockout-note">上次执行时未分配负责分类</text><text wx:elif="{{clockoutPanel.lastRun.status === 'FAILED'}}" class="clockout-note">上次定时未完成，请重新读取后手动下班</text>
    </block>
    <block wx:else>
      <view class="clockout-setting-row"><text>自动暂停计时</text><button size="mini" class="native-button clockout-switch {{clockoutDraft.enabled ? 'is-on' : ''}}" bindtap="toggleClockoutSchedule" disabled="{{clockoutBusy}}" aria-role="switch" aria-checked="{{clockoutDraft.enabled}}" aria-label="开启定时下班"><view/></button></view>
      <picker mark:backIgnore="{{true}}" class="clockout-time" mode="time" value="{{clockoutDraft.time}}" bindchange="changeClockoutTime" disabled="{{clockoutBusy}}" aria-label="选择下班时间"><text>{{clockoutDraft.time}}</text><text>选择下班时间</text></picker>
      <text class="clockout-repeat-label">重复</text><view class="clockout-week"><button size="mini" wx:for="{{clockoutDays}}" wx:key="key" class="native-button {{item.selected ? 'is-selected' : ''}}" data-day="{{item.key}}" bindtap="toggleClockoutDay" disabled="{{clockoutBusy}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="星期{{item.label}}">{{item.label}}</button></view>
      <button size="mini" class="native-button clockout-primary" bindtap="saveClockoutTime" disabled="{{clockoutBusy}}">{{clockoutBusy ? '正在保存…' : '保存设置'}}</button>
    </block>
    <view wx:if="{{clockoutError}}" class="clockout-error" aria-role="alert"><text>{{clockoutError}}</text><button size="mini" class="native-button" bindtap="backClockout" wx:if="{{clockoutView === 'schedule'}}" disabled="{{clockoutBusy}}">返回重新读取</button><button size="mini" class="native-button" bindtap="reloadClockout" wx:else disabled="{{clockoutBusy}}">重新读取</button></view>
    <text class="clockout-note">{{clockoutView === 'schedule' ? '按分类最新成员执行，员工可自行继续计时' : '员工可在报工计时界面继续'}}</text>
  </scroll-view>
</view>
