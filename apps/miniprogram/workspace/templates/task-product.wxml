<view class="task-product-mask {{productPanelOpen ? 'is-open' : ''}} {{reduceMotion ? 'product-reduced' : ''}}" wx:if="{{productPanel}}" catchtap="closeTaskProduct" catchtouchmove="stopTaskProductBubble"/>
<view class="task-product-panel {{productPanelOpen ? 'is-open' : ''}} {{reduceMotion ? 'product-reduced' : ''}}" wx:if="{{productPanel}}" aria-role="dialog" aria-label="{{productPanel.taskRecord ? '派工详情' : '产品完整资料'}}" aria-modal="true" aria-hidden="{{!productPanelOpen || !!imageViewer}}" catchtap="stopTaskProductBubble">
  <view class="task-product-heading"><view><text>{{productPanel.taskRecord ? '派工详情' : '产品资料'}}</text><text>{{productPanel.orderCode}}</text></view><button size="mini" class="native-button" bindtap="closeTaskProduct" aria-label="{{productPanel.taskRecord ? '关闭派工详情' : '关闭产品资料'}}"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="task-product-scroll" scroll-y="{{!imageViewer}}">
    <view class="task-record-detail" wx:if="{{productPanel.taskRecord}}"><view class="task-record-detail-heading"><text>{{productPanel.taskRecord.processName}}</text><text class="task-record-status-text state-{{productPanel.taskRecord.status}}">{{productPanel.taskRecord.statusText}}</text></view><text class="task-record-detail-worker">{{productPanel.taskRecord.workerName}} · {{productPanel.taskRecord.assignedShort}} 派工</text><text class="task-record-detail-time">已生产 {{productPanel.taskRecord.elapsedShortText}}{{productPanel.taskRecord.timerPaused ? ' · 计时已暂停' : ''}}</text><view class="task-pause" wx:if="{{productPanel.taskRecord.status === 'PAUSED'}}"><text>{{productPanel.taskRecord.pauseReason || '等待组长继续安排'}}</text><text wx:if="{{productPanel.taskRecord.resumeBlockedReason}}">{{productPanel.taskRecord.resumeBlockedReason}}</text></view></view>
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" mark:backIgnore="{{true}}" class="task-product-gallery" scroll-x="true" wx:if="{{productPanel.images.length}}"><view class="task-product-image-track"><button size="mini" wx:for="{{productPanel.images}}" wx:key="url" id="task-product-image-{{item.index}}" class="native-button task-product-image" data-index="{{item.index}}" bindtap="previewTaskProductImage" disabled="{{item.failed}}" aria-label="放大产品图片{{item.index + 1}}"><image wx:if="{{!item.failed}}" src="{{item.url}}" mode="aspectFit" data-url="{{item.url}}" binderror="taskProductImageError"/><text wx:else>图片加载失败</text></button></view></scroll-view>
    <view class="task-product-no-image" wx:else><view class="product-placeholder-icon"/><text>暂无图片</text></view>
    <text class="task-product-title">{{productPanel.title}}</text>
    <view class="task-product-fields"><view wx:for="{{productPanel.fields}}" wx:key="label" class="task-product-field"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
    <text class="task-product-source">{{sourceLabel}}{{productPanel.fetchedText ? ' · 查询于 ' + productPanel.fetchedText : ''}}</text>
  </scroll-view>
  <view class="task-record-detail-actions" wx:if="{{productPanel.taskRecord}}"><button size="mini" class="native-button task-report-capsule" bindtap="showTaskProductReports" disabled="{{!productPanelOpen || actionBusy}}" aria-label="报工记录 {{productPanel.taskRecord.reportCount}}"><image class="task-report-capsule-icon" src="/workspace/assets/liquid-nav-home-blue.png"/><text>报工记录</text><text class="task-report-capsule-count">{{productPanel.taskRecord.reportCount}}</text><image class="task-report-capsule-arrow" src="/workspace/assets/ui-chevron-down.png"/></button><button size="mini" wx:if="{{productPanel.taskRecord.status === 'PAUSED'}}" class="native-button task-resume" bindtap="resumeTaskProduct" disabled="{{!productPanelOpen || !productPanel.taskRecord.canResume || !canManageExecution || actionBusy}}">继续启动</button></view>
</view>
