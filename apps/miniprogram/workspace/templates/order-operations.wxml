<view wx:if="{{operationPanel}}" class="order-operation-mask {{operationOpen ? 'is-open' : ''}}" bindtap="closeOrderOperations"/>
<view wx:if="{{operationPanel}}" class="order-operation-material {{operationOpen ? 'is-open' : ''}} {{!operationOpen && !operationClosing ? 'operation-preparing' : ''}} {{!operationMotion || reduceMotion ? 'operation-fade' : ''}}" style="{{operationMotion ? operationMotion.boxStyle : ''}}transform:{{operationMotion ? (operationOpen ? operationMotion.openTransform : operationMotion.closedTransform) : 'none'}};border-radius:{{operationOpen || !operationMotion ? '26px' : operationMotion.closedRadius}};" aria-hidden="true"/>
<view wx:if="{{operationPanel}}" class="order-operation-sheet {{operationOpen ? 'is-open' : ''}} {{reduceMotion ? 'operation-reduced' : ''}}" style="clip-path:{{operationMotion ? (operationOpen ? 'inset(0px 0px 0px 0px round 26px)' : operationMotion.closedClip) : 'none'}};-webkit-clip-path:{{operationMotion ? (operationOpen ? 'inset(0px 0px 0px 0px round 26px)' : operationMotion.closedClip) : 'none'}};" aria-role="dialog" aria-label="工单操作" aria-modal="true" aria-hidden="{{!operationOpen}}" data-anchor="order-operation-{{operationPanel.id}}">
  <view class="order-operation-heading"><view><text>操作</text><text>{{operationPanel.code}}</text></view><button size="mini" class="native-button" bindtap="closeOrderOperations" disabled="{{operationSaving}}" aria-label="关闭工单操作"><image src="/workspace/assets/ui-chevron-down.png"/></button></view>
  <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" class="order-operation-body" scroll-y="true">
    <text class="order-operation-label">优先级</text>
    <view class="order-priority-options" aria-role="radiogroup" aria-label="工单优先级"><button size="mini" wx:for="{{operationPriorities}}" wx:key="key" class="native-button order-priority-option {{operationPanel.priority === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="chooseOrderPriority" disabled="{{operationLoading || operationSaving || !operationPanel.canManage}}" aria-role="radio" aria-checked="{{operationPanel.priority === item.key}}">{{item.label}}</button></view>
    <button size="mini" class="native-button order-priority-sync" bindtap="toggleOrderPrioritySync" disabled="{{operationLoading || operationSaving || !operationPanel.canManage || !operationPanel.canSyncPriority}}" aria-role="checkbox" aria-checked="{{operationPanel.syncPriority}}"><checkbox checked="{{operationPanel.syncPriority}}" disabled="{{operationLoading || operationSaving || !operationPanel.canManage || !operationPanel.canSyncPriority}}" color="#1D4ED8"/><text>同步更新优先级到任务</text></button>
    <text class="order-operation-label status-heading">执行状态</text>
    <view class="order-execution-options" aria-role="radiogroup" aria-label="工单执行状态"><button size="mini" wx:for="{{operationStatuses}}" wx:key="key" class="native-button order-execution-option {{operationPanel.status === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="chooseOrderStatus" disabled="{{operationLoading || operationSaving || !operationPanel.canManage}}" aria-role="radio" aria-checked="{{operationPanel.status === item.key}}"><text class="order-status-chip chip-{{item.key}}">{{item.label}}</text><image wx:if="{{operationPanel.status === item.key}}" src="/workspace/assets/step-check.png"/></button></view>
    <text wx:if="{{operationLoading || operationStatus}}" class="order-operation-message" aria-live="polite">{{operationStatus || '正在读取…'}}</text>
    <view wx:if="{{operationError || operationPanel.checking}}" class="order-operation-error"><text wx:if="{{operationError}}">{{operationError}}</text><button size="mini" class="native-button" bindtap="refreshOrderOperations" disabled="{{operationLoading || operationSaving}}">刷新工单</button></view>
  </scroll-view>
  <view class="order-operation-footer"><button size="mini" class="native-button" bindtap="closeOrderOperations" disabled="{{operationSaving}}">{{operationPanel.checking ? '关闭' : '取消'}}</button><button size="mini" class="native-button order-operation-confirm" bindtap="saveOrderOperations" disabled="{{operationLoading || operationSaving || !operationPanel.canManage}}">{{operationSaving ? '正在提交…' : operationPanel.checking ? '后台处理中' : '确定更改'}}</button></view>
</view>
