PORT=4180
HOST=127.0.0.1
DATABASE_PATH=./data/reporting.sqlite
PROCESS_INFERENCE_RULES_PATH=./data/analysis/process-inference-rules.json
DISPATCH_PREDICTION_RULES_PATH=./data/analysis/dispatch-prediction-rules.json
DEFECT_REASONS_PATH=./data/analysis/defect-reasons.json
# 兼容已打印的旧 taskId 工位码：JSON 键为旧任务 ID，值为固定 processCode。
STATION_CODE_ALIASES={}
SESSION_SECRET=
SESSION_DAYS=30
ADMIN_API_KEY=
# 仅用于同机 Nginx 在钉钉会话校验成功后调用管理接口；不要发送给浏览器。
ADMIN_PROXY_SECRET=
# 可切换普通/绣花机报工的初始管理员黑湖人员 ID，多个用逗号分隔。
# 人员管理页保存的显式开关优先于这里的兼容配置。
REPORTING_MODE_ADMIN_OPERATOR_IDS=

# 微信小程序自动身份识别。AppSecret 只放服务端环境变量，绝不能写进小程序代码。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_REQUEST_TIMEOUT_MS=8000

# 微信审核专用入口。默认关闭；只允许审核员使用指定测试人员和测试工单。
# REVIEW_ACCESS_CODE 填入提审备注，不能与管理员密钥相同；建议审核通过后立即关闭并更换。
REVIEW_MODE_ENABLED=false
REVIEW_ACCESS_CODE=
REVIEW_OPERATOR_ID=
# 黑湖工单详情链接中的 id，多个 ID 用逗号分隔。
REVIEW_ALLOWED_PROJECT_IDS=
REVIEW_SESSION_HOURS=24

# 生产异常只在有明确计划节点或“已扣除暂停”的净作业用时基准时判定。
# 没有计划/净工时依据的长周期工单不会因为经过数小时或数天而自动标红。
ANOMALY_DEADLINE_GRACE_MINUTES=30
ANOMALY_DURATION_BASELINE_MIN_SAMPLES=5
ANOMALY_DURATION_MULTIPLIER=3
ANOMALY_DURATION_MINIMUM_EXCESS_MINUTES=60

# mock：本地开发，不调用黑湖；live：调用真实黑湖
BLACKLAKE_MODE=mock
BLACKLAKE_BASE_URL=https://liteweb.blacklake.cn
BLACKLAKE_STATIC_TOKEN=

# 推荐创建只用于 OpenAPI 的专用账号，避免该账号登录 Web/移动端导致 Token 失效。
BLACKLAKE_LOGIN_PATH=/api/user/v1/users/_login
BLACKLAKE_LOGIN_TYPE=1
BLACKLAKE_CLIENT=lite-web
BLACKLAKE_CODE=
BLACKLAKE_USERNAME=
BLACKLAKE_PHONE=
BLACKLAKE_PASSWORD=
# 密码填写明文即可，客户端会按小工单网页端算法计算 SHA3-224；也兼容已计算的 56 位十六进制摘要。

BLACKLAKE_TASK_QUERY_PATH=/api/dytin/external/task/queryList2
BLACKLAKE_CURRENT_PROCESS_PATH=/api/dytin/external/project/queryList/expand
BLACKLAKE_OUTPUT_ADD_PATH=/api/dytin/external/output/add
BLACKLAKE_OUTPUT_QUERY_PATH=/api/dytin/external/output/queryList3
BLACKLAKE_USER_QUERY_PATH=/api/dytin/external/user/queryList2
BLACKLAKE_APPROVE_STATUS=0
BLACKLAKE_REQUEST_TIMEOUT_MS=12000

# 首页查询 Agent：DeepSeek 密钥仅在服务器配置，不发到浏览器。
AGENT_ENABLED=true
DEEPSEEK_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-flash
AGENT_TIMEOUT_MS=60000
AGENT_MAX_STEPS=6
AGENT_MAX_OUTPUT_TOKENS=1800
# Shared SQLite mirror and durable Blacklake outbox. Disabled until first sync/cutover is reviewed.
BLACKLAKE_DATA_SYNC_ENABLED=false
BLACKLAKE_QUEUE_ALLOW_NEXT=true
BLACKLAKE_SYNC_HISTORY_DAYS=2
BLACKLAKE_SYNC_REFRESH_MS=60000
BLACKLAKE_SYNC_INTERVAL_MS=1200

# 北京时间02:00补暂停遗留员工计时，仅处理本地任务，不代报数量。
OVERNIGHT_CLOCKOUT_ENABLED=true
# team-first: 所属组长优先，其他组长最后一次下班兜底，再用多数员工中位数。
OVERNIGHT_CLOCKOUT_REFERENCE_POLICY=team-first
